<% content_for :title, t('.trips') %>

<div class="w-full my-5">
  <div id="trips" class="min-w-full">
    <%= render layout: 'shared/page_header', locals: { title: t('.trips') } do %>
      <%= link_to new_trip_path, class: 'btn btn-primary btn-sm' do %>
        <%= icon 'circle-plus', class: 'w-4 h-4' %> <%= t('trips.index.new_trip') %>
      <% end %>
    <% end %>

    <% if @has_trips %>
      <%= render 'filters', filters: @filters, years: @trip_years, countries: @trip_countries %>
    <% end %>

    <% if !@has_trips %>
      <div class="text-center py-16 px-8 bg-base-200 rounded-xl border-2 border-dashed border-base-300">
        <h3 class="text-xl font-bold mb-3"><%= t('.no_trips_yet') %></h3>
        <p class="text-base-content/50 mb-6 max-w-sm mx-auto">
          <%= t('.create_your_first_trip_to_see_your_journeys_visualized_with') %>
        </p>
        <%= link_to new_trip_path, class: 'btn btn-primary' do %>
          <%= icon 'circle-plus', class: 'w-4 h-4' %> <%= t('.create_your_first_trip') %>
        <% end %>
      </div>
    <% elsif @trips.empty? %>
      <div class="text-center py-12 px-8 bg-base-200 rounded-xl border border-base-300">
        <h3 class="text-lg font-bold mb-2"><%= t('.no_matching_trips') %></h3>
        <p class="text-base-content/50 mb-5 max-w-sm mx-auto"><%= t('.try_other_filters') %></p>
        <%= link_to t('.show_all_trips'), trips_path, class: 'btn btn-sm' %>
      </div>
    <% else %>
      <div class="flex justify-center mb-4">
        <%= paginate @trips %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @trips.each do |trip| %>
          <%= render 'trip', trip: trip %>
        <% end %>
      </div>

      <div class="flex justify-center mt-4">
        <%= paginate @trips %>
      </div>
    <% end %>
    <% if @family_trips.any? %>
      <section class="mt-8" aria-label="<%= t('shared_links.family.trips') %>">
        <h2 class="text-xl font-bold mb-4"><%= t('shared_links.family.trips') %></h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <% @family_trips.each do |trip| %>
            <%= render 'family_trip', trip: trip, share: @family_trip_links.fetch(trip.id) %>
          <% end %>
        </div>
        <div class="flex justify-center mt-4">
          <%= paginate @family_trips, param_name: :family_page %>
        </div>
      </section>
    <% end %>
  </div>
</div>
