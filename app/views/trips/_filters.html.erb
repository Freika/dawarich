<% label_class = 'text-xs font-medium text-base-content/50 uppercase tracking-wider mb-1 block' %>
<div class="border border-base-300 rounded-xl bg-base-200/50 p-4 mb-5">
  <%= form_with url: trips_path, method: :get, data: { controller: 'auto-submit', turbo_action: 'advance', action: 'pointerdown->auto-submit#notePointer' },
                class: 'flex flex-wrap items-end gap-3', html: { role: 'search' } do |f| %>
    <div class="min-w-0 flex-[2_1_16rem]">
      <%= f.label :q, t('.search'), class: label_class %>
      <%= f.search_field :q, value: filters.q, placeholder: t('.search_placeholder'),
                             maxlength: Trips::IndexQuery::QUERY_MAX_LENGTH,
                             class: 'input input-bordered input-sm w-full' %>
    </div>

    <div class="min-w-0 flex-[1_1_9rem]">
      <%= f.label :sort, t('.sort'), class: label_class %>
      <%= f.select :sort,
                   options_for_select(Trips::IndexQuery::SORTS.keys.map { [t(".sorts.#{_1}"), _1] }, filters.sort),
                   {}, class: 'select select-bordered select-sm w-full',
                       data: { action: 'keydown->auto-submit#noteKeyboard change->auto-submit#submit' } %>
    </div>

    <div class="min-w-0 flex-[1_1_7rem]">
      <%= f.label :year, t('.year'), class: label_class %>
      <%= f.select :year, options_for_select((years | [filters.year].compact).sort.reverse, filters.year),
                   { include_blank: t('.all_years') },
                   class: 'select select-bordered select-sm w-full',
                   data: { action: 'keydown->auto-submit#noteKeyboard change->auto-submit#submit' } %>
    </div>

    <div class="min-w-0 flex-[1_1_8rem]">
      <%= f.label :month, t('.month'), class: label_class %>
      <%= f.select :month,
                   options_for_select((1..12).map { [t('date.month_names')[_1], _1] }, filters.month),
                   { include_blank: t('.all_months') },
                   class: 'select select-bordered select-sm w-full', disabled: filters.year.nil?,
                   aria: { describedby: ('trips-month-hint' if filters.year.nil?) },
                   data: { action: 'keydown->auto-submit#noteKeyboard change->auto-submit#submit' } %>
      <% if filters.year.nil? %>
        <span id="trips-month-hint" class="sr-only"><%= t('.choose_year_first') %></span>
      <% end %>
    </div>

    <% countries = (countries | [filters.country].compact).sort_by(&:downcase) %>
    <% if countries.any? %>
      <div class="min-w-0 flex-[1_1_9rem]">
        <%= f.label :country, t('.country'), class: label_class %>
        <%= f.select :country, options_for_select(countries, filters.country), { include_blank: t('.all_countries') },
                     class: 'select select-bordered select-sm w-full',
                     data: { action: 'keydown->auto-submit#noteKeyboard change->auto-submit#submit' } %>
      </div>
    <% end %>

    <div class="flex gap-2">
      <%= f.submit t('.apply'), name: nil, class: 'btn btn-primary btn-sm' %>
      <% if filters.active? || filters.sort != Trips::IndexQuery::DEFAULT_SORT %>
        <%= link_to t('.reset'), trips_path, class: 'btn btn-sm' %>
      <% end %>
    </div>
  <% end %>
</div>
