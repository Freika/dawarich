<div class="hero min-h-content bg-base-200">
  <div class="hero-content grid w-full my-10 gap-y-8 lg:grid-cols-[minmax(0,28rem)_24rem] lg:justify-center lg:items-center lg:gap-x-20">
    <div class="text-center lg:text-left">
      <h1 class="text-5xl font-bold text-base-content"><%= t('.change_your_password') %></h1>
      <p class="pt-6 text-base-content opacity-70">
        <%= t('.enter_your_new_password_below') %>
      </p>
    </div>
    <div class="card flex-shrink-0 w-full max-w-sm mx-auto border border-base-content/10 bg-base-100 px-5 py-5">
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div class="form-control">
          <%= f.label :password, t('.new_password'), class: 'label' do %>
            <span class="label-text"><%= t('.new_password') %></span>
          <% end %>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
                aria: { describedby: ('password-hint' if @minimum_password_length) },
                class: 'input input-bordered w-full' %>
          <% if @minimum_password_length %>
            <span id="password-hint" class="label-text-alt text-base-content/60 mt-1">
              <%= t('devise.registrations.new.characters_minimum', count: @minimum_password_length) %>
            </span>
          <% end %>
        </div>

        <div class="form-control">
          <%= f.label :password_confirmation, class: 'label' do %>
            <span class="label-text"><%= t('.confirm_new_password') %></span>
          <% end %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: 'input input-bordered w-full' %>
        </div>

        <div class="form-control mt-6">
          <%= f.submit t('.change_my_password'), class: 'btn btn-primary w-full' %>
        </div>
      <% end %>

      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
