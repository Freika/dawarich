<div class="hero bg-base-200">
  <div class="hero-content flex-col lg:flex-row-reverse w-full my-10 items-start gap-10">
    <div class="text-center lg:text-left max-w-md">
      <% if @invitation %>
        <h1 class="text-4xl font-bold text-base-content"><%= t('.join_family', family: @invitation.family.name) %></h1>
        <p class="py-6 text-base-content/70">
          <%= t('.you_ve_been_invited_by') %> <strong><%= @invitation.invited_by.email %></strong> <%= t('.to_join_their_family_create_your_account_to_accept_the') %>
        </p>
        <div class="alert alert-info mb-4">
          <%= icon 'info', class: 'h-5 w-5 shrink-0' %>
          <span class="text-sm">
            <%= t('.invitation_email_notice', email: @invitation.email) %>
          </span>
        </div>
      <% else %>
        <h1 class="text-4xl font-bold text-base-content"><%= t('.almost_there') %></h1>
      <% end %>

      <p class="py-6 text-base-content/70">
        <%= t('.only_a_few_steps_left_until_you_get_control_over') %>
      </p>

      <ol class="list-decimal list-inside space-y-2 text-base-content/80">
        <li><%= t('.create_your_account') %></li>
        <li><%= t('.configure_your_mobile_app') %></li>
        <li><%= t('.start_tracking_your_location_data_securely') %></li>
        <li><%= t('.ellipsis') %></li>
        <li><%= t('.you_re_beautiful') %></li>
      </ol>
    </div>

    <div class="card flex-shrink-0 w-full max-w-sm shadow-lg bg-base-100 px-5 py-5">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), class: 'form-body', html: { data: { turbo: false } }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <% if @invitation %>
          <%= f.hidden_field :invitation_token, value: params[:invitation_token] %>
        <% end %>

        <div class="form-control">
          <%= f.label :email, class: 'label' do %>
            <span class="label-text"><%= t('.email') %></span>
          <% end %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                readonly: @invitation.present?,
                class: "input input-bordered w-full #{@invitation ? 'input-disabled' : ''}" %>
        </div>

        <div class="form-control">
          <%= f.label :password, class: 'label' do %>
            <span class="label-text"><%= t('.password') %></span>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password",
                aria: { describedby: 'password-hint' },
                class: 'input input-bordered w-full' %>
          <% if @minimum_password_length %>
            <span id="password-hint" class="label-text-alt text-base-content/60 mt-1">
              <%= t('.characters_minimum', count: @minimum_password_length) %>
            </span>
          <% end %>
        </div>

        <div class="form-control">
          <%= f.label :password_confirmation, class: 'label' do %>
            <span class="label-text"><%= t('.password_confirmation') %></span>
          <% end %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: 'input input-bordered w-full' %>
        </div>

        <% if !DawarichSettings.self_hosted? %>
          <% unless @invitation %>
            <div class="form-control">
              <%= label_tag 'user[signup_intent]', class: 'label' do %>
                <span class="label-text"><%= t('.how_do_you_plan_to_use_dawarich') %></span>
              <% end %>
              <%= select_tag 'user[signup_intent]',
                    options_for_select([
                      [t('.i_want_to_use_the_cloud_version'), "cloud"],
                      [t('.i_m_self_hosting_and_exploring_the_demo'), "self_hosted_demo"]
                    ]),
                    class: 'select select-bordered w-full' %>
            </div>
          <% end %>

          <div class="cf-turnstile mt-4" data-sitekey="<%= ENV['TURNSTILE_SITE_KEY'] %>" data-theme="auto"></div>
        <% end %>

        <div class="form-control mt-6">
          <%= f.submit (@invitation ? t('.create_account_join_family') : t('.sign_up')),
                class: 'btn btn-primary' %>
        </div>
      <% end %>

      <% unless @invitation %>
        <%= render "devise/shared/links" %>
      <% end %>
    </div>
  </div>
</div>
