<%= turbo_frame_tag "point-address-#{@point.id}" do %>
  <% props = Geocoding::ResultNormalizer.from_data(@point.geodata)[:properties] %>
  <% parts = [props['street'], props['city'], props['country']].compact_blank %>
  <% if parts.any? %>
    <div>
      <span class="font-semibold"><%= t('.address') %></span> <%= parts.join(', ') %>
    </div>
  <% end %>
<% end %>
