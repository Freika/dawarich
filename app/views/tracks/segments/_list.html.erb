<%= turbo_frame_tag "track-#{track.id}-segments", class: "track-segments-list" do %>
  <% if segments.empty? %>
    <p class="text-sm text-base-content/60"><%= t('tracks.segments.index.no_segments_for_this_track_yet') %></p>
  <% else %>
    <% display = TrackSegments::DisplayLegs.call(segments) %>
    <% if display %>
      <%= render partial: 'tracks/segments/legs', locals: { track: track, display: display } %>
      <details class="segment-rawlist">
        <summary data-testid="segment-rawlist-toggle-<%= track.id %>"><%= t('.all_segments_edit', count: segments.size) %></summary>
        <% segments.each do |segment| %>
          <%= render partial: 'tracks/segments/segment_row', locals: { segment: segment } %>
        <% end %>
      </details>
    <% else %>
      <%# Legacy index-anchored or all-stationary tracks: raw rows only %>
      <% segments.each do |segment| %>
        <%= render partial: 'tracks/segments/segment_row', locals: { segment: segment } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
