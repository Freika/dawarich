<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="<%= app_theme %>" data-self-hosted="<%= DawarichSettings.self_hosted? %>" data-analytics-account="<%= user_signed_in? %>" data-analytics-consent="<%= current_user&.product_analytics_consent.nil? ? 'unknown' : current_user.product_analytics_consent %>" data-partnero-id="<%= ENV['PARTNERO_PROGRAM_ID'] %>" data-google-ads-id="<%= ENV['GOOGLE_ADS_ID'] %>">
  <head>
    <title><%= full_title(yield(:title)) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <%= render 'layouts/pwa_meta' %>
    <%= action_cable_meta_tag %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="product-analytics-consent" content="<%= user_signed_in? %>:<%= current_user&.product_analytics_consent.nil? ? 'unknown' : current_user.product_analytics_consent %>" data-turbo-track="reload">


    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= achievement_stylesheet_tags if achievements_visible? %>
    <%= javascript_translations %>
    <%= javascript_importmap_tags %>
    <%= yield :head_scripts %>

    <%= render 'application/favicon' %>
    <%= Sentry.get_trace_propagation_meta.html_safe if Sentry.initialized? %>
  </head>

  <body class='h-screen !h-[100dvh] overflow-hidden relative'>
    <% unless DawarichSettings.self_hosted? %>
      <div id="product-analytics-choice" hidden class="fixed top-0 left-0 right-0 z-50 p-4 bg-base-200 border-b border-base-300" role="region" aria-label="Product analytics choice">
        <p class="mb-2">Help improve Dawarich Cloud? Optional analytics measures signup, trial, and subscriptions. Location history, routes, email, and API keys are never sent to product analytics. You can change this choice at any time.</p>
        <button type="button" data-analytics-choice="true" class="btn btn-primary mr-2">Allow analytics</button>
        <button type="button" data-analytics-choice="false" class="btn btn-outline">No thanks</button>
        <span id="product-analytics-choice-error" hidden role="alert">Could not save your choice. Please try again.</span>
      </div>
      <button type="button" id="product-analytics-choice-open" class="fixed bottom-3 right-3 z-40 btn btn-xs">Analytics preference</button>
    <% end %>
    <!-- Fixed Navbar -->
    <div class='fixed w-full z-40 h-[calc(4rem+env(safe-area-inset-top))] pt-[env(safe-area-inset-top)] border-b border-base-content/10'>
      <div class='container mx-auto h-full w-full flex items-center'>
        <%= render 'shared/navbar' %>
      </div>
    </div>

    <!-- Flash Messages - Fixed below navbar -->
    <div class='fixed top-[calc(4rem+env(safe-area-inset-top))] w-full z-50'>
      <div class='container mx-auto px-5'>
        <%= render 'shared/flash' %>
      </div>
    </div>

    <!-- Full Screen Map Container -->
    <div class='absolute top-[calc(4rem+env(safe-area-inset-top))] left-0 right-0 bottom-0 w-full z-20 flex flex-col'>
      <%= yield %>
    </div>

    <%= turbo_frame_tag 'share-link-modal' %>

    <% if user_signed_in? && current_user.imports.exists?(demo: true) %>
      <div id="demo-data-banner" class="fixed bottom-0 left-1/2 -translate-x-1/2 z-30 mb-[calc(1rem+env(safe-area-inset-bottom))]" data-controller="demo-banner">
        <div class="alert alert-info shadow-lg py-1.5 px-3 flex items-center gap-1.5 rounded-lg whitespace-nowrap text-sm">
          <span class="font-medium" data-demo-banner-target="label"><%= t('.you_re_viewing_demo_data') %></span>
          <span data-demo-banner-target="loadingState" class="hidden">
            <span class="loading loading-spinner loading-xs text-info"></span>
          </span>
          <%= button_to t('.delete'),
              demo_data_settings_onboarding_path,
              method: :delete,
              form: {
                data: {
                  turbo: false,
                  action: "submit->demo-banner#confirmDelete"
                }
              },
              data: { "demo-banner-target": "deleteButton" },
              class: "btn btn-error btn-xs" %>
          <button class="btn btn-ghost btn-xs btn-square" data-action="demo-banner#dismiss">
            <%= icon 'x', class: 'w-3 h-3' %>
          </button>
        </div>
      </div>
    <% end %>

    <!-- Fixed Footer (hidden by default) -->
    <div id='map-footer' class='fixed bottom-[env(safe-area-inset-bottom)] left-0 right-0 z-30 hidden'>
      <%= render 'shared/legal_footer' %>
    </div>

    <%= render 'map/onboarding_modal', auto_open: true %>
    <%= render 'layouts/achievement_unlock_host' %>
  </body>
</html>
