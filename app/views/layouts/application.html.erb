<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="<%= app_theme %>" data-self-hosted="<%= DawarichSettings.self_hosted? %>" data-analytics-account="<%= user_signed_in? %>" data-analytics-consent="<%= current_user&.product_analytics_consent.nil? ? 'unknown' : current_user.product_analytics_consent %>" data-partnero-id="<%= ENV['PARTNERO_PROGRAM_ID'] %>" data-google-ads-id="<%= ENV['GOOGLE_ADS_ID'] %>">
  <head>
    <title><%= full_title(yield(:title)) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= render 'layouts/pwa_meta' %>
    <%= action_cable_meta_tag %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="product-analytics-consent" content="<%= user_signed_in? %>:<%= current_user&.product_analytics_consent.nil? ? 'unknown' : current_user.product_analytics_consent %>" data-turbo-track="reload">


    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= achievement_stylesheet_tags if achievements_visible? %>
    <%= javascript_translations %>
    <%= javascript_importmap_tags %>
    <%= turbo_refreshes_with(method: :morph, scroll: :preserve) if morph_page_refreshes? %>
    <%= yield :head %>
    <%= yield :head_scripts %>

    <%= render 'application/favicon' %>
    <%= Sentry.get_trace_propagation_meta.html_safe if Sentry.initialized? %>
  </head>

  <body class='min-h-screen flex flex-col'>
    <% unless DawarichSettings.self_hosted? %>
      <div id="product-analytics-choice" hidden class="p-4 bg-base-200 border-b border-base-300" role="region" aria-label="Product analytics choice">
        <p class="mb-2">Allow optional product analytics? PostHog receives signup, trial, and subscription events. Self-hosted Rybbit measures visits. If you also accepted marketing tracking on dawarich.app, Google Ads and Partnero may run here. Location history, routes, email, and API keys are not sent to product analytics. You can withdraw this choice at any time.</p>
        <button type="button" data-analytics-choice="true" class="btn btn-primary mr-2">Allow analytics</button>
        <button type="button" data-analytics-choice="false" class="btn btn-outline">No thanks</button>
        <span id="product-analytics-choice-error" hidden role="alert">Could not save your choice. Please try again.</span>
      </div>
    <% end %>
    <div class='container mx-auto flex flex-col flex-1'>
      <%= render 'shared/navbar' %>
      <%= render 'shared/locale_suggestion' %>
      <%= render 'shared/flash' %>
      <div class="w-full px-4 sm:px-5 flex-1">
        <div class="flex w-full min-w-0 gap-5">
          <%= yield %>
        </div>
      </div>
      <div class="px-4 sm:px-5 mt-auto">
        <%= render DawarichSettings.self_hosted? ? 'shared/footer' : 'shared/legal_footer' %>
        <% unless DawarichSettings.self_hosted? %>
          <button type="button" id="product-analytics-choice-open" class="link mb-4">Product analytics preference</button>
        <% end %>
      </div>
    </div>

    <%# auto_open: false — non-map pages keep the dialog only for the navbar's
        manual "Getting started" trigger; it never pops open on load (N1). %>
    <%= render 'map/onboarding_modal', auto_open: false %>
    <%= render 'layouts/achievement_unlock_host' %>
  </body>
</html>
