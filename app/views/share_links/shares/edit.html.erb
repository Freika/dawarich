<turbo-frame id="share-link-modal">
  <div class="modal modal-open" data-controller="share-link-modal" style="z-index: 10000;">
    <div class="modal-box max-w-xl">
      <h3 class="font-bold text-lg mb-2"><%= t('ux_p2.sharing.edit_access') %></h3>
      <p class="text-sm mb-4"><%= t('ux_p2.sharing.url_unchanged') %></p>
      <% if @share.errors.any? %><p class="alert alert-error"><%= @share.errors.full_messages.join(', ') %></p><% end %>
      <%= form_with scope: :shared_link, url: share_links_share_path(@share), method: :patch, data: { turbo_frame: 'share-link-modal' } do |f| %>
        <%= render 'shared_links/expires_field', f: f, share: @share, exact: true %>
        <%= render 'shared_links/live_freshness_field', share: @share if @share.live? %>
        <% shared_link_sections(@share).each do |key, enabled| %>
          <% next if key == 'show_photos' && @share.timeline_import_scoped? %>
          <label class="label cursor-pointer gap-3">
            <span><%= t("ux_p2.sharing.sections.#{key}") %></span>
            <%= hidden_field_tag "shared_link[settings][#{key}]", '0' %>
            <%= check_box_tag "shared_link[settings][#{key}]", '1', enabled, class: 'checkbox' %>
          </label>
        <% end %>
        <div class="modal-action">
          <%= link_to t('ux_p2.sharing.cancel'), map_v2_path, class: 'btn btn-ghost', data: { action: 'share-link-modal#close', turbo_frame: '_top' } %>
          <%= f.submit t('ux_p2.sharing.save'), class: 'btn btn-primary' %>
        </div>
      <% end %>
    </div>
  </div>
</turbo-frame>
