<div class="tags-page w-full min-w-0 my-5" data-testid="place-lists">
  <%= render layout: 'shared/page_header', locals: { title: t('.lists') } do %>
    <%= link_to new_tag_path, class: "btn btn-primary btn-sm" do %>
      <%= icon 'circle-plus', class: 'w-4 h-4' %> <%= t('.new_list') %>
    <% end %>
  <% end %>

  <% if @tags.any? %>
    <ul class="divide-y divide-base-content/10 border border-base-content/10 rounded-xl">
      <% @tags.each do |tag| %>
        <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
          <div class="flex flex-wrap items-center gap-3 min-w-0">
            <%= link_to tag_path(tag), class: "min-w-0 flex items-center gap-3 link link-hover" do %>
              <span class="text-2xl leading-none" aria-hidden="true"><%= tag.icon %></span>
              <span class="font-medium [overflow-wrap:anywhere]"><%= tag.name %></span>
            <% end %>
            <% if tag.privacy_zone? %>
              <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium badge badge-outline tabular-nums"
                    title="<%= t('.privacy_zone_badge_hint') %>">
                <%= icon 'lock', class: "w-3 h-3" %> <%= tag.privacy_radius_meters %>m
              </span>
            <% end %>
          </div>
          <div class="flex items-center gap-3">
            <%= link_to @place_counts.fetch(tag.id, 0), tag_path(tag), class: "link link-primary tabular-nums",
                data: { testid: "tag-place-count" },
                aria: { label: "#{t('.places')}: #{@place_counts.fetch(tag.id, 0)}" } %>
            <%= render 'delete_button', tag: tag %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="text-center py-16 px-8 bg-base-200 rounded-xl border-2 border-dashed border-base-content/10">
      <h3 class="text-xl font-bold mb-3"><%= t('.no_tags_yet') %></h3>
      <p class="text-base-content/70 mb-6 max-w-sm mx-auto">
        <%= t('.create_tags_to_organize_your_places_and_add_privacy_zones') %>
      </p>
      <%= link_to new_tag_path, class: 'btn btn-primary' do %>
        <%= icon 'circle-plus', class: 'w-4 h-4' %> <%= t('.create_your_first_tag') %>
      <% end %>
    </div>
  <% end %>
</div>
