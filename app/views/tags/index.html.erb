<div class="tags-page w-full min-w-0 my-5">
  <%= render layout: 'shared/page_header', locals: { title: t('.tags') } do %>
    <%= link_to new_tag_path, class: "btn btn-primary btn-sm" do %>
      <%= icon 'circle-plus', class: 'w-4 h-4' %> <%= t('tags.index.new_tag') %>
    <% end %>
  <% end %>

  <% if @tags.any? %>
    <div class="border border-base-content/10 rounded-xl overflow-x-auto">
      <table class="table table-sm w-full">
        <thead class="bg-base-200">
          <tr>
            <th class="px-4 py-3 text-xs uppercase tracking-wider text-base-content/70 w-16"><%= t('.icon') %></th>
            <th class="px-4 py-3 text-xs uppercase tracking-wider text-base-content/70"><%= t('.name') %></th>
            <th class="px-4 py-3 text-xs uppercase tracking-wider text-base-content/70"><%= t('.color') %></th>
            <th class="px-4 py-3 text-xs uppercase tracking-wider text-base-content/70 text-right"><%= t('.places') %></th>
            <th class="px-4 py-3 text-xs uppercase tracking-wider text-base-content/70 text-right"><%= t('.actions') %></th>
          </tr>
        </thead>
        <tbody>
          <% @tags.each do |tag| %>
            <tr class="hover:bg-base-200/50 transition-colors">
              <td class="px-4 py-3 text-2xl"><%= tag.icon %></td>
              <td class="px-4 py-3">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-medium">#<%= tag.name %></span>
                  <% if tag.privacy_zone? %>
                    <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium badge badge-outline tabular-nums"
                          title="<%= t('.privacy_zone_badge_hint') %>">
                      <%= icon 'lock', class: "w-3 h-3" %> <%= tag.privacy_radius_meters %>m
                    </span>
                  <% end %>
                </div>
              </td>
              <td class="px-4 py-3">
                <% if tag.color.present? %>
                  <div class="flex items-center gap-2">
                    <div class="w-5 h-5 rounded-md border border-base-content/10" style="background-color: <%= tag.color %>;"></div>
                    <span class="text-xs text-base-content/70 font-mono"><%= tag.color %></span>
                  </div>
                <% else %>
                  <span class="text-base-content/70 text-sm">--</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right tabular-nums">
                <%= link_to @place_counts.fetch(tag.id, 0), places_path(tag_ids: [tag.id]), class: "link link-primary",
                    aria: { label: "#{t('.places')}: #{@place_counts.fetch(tag.id, 0)}" } %>
              </td>
              <td class="px-4 py-3 text-right">
                <div class="flex gap-1 justify-end">
                  <div class="tooltip" data-tip="<%= t('.edit_tag') %>">
                    <%= link_to edit_tag_path(tag), class: "btn btn-ghost btn-xs", aria: { label: t('.edit_tag') } do %>
                      <%= icon 'square-pen', class: 'w-4 h-4' %>
                    <% end %>
                  </div>
                  <div class="tooltip tooltip-left" data-tip="<%= t('.delete_tag') %>">
                    <%= render 'delete_button', tag: tag %>
                  </div>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-16 px-8 bg-base-200 rounded-xl border-2 border-dashed border-base-content/10">
      <h3 class="text-xl font-bold mb-3"><%= t('.no_tags_yet') %></h3>
      <p class="text-base-content/70 mb-6 max-w-sm mx-auto">
        <%= t('.create_tags_to_organize_your_places_and_add_privacy_zones') %>
      </p>
      <%= link_to new_tag_path, class: 'btn btn-primary' do %>
        <%= icon 'circle-plus', class: 'w-4 h-4' %> <%= t('.create_your_first_tag') %>
      <% end %>
    </div>
  <% end %>
</div>
