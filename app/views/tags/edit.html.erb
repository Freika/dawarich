<div class="tags-page container mx-auto px-4 py-8 max-w-2xl min-w-0">
  <div class="mb-6">
    <h1 class="text-3xl font-bold"><%= t('.edit_tag') %></h1>
    <p class="text-base-content/70 mt-2"><%= t('.update_your_tag_details') %></p>
  </div>

  <div class="card bg-base-100 border border-base-content/10">
    <div class="card-body p-4 sm:p-8">
      <%= render "form", tag: @tag %>
    </div>
  </div>

  <%= render 'places' %>
</div>
