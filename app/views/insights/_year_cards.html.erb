<% distance_unit = current_user.safe_settings.distance_unit %>
<% map_style = current_user.safe_settings.settings['maps_maplibre_style'] || 'light' %>
<%# ponytail: one WebGL map per card and browsers cap contexts at ~16, so only the newest years get a map; lazy-mount on scroll if more are needed. %>
<% map_years = @stats_by_year.keys.first(6) %>
<% geocoding = reverse_geocoding_enabled_for?(current_user) %>

<section class="mb-6" aria-labelledby="insights-years-title">
  <h2 id="insights-years-title" class="text-xl font-bold mb-3"><%= t('.title') %></h2>
  <div class="grid grid-cols-1 gap-4 <%= 'lg:grid-cols-2' if @stats_by_year.size + @locked_years.size > 1 %>">
    <% @stats_by_year.each do |year, stats| %>
      <% cache [current_user.id, 'insights_year_card', I18n.locale, year, stats.map(&:updated_at).max, distance_unit, geocoding, map_years.include?(year), map_style], expires_in: 24.hours do %>
        <% with_map = map_years.include?(year) && Stats::YearRoutesQuery.new(current_user, year).any? %>
        <div class="card bg-base-200 overflow-hidden" data-testid="insights-year-card">
          <% if with_map %>
            <%= link_to insights_path(year: year), class: 'block bg-base-300', tabindex: -1, aria: { hidden: true }, data: { map_wrapper: true } do %>
              <div class="pointer-events-none aspect-[16/7] max-h-72 w-full" data-testid="insights-year-map"
                   data-controller="trip-maplibre-preview"
                   data-trip-maplibre-preview-lines-url-value="<%= routes_insights_path(year: year) %>"
                   data-trip-maplibre-preview-map-style-value="<%= map_style %>"></div>
            <% end %>
          <% end %>
          <div class="card-body p-5 gap-3">
            <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
              <h3 class="text-2xl font-bold">
                <%= link_to year, insights_path(year: year), class: "link link-hover text-#{header_colors[year % header_colors.size]}" %>
              </h3>
              <span class="text-lg font-semibold tabular-nums">
                <%= number_with_delimiter year_distance_stat(@year_distances[year], current_user).round %> <%= distance_unit %>
              </span>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-2 text-sm text-base-content/60">
              <span><%= t('stats.index.last_update') %> <%= human_date(stats.first.updated_at) %></span>
              <span class="flex items-center gap-3">
                <%= link_to t('shared.navbar.map'), preferred_map_path(year_timespan(year)), class: 'link link-hover' %>
                <% if geocoding %>
                  <% location_data = countries_and_cities_stat_for_year(year, stats) %>
                  <label for="<%= location_data[:modal_id] %>" class="link link-primary cursor-pointer">
                    <%= t('stats.index.countries_count_countries_cities_count_cities', countries_count: location_data[:countries_count], cities_count: location_data[:cities_count]) %>
                  </label>
                <% end %>
              </span>
            </div>

            <% longest = @year_distances[year].map(&:last).max.to_f %>
            <div class="flex h-1.5 gap-0.5" role="img" aria-label="<%= t('insights.months.title') %>" data-testid="insights-year-strip">
              <% @year_distances[year].each do |month_name, meters| %>
                <span class="flex-1 rounded-full" title="<%= month_name %>: <%= number_with_delimiter Stat.convert_distance(meters, distance_unit).round %> <%= distance_unit %>"
                      style="background: color-mix(in oklab, oklch(var(--p)) <%= longest.positive? && meters.positive? ? (20 + (meters / longest * 80)).round : 0 %>%, oklch(var(--bc) / 0.1))"></span>
              <% end %>
            </div>

            <% if geocoding %>
              <input type="checkbox" id="<%= location_data[:modal_id] %>" class="modal-toggle" />
              <div class="modal" role="dialog">
                <div class="modal-box max-w-3xl">
                  <h3 class="text-lg font-bold mb-4"><%= t('stats.index.countries_and_cities_visited_in') %> <%= location_data[:year] %></h3>
                  <div class="max-h-96 overflow-y-auto">
                    <% location_data[:grouped_by_country].each do |country, cities| %>
                      <div class="mb-4">
                        <h4 class="font-bold"><span class="mr-2"><%= country_flag(country) %></span><%= country %></h4>
                        <% if cities.any? %>
                          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2 pl-4">
                            <% cities.each do |city| %>
                              <div class="text-sm"><%= city %></div>
                            <% end %>
                          </div>
                        <% else %>
                          <p class="text-sm text-base-content/50 italic pl-4"><%= t('stats.index.no_specific_cities_recorded') %></p>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </div>
                <label class="modal-backdrop" for="<%= location_data[:modal_id] %>"></label>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>

    <% @locked_years.sort.reverse_each do |year| %>
      <div data-testid="insights-year-card">
        <%= render 'stats/locked_year_card', year: year %>
      </div>
    <% end %>
  </div>
</section>
