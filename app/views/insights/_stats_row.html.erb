<% if @year_stats.any? %>
  <% if unresolved_location_count?(@countries_count) || unresolved_location_count?(@cities_count) %>
    <%= render 'shared/unresolved_locations' %>
  <% end %>
  <!-- Top Stats Row -->
  <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 mb-6">
    <!-- Total Distance -->
    <div class="card bg-base-200">
      <div class="card-body p-5">
        <div class="flex justify-between items-start">
          <div class="flex items-center gap-2 text-base-content/60 text-sm">
            <%= icon 'chart-bar', class: 'w-4 h-4' %>
            <%= t('.total_distance') %>
          </div>
          <% if @distance_change && @distance_change != 0 %>
            <span class="text-sm tabular-nums <%= @distance_change.positive? ? 'text-success' : 'text-base-content/60' %>">
              <%= @distance_change.positive? ? '+' : '' %><%= @distance_change %>%
            </span>
          <% end %>
        </div>
        <div class="text-3xl font-medium tabular-nums mt-2"><%= number_with_delimiter(@total_distance) %> <%= current_user.safe_settings.distance_unit %></div>
        <div class="text-base-content/50 text-sm">
          <% if @all_time %>
            <%= t('.all_tracked_history') %>
          <% elsif @prev_total_distance && @prev_total_distance.positive? %>
            <%= t('.vs') %> <%= number_with_delimiter(@prev_total_distance) %> <%= current_user.safe_settings.distance_unit %> <%= t('.in') %> <%= @previous_year %>
          <% else %>
            <%= t('.this_year') %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Countries -->
    <div class="card bg-base-200">
      <div class="card-body p-5">
        <div class="flex justify-between items-start">
          <div class="flex items-center gap-2 text-base-content/60 text-sm">
            <%= icon 'globe', class: 'w-4 h-4' %>
            <%= t('.countries') %>
          </div>
          <% if @countries_change && @countries_change != 0 %>
            <span class="text-sm tabular-nums <%= @countries_change.positive? ? 'text-success' : 'text-base-content/60' %>">
              <%= @countries_change.positive? ? '+' : '' %><%= @countries_change %>
            </span>
          <% end %>
        </div>
        <div class="text-3xl font-medium tabular-nums mt-2"><%= unresolved_location_count?(@countries_count) ? t('ux_p2.insights.unresolved') : @countries_count %></div>
        <div class="text-base-content/50 text-sm">
          <% if @all_time %>
            <%= t('.all_tracked_history') %>
          <% elsif @prev_countries_count && @countries_change && @countries_change.positive? %>
            <%= @countries_change %> <%= t('.new_vs') %> <%= @previous_year %>
          <% elsif @prev_countries_count %>
            <%= t('.vs') %> <%= @prev_countries_count %> <%= t('.in') %> <%= @previous_year %>
          <% else %>
            <%= t('.this_year') %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Cities -->
    <div class="card bg-base-200">
      <div class="card-body p-5">
        <div class="flex justify-between items-start">
          <div class="flex items-center gap-2 text-base-content/60 text-sm">
            <%= icon 'building', class: 'w-4 h-4' %>
            <%= t('.cities') %>
          </div>
          <% if @cities_change && @cities_change != 0 %>
            <span class="text-sm tabular-nums <%= @cities_change.positive? ? 'text-success' : 'text-base-content/60' %>">
              <%= @cities_change.positive? ? '+' : '' %><%= @cities_change %>%
            </span>
          <% end %>
        </div>
        <div class="text-3xl font-medium tabular-nums mt-2"><%= unresolved_location_count?(@cities_count) ? t('ux_p2.insights.unresolved') : @cities_count %></div>
        <div class="text-base-content/50 text-sm">
          <% if @all_time %>
            <%= t('.all_tracked_history') %>
          <% elsif @prev_cities_count && @prev_cities_count.positive? %>
            <%= t('.vs') %> <%= @prev_cities_count %> <%= t('.in') %> <%= @previous_year %>
          <% else %>
            <%= t('.this_year') %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Days Traveling -->
    <div class="card bg-base-200">
      <div class="card-body p-5">
        <div class="flex justify-between items-start">
          <div class="flex items-center gap-2 text-base-content/60 text-sm">
            <%= icon 'calendar', class: 'w-4 h-4' %>
            <%= t('.days_traveling') %>
          </div>
          <% if @days_change && @days_change != 0 %>
            <span class="text-sm tabular-nums <%= @days_change.positive? ? 'text-success' : 'text-base-content/60' %>">
              <%= @days_change.positive? ? '+' : '' %><%= @days_change %>%
            </span>
          <% end %>
        </div>
        <div class="text-3xl font-medium tabular-nums mt-2"><%= @days_traveling %></div>
        <div class="text-base-content/50 text-sm">
          <% if @all_time %>
            <%= t('.all_tracked_history') %>
          <% elsif @prev_days_traveling && @prev_days_traveling.positive? %>
            <%= t('.vs') %> <%= @prev_days_traveling %> <%= t('.in') %> <%= @previous_year %>
          <% else %>
            <%= t('.active_days_this_year') %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <div class="alert alert-info mb-6">
    <%= icon 'info', class: 'w-5 h-5' %>
    <span><%= t('.no_stats_data_available') %><%= @all_time ? '' : " for #{@selected_year}" %><%= t('.stats_are_calculated_from_your_tracked_points') %></span>
  </div>
<% end %>
