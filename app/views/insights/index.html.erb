<% content_for :title, t('.insights') %>
<%= render 'shared/chartkick_scripts' %>

<% insights_cache_key = [current_user.id, "insights", I18n.locale, @selected_year, @year_stats&.maximum(:updated_at), current_user.safe_settings.distance_unit] %>

<div class="w-full my-5">
  <%= render 'header' %>
  <%= render 'shared/plan_data_window_alert', utm_content: 'insights' %>

  <% if @year_locked %>
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 mb-6">
      <% %w[total_distance countries cities days_traveling].each do |metric| %>
        <%= render 'pro_locked_card', title: t(".#{metric}"), utm_content: "insights_#{metric}" %>
      <% end %>
    </div>
    <div class="flex flex-col lg:flex-row gap-6">
      <div class="w-full lg:w-3/4 mb-6">
        <%= render 'pro_locked_card', title: t('.activity_heatmap'), utm_content: 'activity_heatmap' %>
      </div>
      <div class="w-full lg:w-1/4 mb-6">
        <%= render 'pro_locked_card', title: t('.activity_streak'), utm_content: 'activity_streak' %>
      </div>
    </div>
    <%= turbo_frame_tag "insights_details" do %>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6 mt-6">
        <div class="space-y-6">
          <%= render 'pro_locked_card', title: t('.year_comparison'), utm_content: 'year_comparison' %>
          <%= render 'pro_locked_card', title: t('.activity_breakdown'), utm_content: 'activity_breakdown' %>
          <%= render 'pro_locked_card', title: t('.location_clusters'), utm_content: 'location_clusters' %>
        </div>
        <div class="space-y-6">
          <%= render 'pro_locked_card', title: t('.monthly_digest'), utm_content: 'monthly_digest' %>
          <%= render 'pro_locked_card', title: t('.travel_patterns'), utm_content: 'travel_patterns' %>
        </div>
      </div>
      <%= render 'pro_locked_card', title: t('.movement_wellness'), utm_content: 'movement_wellness' %>
    <% end %>
  <% else %>
    <%= render 'stats_row' %>

    <% if @all_time %>
      <%= render 'tracking_summary' %>
      <%= render 'year_cards' if @stats_by_year.any? || @locked_years.any? %>
    <% else %>
      <%= render 'months' %>
      <% if current_user.full_access? %>
        <%= turbo_frame_tag "residency-content", src: map_residency_path(year: @selected_year), loading: :lazy do %>
          <%= render 'days_per_country_skeleton' %>
        <% end %>
      <% elsif @activity_heatmap %>
        <% cache insights_cache_key + ['year_calendar'], expires_in: 24.hours do %>
          <%= render 'year_calendar', year: @selected_year, activity: @activity_heatmap %>
        <% end %>
      <% end %>
      <% if !current_user.full_access? && current_user.stats.exists?(year: @selected_year - 1) %>
        <div class="mb-6" data-testid="distance-race-locked">
          <%= render 'pro_locked_card', title: t('insights.distance_race.title', year: @selected_year, previous: @selected_year - 1),
                                        utm_content: 'distance_race' %>
        </div>
      <% end %>
    <% end %>

    <!-- Lazy-loaded below-the-fold details -->
    <%= turbo_frame_tag "insights_details", src: details_insights_path(year: @selected_year, month: params[:month]), loading: :lazy do %>
      <%= render 'details_skeleton' %>
    <% end %>
  <% end %>

  <!-- Footer -->
  <div class="text-center text-sm text-base-content/50 py-4">
    <%= t('.geodata_insights_bull_powered_by_your_location_history') %>
  </div>
</div>
