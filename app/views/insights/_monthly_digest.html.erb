<% if @monthly_digest.present? %>
  <div class="card bg-base-200">
    <div class="card-body p-5">
      <div class="flex justify-between items-center">
        <h2 class="card-title text-lg font-medium flex items-center gap-2">
          <%= icon 'calendar', class: 'w-4 h-4 text-base-content/60' %>
          <%= monthly_digest_title(@monthly_digest) %>
        </h2>
        <div class="join">
          <% prev_link = previous_month_link(@selected_year, @selected_month, @available_months) %>
          <% if prev_link %>
            <%= link_to prev_link, class: 'join-item btn btn-xs btn-ghost' do %>
              <%= icon 'chevron-left', class: 'w-4 h-4' %>
            <% end %>
          <% else %>
            <button class="join-item btn btn-xs btn-ghost btn-disabled"><%= icon 'chevron-left', class: 'w-4 h-4' %></button>
          <% end %>

          <div class="dropdown dropdown-end">
            <label tabindex="0" class="join-item btn btn-xs btn-ghost">
              <%= @monthly_digest.month_name %>
              <%= icon 'chevron-down', class: 'w-3 h-3 ml-1' %>
            </label>
            <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-base-200 rounded-box w-40">
              <% @available_months.each do |m| %>
                <li>
                  <%= link_to l(Date.new(@selected_year, m, 1), format: :month_name), details_insights_path(year: @selected_year, month: m),
                      class: m == @selected_month ? 'active' : '' %>
                </li>
              <% end %>
            </ul>
          </div>

          <% next_link = next_month_link(@selected_year, @selected_month, @available_months) %>
          <% if next_link %>
            <%= link_to next_link, class: 'join-item btn btn-xs btn-ghost' do %>
              <%= icon 'chevron-right', class: 'w-4 h-4' %>
            <% end %>
          <% else %>
            <button class="join-item btn btn-xs btn-ghost btn-disabled"><%= icon 'chevron-right', class: 'w-4 h-4' %></button>
          <% end %>
        </div>
      </div>

      <!-- Stats Row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-4 [&_.text-xs]:break-words [&>div]:min-w-0">
        <div class="text-center">
          <div class="flex items-center justify-center gap-1 text-base-content/60 text-xs mb-1">
            <%= icon 'route', class: 'w-3 h-3' %>
          </div>
          <div class="text-lg font-medium tabular-nums"><%= monthly_digest_distance(@monthly_digest, current_user) %></div>
          <div class="text-xs text-base-content/60"><%= t('.total_distance') %></div>
        </div>
        <div class="text-center">
          <div class="flex items-center justify-center gap-1 text-base-content/60 text-xs mb-1">
            <%= icon 'calendar', class: 'w-3 h-3' %>
          </div>
          <div class="text-lg font-medium tabular-nums"><%= monthly_digest_active_days(@monthly_digest) %></div>
          <div class="text-xs text-base-content/60"><%= t('.active_days') %></div>
        </div>
        <div class="text-center">
          <div class="flex items-center justify-center gap-1 text-base-content/60 text-xs mb-1">
            <%= icon 'globe', class: 'w-3 h-3' %>
          </div>
          <div class="text-lg font-medium tabular-nums"><%= @monthly_digest.countries_count %></div>
          <div class="text-xs text-base-content/60"><%= t('.countries') %></div>
        </div>
        <div class="text-center">
          <div class="flex items-center justify-center gap-1 text-base-content/60 text-xs mb-1">
            <%= icon 'building', class: 'w-3 h-3' %>
          </div>
          <div class="text-lg font-medium tabular-nums"><%= @monthly_digest.cities_count %></div>
          <div class="text-xs text-base-content/60"><%= t('.cities') %></div>
        </div>
      </div>

      <!-- Weekly Pattern -->
      <div class="mt-4">
        <div class="text-sm font-medium mb-2"><%= t('.weekly_pattern') %></div>
        <div class="h-32">
          <% weekly_data = weekly_pattern_chart_data(@monthly_digest, current_user) %>
          <% weekly_peak = weekly_data.map(&:last).max %>
          <%= column_chart(
            weekly_data,
            height: '120px',
            suffix: " #{current_user.safe_settings.distance_unit}",
            dataset: { borderWidth: 0, backgroundColor: weekly_data.map { |_, v| v.positive? && v == weekly_peak ? '#60A5FA' : 'rgba(128, 128, 128, 0.35)' } },
            library: {
              plugins: {
                legend: { display: false }
              },
              scales: {
                x: {
                  grid: { display: false }
                },
                y: {
                  grid: { color: 'rgba(128, 128, 128, 0.15)' },
                  ticks: { display: false }
                }
              }
            }
          ) %>
        </div>
      </div>

      <!-- Top Locations & First Visits -->
      <div class="grid grid-cols-2 gap-4 mt-4">
        <div>
          <div class="text-sm font-medium mb-2"><%= t('.top_locations') %></div>
          <div class="space-y-1 text-sm">
            <% top_locations = top_locations_from_digest(@monthly_digest) %>
            <% if top_locations.any? %>
              <% top_locations.each_with_index do |location, idx| %>
                <div class="flex justify-between">
                  <span><%= idx + 1 %>. <%= location[:name] %></span>
                  <span class="tabular-nums text-base-content/60"><%= format_location_time(location[:minutes]) %></span>
                </div>
              <% end %>
            <% else %>
              <div class="text-base-content/50"><%= t('.no_location_data') %></div>
            <% end %>
          </div>
        </div>
        <div>
          <div class="flex items-center gap-1 text-sm font-medium mb-2">
            <%= icon 'flag', class: 'w-4 h-4 text-base-content/60' %>
            <%= t('.first_visits') %>
          </div>
          <div class="space-y-1 text-sm">
            <% first_visits = first_time_visits_from_digest(@monthly_digest) %>
            <% if first_visits[:countries].any? || first_visits[:cities].any? %>
              <% first_visits[:countries].first(2).each do |country| %>
                <div class="flex justify-between">
                  <span><%= country %></span>
                  <span class="text-xs text-base-content/50"><%= t('.country') %></span>
                </div>
              <% end %>
              <% first_visits[:cities].first(3 - first_visits[:countries].first(2).size).each do |city| %>
                <div class="flex justify-between">
                  <span><%= city %></span>
                  <span class="text-xs text-base-content/50"><%= t('.city') %></span>
                </div>
              <% end %>
            <% else %>
              <div class="text-base-content/50"><%= t('.no_new_places_this_month') %></div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Month over Month comparison -->
      <% if @monthly_digest.mom_distance_change.present? %>
        <div class="mt-4 pt-4 border-t border-base-300">
          <div class="text-sm font-medium text-base-content/60 mb-2"><%= t('.vs_previous_month') %></div>
          <div class="flex gap-4 text-sm">
            <% mom_change = @monthly_digest.mom_distance_change %>
            <div class="flex items-center gap-1">
              <span class="tabular-nums <%= mom_change.positive? ? 'text-success' : 'text-base-content/60' %>">
                <%= mom_change.positive? ? '+' : '' %><%= mom_change %>%
              </span>
              <span class="text-base-content/60"><%= t('.distance') %></span>
            </div>
            <% if @monthly_digest.mom_countries_change.present? && @monthly_digest.mom_countries_change != 0 %>
              <div class="flex items-center gap-1">
                <span class="tabular-nums <%= @monthly_digest.mom_countries_change.positive? ? 'text-success' : 'text-base-content/60' %>">
                  <%= @monthly_digest.mom_countries_change.positive? ? '+' : '' %><%= @monthly_digest.mom_countries_change %>
                </span>
                <span class="text-base-content/60"><%= t('.countries_2') %></span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% elsif @available_months.any? %>
  <div class="card bg-base-200">
    <div class="card-body p-5">
      <h2 class="card-title text-lg font-medium flex items-center gap-2">
        <%= icon 'calendar', class: 'w-4 h-4 text-base-content/60' %>
        <%= t('.monthly_digest') %>
      </h2>
      <p class="text-base-content/60"><%= t('.select_a_month_to_view_its_digest') %></p>
      <div class="flex flex-wrap gap-2 mt-2">
        <% @available_months.each do |m| %>
          <%= link_to l(Date.new(@selected_year, m, 1), format: :month_name), details_insights_path(year: @selected_year, month: m), class: 'btn btn-sm btn-outline' %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
