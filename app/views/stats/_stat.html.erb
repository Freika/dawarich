<%= link_to month_stats_path(year: stat.year, month: stat.month),
            class: 'group block min-w-0 rounded-lg border border-base-300 bg-base-100 px-3 py-2.5 transition-colors hover:border-primary/40' do %>
  <div class="flex items-center gap-1.5 text-sm font-medium" style="color: <%= month_color(stat) %>;">
    <%= icon month_icon(stat), class: 'w-4 h-4 shrink-0' %>
    <span class="truncate"><%= l(Date.new(stat.year, stat.month, 1), format: :month_name) %></span>
  </div>
  <div class="mt-1 text-lg font-semibold tabular-nums text-base-content">
    <%= number_with_delimiter stat.distance_in_unit(current_user.safe_settings.distance_unit).round %>
    <span class="text-xs font-normal text-base-content/60"><%= current_user.safe_settings.distance_unit %></span>
  </div>
  <% location = countries_and_cities_stat_for_month(stat) %>
  <div class="truncate text-xs text-base-content/60" title="<%= location %>"><%= location %></div>
  <% if local_assigns[:share] %>
    <div class="mt-2 h-1 overflow-hidden rounded-full bg-base-300" aria-hidden="true">
      <div class="h-full rounded-full" style="width: <%= (share * 100).clamp(3, 100).round(1) %>%; background-color: <%= month_color(stat) %>;"></div>
    </div>
  <% end %>
<% end %>
