<% content_for :title, t('.month_year_monthly_digest', month: l(Date.new(@year, @month, 1), format: :month_name), year: @year) %>
<%= render 'shared/chartkick_scripts' %>

<div class="w-full my-5">
  <%= render 'shared/plan_data_window_alert', utm_content: 'stats_month' %>
  <% if @stat %>
    <%= render partial: 'stats/month', locals: { year: @year, month: @month, stat: @stat, previous_stat: @previous_stat } %>
  <% else %>
    <div class="alert"><%= t('.no_location_data_available_for_this_month') %></div>
  <% end %>
</div>
