<% if DawarichSettings.store_geodata? %>
  <div class="stat text-center">
    <div class="stat-value text-secondary">
      <%= number_with_delimiter @points_reverse_geocoded %>
    </div>
    <div class="stat-title"><%= t('.reverse_geocoded_points') %></div>
    <div class="stat-desc"><%= t('.percent_of_total', percent: number_with_precision(@points_reverse_geocoded_percentage, precision: 1, strip_insignificant_zeros: true)) %></div>
    <% if @points_reverse_geocoded_without_data.to_i.positive? %>
      <div class="stat-title">
        <span class="tooltip underline decoration-dotted" data-tip="<%= t('.points_that_were_reverse_geocoded_but_had_no_data') %>">
          <%= number_with_delimiter @points_reverse_geocoded_without_data %> <%= t('.points_without_data') %>
        </span>
      </div>
    <% end %>
  </div>
<% end %>

<div class="stat text-center"
     data-controller="stats-countries-map"
     data-stats-countries-map-visited-countries-value="<%= @visited_countries_map_data.to_json %>">
  <div class="stat-value text-warning underline hover:no-underline hover:cursor-pointer"
       data-action="click->stats-countries-map#open">
    <%= number_with_delimiter current_user.total_countries %>
  </div>
  <div class="stat-title"><%= t('.countries_visited') %></div>

  <dialog id="countries_visited" class="modal" data-stats-countries-map-target="dialog">
    <div class="modal-box max-w-4xl">
      <h3 class="font-bold text-lg"><%= t('.countries_visited') %></h3>
      <div class="relative mt-4 h-64 overflow-hidden rounded-box bg-base-300 sm:h-80">
        <div data-stats-countries-map-target="map" class="h-full w-full"></div>
        <div data-stats-countries-map-target="status"
             class="absolute inset-0 flex items-center justify-center p-4 text-center text-sm"
             role="status"
             aria-live="polite"></div>
      </div>

      <div class="mt-6 max-h-64 overflow-y-auto">
        <% current_user.countries_visited.each do |country| %>
          <p><%= country %></p>
        <% end %>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button><%= t('.close') %></button>
    </form>
  </dialog>
</div>

<div class="stat text-center">
  <div class="stat-value hover:cursor-pointer hover:no-underline underline" onclick="cities_visited.showModal()">
    <%= current_user.total_cities %>
  </div>
  <div class="stat-title"><%= t('.cities_visited') %></div>
    <dialog id="cities_visited" class="modal">
      <div class="modal-box">
        <h3 class="font-bold text-lg"><%= t('.cities_visited') %></h3>
        <p class="py-4">
          <% current_user.cities_visited.each do |city| %>
            <p><%= city %></p>
          <% end %>
        </p>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button><%= t('.close') %></button>
      </form>
    </dialog>
  </div>
</div>
