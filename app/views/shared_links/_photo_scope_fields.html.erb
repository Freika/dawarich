<% id_prefix = local_assigns.fetch(:id_prefix, 'shared-link') %>
<% albums = Array(local_assigns[:immich_albums] || @immich_albums) %>
<% resource = local_assigns[:resource] %>

<%
  trip_start =
    if resource.respond_to?(:started_at)
      resource.started_at
    elsif resource.respond_to?(:start_at)
      resource.start_at
    end

  trip_end =
    if resource.respond_to?(:ended_at)
      resource.ended_at
    elsif resource.respond_to?(:end_at)
      resource.end_at
    end

  album_options = albums.filter_map do |album|
    album_id =
      if album.respond_to?(:id)
        album.id
      else
        album[:id] || album['id']
      end

    album_name =
      if album.respond_to?(:album_name)
        album.album_name
      elsif album.respond_to?(:name)
        album.name
      else
        album[:album_name] ||
          album['album_name'] ||
          album[:albumName] ||
          album['albumName'] ||
          album[:name] ||
          album['name']
      end

    album_start_raw =
      album[:start_date] ||
      album['start_date'] ||
      album[:startDate] ||
      album['startDate']

    album_end_raw =
      album[:end_date] ||
      album['end_date'] ||
      album[:endDate] ||
      album['endDate']

    asset_count =
      album[:asset_count] ||
      album['asset_count'] ||
      album[:assetCount] ||
      album['assetCount']

    next if album_id.blank? || album_name.blank?
    next if asset_count.to_i.zero?

    if trip_start.present? && trip_end.present?
      album_start = Time.zone.parse(album_start_raw.to_s) if album_start_raw.present?
      album_end = Time.zone.parse(album_end_raw.to_s) if album_end_raw.present?

      next if album_start.blank? || album_end.blank?
      next unless album_end >= trip_start && album_start <= trip_end
    end

    [
      album_name,
      album_id,
      {
        data: {
          album_name: album_name,
          show_photos: '1'
        }
      }
    ]
  rescue ArgumentError
    next
  end

  album_options.sort_by! { |option| option.first.to_s.downcase }
%>
<div class="form-control mt-4 rounded-lg border border-base-300 p-4"
     data-photo-source-selector>
  <span class="label-text font-semibold">Photos</span>

  <%= hidden_field_tag 'shared_link[settings][show_photos]', '0',
                       data: { photo_sources_show_photos: true } %>

  <label class="label cursor-pointer px-0">
    <span class="label-text">No photos</span>
    <%= check_box_tag nil, '1', true,
                      id: "#{id_prefix}_no_photos",
                      class: 'checkbox',
                      data: { no_photos_choice: true } %>
  </label>

  <div class="mt-2 border-t border-base-300 pt-2">
    <label class="label cursor-pointer px-0">
      <span>
        <span class="label-text font-medium">PhotoPrism</span>
        <% unless current_user.photoprism_integration_configured? %>
          <span class="block text-xs text-base-content/60">Not configured</span>
        <% end %>
      </span>
      <%= hidden_field_tag 'shared_link[settings][show_photoprism]', '0' %>
      <%= check_box_tag 'shared_link[settings][show_photoprism]', '1', false,
                        id: "#{id_prefix}_show_photoprism",
                        class: 'toggle',
                        disabled: true,
                        data: {
                          photo_source_choice: true,
                          integration_configured: current_user.photoprism_integration_configured?
                        } %>
    </label>
  </div>

  <div class="mt-2 border-t border-base-300 pt-2">
    <label class="label cursor-pointer px-0">
      <span>
        <span class="label-text font-medium">Immich</span>
        <% unless current_user.immich_integration_configured? %>
          <span class="block text-xs text-base-content/60">Not configured</span>
        <% end %>
      </span>
      <%= hidden_field_tag 'shared_link[settings][show_immich]', '0' %>
      <%= check_box_tag 'shared_link[settings][show_immich]', '1', false,
                        id: "#{id_prefix}_show_immich",
                        class: 'toggle',
                        disabled: true,
                        data: {
                          photo_source_choice: true,
                          immich_choice: true,
                          integration_configured: current_user.immich_integration_configured?
                        } %>
    </label>

    <div class="mt-2" data-immich-album-fields>
      <%= hidden_field_tag 'shared_link[settings][photo_album_name]',
                           '',
                           data: { photo_album_name: true } %>

      <label for="<%= "#{id_prefix}_photo_album_id" %>"
             class="label-text text-sm">
        Immich album
      </label>

      <%= select_tag 'shared_link[settings][photo_album_id]',
                     options_for_select(
                       [['All photos / no album', '', { data: { album_name: '' } }]] + album_options
                     ),
                     id: "#{id_prefix}_photo_album_id",
                     class: 'select select-bordered w-full mt-1',
                     disabled: true,
                     data: { photo_album_choice: true } %>

      <% if current_user.immich_integration_configured? && album_options.empty? %>
        <span class="label-text-alt mt-1">No matching Immich albums were found.</span>
      <% else %>
        <span class="label-text-alt mt-1">
          “All photos” uses the previous unfiltered Immich search.
        </span>
      <% end %>
    </div>
  </div>
</div>

<script>
  (() => {
    const syncPhotoSources = (wrapper) => {
      const noPhotos = wrapper.querySelector("[data-no-photos-choice]");
      const sources = Array.from(
        wrapper.querySelectorAll("[data-photo-source-choice]")
      );
      const showPhotos = wrapper.querySelector(
        "[data-photo-sources-show-photos]"
      );
      const immich = wrapper.querySelector("[data-immich-choice]");
      const albumChoice = wrapper.querySelector(
        "[data-photo-album-choice]"
      );
      const albumName = wrapper.querySelector(
        "[data-photo-album-name]"
      );

      if (!noPhotos || !showPhotos) return;

      sources.forEach((source) => {
        const configured = source.dataset.integrationConfigured === "true";
        source.disabled = noPhotos.checked || !configured;
        if (noPhotos.checked || !configured) source.checked = false;
      });

      const anySource = sources.some((source) => source.checked);
      showPhotos.value = anySource ? "1" : "0";

      if (albumChoice) {
        albumChoice.disabled = !immich?.checked;
      }

      const selectedOption =
        albumChoice?.options[albumChoice.selectedIndex];

      const selectedAlbumName =
        selectedOption?.dataset.albumName || "";

      if (albumName) albumName.value = immich?.checked ? selectedAlbumName : "";
    };

    document
      .querySelectorAll("[data-photo-source-selector]")
      .forEach(syncPhotoSources);

    if (window.sharedLinkPhotoSourceSelectorInstalled) return;

    window.sharedLinkPhotoSourceSelectorInstalled = true;

    document.addEventListener("change", (event) => {
      const choice = event.target.closest(
        "[data-no-photos-choice], [data-photo-source-choice], [data-photo-album-choice]"
      );

      if (!choice) return;

      const wrapper = choice.closest(
        "[data-photo-source-selector]"
      );

      if (!wrapper) return;

      const noPhotos = wrapper.querySelector("[data-no-photos-choice]");
      if (choice.matches("[data-photo-source-choice]") && choice.checked) {
        noPhotos.checked = false;
      }

      syncPhotoSources(wrapper);
    });
  })();
</script>
