<% id_prefix = local_assigns.fetch(:id_prefix, 'shared-link') %>
<% albums = Array(local_assigns[:immich_albums] || @immich_albums) %>
<% resource = local_assigns[:resource] %>

<%
  trip_start =
    if resource.respond_to?(:started_at)
      resource.started_at
    elsif resource.respond_to?(:start_at)
      resource.start_at
    end

  trip_end =
    if resource.respond_to?(:ended_at)
      resource.ended_at
    elsif resource.respond_to?(:end_at)
      resource.end_at
    end

  album_options = albums.filter_map do |album|
    album_id =
      if album.respond_to?(:id)
        album.id
      else
        album[:id] || album['id']
      end

    album_name =
      if album.respond_to?(:album_name)
        album.album_name
      elsif album.respond_to?(:name)
        album.name
      else
        album[:album_name] ||
          album['album_name'] ||
          album[:albumName] ||
          album['albumName'] ||
          album[:name] ||
          album['name']
      end

    album_start_raw =
      album[:start_date] ||
      album['start_date'] ||
      album[:startDate] ||
      album['startDate']

    album_end_raw =
      album[:end_date] ||
      album['end_date'] ||
      album[:endDate] ||
      album['endDate']

    asset_count =
      album[:asset_count] ||
      album['asset_count'] ||
      album[:assetCount] ||
      album['assetCount']

    next if album_id.blank? || album_name.blank?
    next if asset_count.to_i.zero?

    if trip_start.present? && trip_end.present?
      album_start = Time.zone.parse(album_start_raw.to_s) if album_start_raw.present?
      album_end = Time.zone.parse(album_end_raw.to_s) if album_end_raw.present?

      next if album_start.blank? || album_end.blank?
      next unless album_end >= trip_start && album_start <= trip_end
    end

    [
      album_name,
      album_id,
      { data: { album_name: album_name } }
    ]
  rescue ArgumentError
    next
  end

  album_options.sort_by! { |option| option.first.to_s.downcase }
%>
<div class="form-control mt-4" data-photo-album-selector>
  <label for="<%= "#{id_prefix}_photo_album_id" %>">
    <span class="label-text font-semibold">Photos</span>
  </label>

  <%= hidden_field_tag 'shared_link[settings][show_photos]',
                       '0',
                       data: { photo_album_show_photos: true } %>

  <%= hidden_field_tag 'shared_link[settings][photo_album_name]',
                       '',
                       data: { photo_album_name: true } %>

  <%= select_tag 'shared_link[settings][photo_album_id]',
                 options_for_select(
                   [
                     [
                       'No photos',
                       '',
                       { data: { album_name: '' } }
                     ]
                   ] + album_options
                 ),
                 id: "#{id_prefix}_photo_album_id",
                 class: 'select select-bordered w-full mt-2',
                 data: { photo_album_choice: true } %>

  <% if album_options.empty? %>
    <span class="label-text-alt mt-1">
      No Immich albums were found.
    </span>
  <% else %>
    <span class="label-text-alt mt-1">
      Only photos from the selected Immich album will be shared.
    </span>
  <% end %>
</div>

<script>
  (() => {
    const syncPhotoAlbumSelection = (wrapper) => {
      const albumChoice = wrapper.querySelector(
        "[data-photo-album-choice]"
      );

      const showPhotos = wrapper.querySelector(
        "[data-photo-album-show-photos]"
      );

      const albumName = wrapper.querySelector(
        "[data-photo-album-name]"
      );

      if (!albumChoice || !showPhotos || !albumName) return;

      const selectedOption =
        albumChoice.options[albumChoice.selectedIndex];

      const selectedAlbumId = albumChoice.value;
      const selectedAlbumName =
        selectedOption?.dataset.albumName || "";

      showPhotos.value = selectedAlbumId ? "1" : "0";
      albumName.value = selectedAlbumName;
    };

    document
      .querySelectorAll("[data-photo-album-selector]")
      .forEach(syncPhotoAlbumSelection);

    if (window.sharedLinkPhotoAlbumSelectorInstalled) return;

    window.sharedLinkPhotoAlbumSelectorInstalled = true;

    document.addEventListener("change", (event) => {
      const albumChoice = event.target.closest(
        "[data-photo-album-choice]"
      );

      if (!albumChoice) return;

      const wrapper = albumChoice.closest(
        "[data-photo-album-selector]"
      );

      if (!wrapper) return;

      syncPhotoAlbumSelection(wrapper);
    });
  })();
</script>
