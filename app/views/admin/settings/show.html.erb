<% content_for :title, t('.title') %>

<div class="min-h-content w-full my-5">
  <%= render 'shared/page_header', title: t('.title') %>
  <%= render 'settings/navigation' %>

  <div class="max-w-5xl">
    <p class="max-w-3xl mb-6 text-base-content/70 [text-wrap:pretty]"><%= t('.intro') %></p>

    <section aria-labelledby="instance-settings-geocoding" class="mb-8">
      <h2 id="instance-settings-geocoding" class="text-xl font-semibold"><%= t('.geocoding.title') %></h2>
      <p class="mt-1 mb-4 max-w-3xl text-base-content/70 [text-wrap:pretty]"><%= t('.geocoding.description') %></p>
      <%= render 'admin/settings/geocoding_status', geocoding: @geocoding, legacy_user_geocoding: @legacy_user_geocoding %>
      <p class="mt-3 max-w-3xl text-sm text-base-content/70 [text-wrap:pretty]"><%= t('.geocoding.chain_hint') %></p>
    </section>

    <%= turbo_frame_tag 'instance-settings-sections', data: { turbo_action: 'advance' } do %>
    <div class="flex flex-col lg:flex-row gap-6 items-start">
      <nav class="w-full lg:w-64 shrink-0" aria-label="<%= t('.sections_nav') %>">
        <p class="mb-2 text-[10px] font-bold uppercase tracking-[0.05em] text-base-content/70"><%= t('.geocoding.title') %></p>
        <div class="space-y-2">
          <% Admin::SettingsHelper::GEOCODING_SECTIONS.each do |section| %>
            <%= render 'admin/settings/section_link', section: section %>
          <% end %>
        </div>
        <div class="mt-6">
          <%= render 'admin/settings/section_link', section: 'points' %>
        </div>
      </nav>

      <div class="flex-1 min-w-0 w-full">
        <%= render 'admin/settings/section', section: @section %>
      </div>
    </div>
    <% end %>
  </div>
</div>
