<div class="flex items-center gap-3 mb-3">
  <%= integration_icon('geocoding', css: 'size-6') %>
  <h2 class="text-xl font-semibold"><%= t('settings.integrations.index.services.geocoding') %></h2>
</div>
<p class="text-base-content/60 max-w-2xl mb-6"><%= t('settings.geocoding.show.intro') %></p>

<% if @geocoding_config.env_managed? %>
  <div class="flex items-start gap-3 rounded-box border border-base-content/15 bg-base-200 p-4 mb-6 max-w-3xl">
    <%= icon 'info', class: 'w-5 h-5 shrink-0 text-info mt-0.5' %>
    <span class="text-sm"><%= t('settings.geocoding.show.env_managed_notice') %></span>
  </div>
<% end %>

<% active_provider = @settings_by_provider.values.find(&:active)&.provider || 'disabled' %>
<% chibigeo_host = ServiceSettings::GeocodingSchema::CHIBIGEO_HOST %>
<% chibigeo_bare_host = ServiceSettings::GeocodingSchema::CHIBIGEO_BARE_HOST %>
<% komoot_host = ServiceSettings::GeocodingSchema::KOMOOT_HOST %>
<% photon_setting = @settings_by_provider['photon'] %>
<% photon_host = photon_setting&.host || chibigeo_host %>
<% photon_bare_host = photon_host.split('/').first.to_s.split(':').first %>
<% photon_choice =
     case photon_bare_host
     when chibigeo_bare_host then 'chibigeo'
     when komoot_host then 'komoot'
     else 'custom'
     end %>
<% photon_https_locked = PHOTON_HTTPS_ONLY_HOSTS.include?(photon_bare_host) %>
<% rps_rules = {
     'komoot' => Geocoding::RateLimits.for('photon', komoot_host),
     'chibigeo' => Geocoding::RateLimits.for('photon', chibigeo_host),
     'custom' => Geocoding::RateLimits.for('photon', 'photon.example.com')
   } %>
<% rps_bounds = rps_rules.transform_values { |rule| { min: rule.min, max: rule.max, locked: rule.locked } } %>
<% rps_hints = {
     'komoot' => t('settings.geocoding.show.rps_hint_komoot'),
     'chibigeo' => t('settings.geocoding.show.rps_hint_chibigeo'),
     'custom' => t('settings.geocoding.show.rps_hint_custom')
   } %>
<% field_measure = 'w-full' %>
<% chibigeo_utm = 'utm_source=dawarich&utm_medium=app&utm_campaign=geocoding_settings' %>
<% chibigeo_site_url = "https://chibigeo.com/?#{chibigeo_utm}" %>
<% chibigeo_docs_url = "https://chibigeo.com/docs/guides/dawarich-self-hosted-geocoding?#{chibigeo_utm}" %>

<div class="rounded-box border border-base-content/10 bg-base-200 max-w-3xl"
     data-controller="geocoding-settings"
     data-geocoding-settings-chibigeo-host-value="<%= chibigeo_host %>"
     data-geocoding-settings-chibigeo-bare-host-value="<%= chibigeo_bare_host %>"
     data-geocoding-settings-komoot-host-value="<%= komoot_host %>"
     data-geocoding-settings-https-only-hosts-value="<%= PHOTON_HTTPS_ONLY_HOSTS.to_json %>"
     data-geocoding-settings-rps-bounds-value="<%= rps_bounds.to_json %>"
     data-geocoding-settings-rps-hints-value="<%= rps_hints.to_json %>">
  <%= form_with url: settings_geocoding_path, method: :patch, data: { turbo: false } do |f| %>
    <div class="card-body space-y-8">
      <div class="form-control <%= field_measure %>">
        <%= f.label :provider, class: 'label' do %>
          <span class="label-text font-medium"><%= t('settings.geocoding.show.provider') %></span>
        <% end %>
        <%= f.select :provider,
                     [[t('settings.geocoding.show.disabled'), 'disabled'], %w[Photon photon], %w[Geoapify geoapify],
                      %w[Nominatim nominatim], %w[LocationIQ locationiq]],
                     { selected: active_provider },
                     class: 'select select-bordered w-full',
                     data: { geocoding_settings_target: 'select', action: 'change->geocoding-settings#providerChanged' } %>
        <span class="label-text-alt mt-1 text-base-content/60"><%= t('settings.geocoding.show.provider_hint') %></span>
      </div>

      <div class="border-t border-base-content/10 pt-6 space-y-6"
           data-geocoding-settings-target="fieldset"
           data-provider="photon"
           <%= 'hidden' unless active_provider == 'photon' %>>
        <div class="<%= field_measure %>" role="radiogroup" aria-label="<%= t('settings.geocoding.show.host_choice') %>">
          <div class="label"><span class="label-text font-medium"><%= t('settings.geocoding.show.host_choice') %></span></div>
          <div class="space-y-2">
          <% [
            { value: 'chibigeo', title: t('settings.geocoding.show.choice_chibigeo'), desc: t('settings.geocoding.show.choice_chibigeo_desc'), badge: t('settings.geocoding.show.recommended'),
              link: { label: t('settings.geocoding.show.chibigeo_site_link'), url: chibigeo_site_url } },
            { value: 'komoot', title: t('settings.geocoding.show.choice_komoot'), desc: t('settings.geocoding.show.choice_komoot_desc'), badge: nil },
            { value: 'custom', title: t('settings.geocoding.show.choice_custom'), desc: t('settings.geocoding.show.choice_custom_desc'), badge: nil }
          ].each do |option| %>
            <label class="flex items-start gap-3 rounded-lg border p-3 cursor-pointer transition-colors
                          <%= photon_choice == option[:value] ? 'border-primary/60' : 'border-base-content/10' %>">
              <%= radio_button_tag 'photon_host_choice', option[:value], photon_choice == option[:value],
                                   class: 'radio radio-primary radio-sm mt-0.5',
                                   data: { geocoding_settings_target: 'hostChoice',
                                           action: 'change->geocoding-settings#choiceChanged' } %>
              <span class="flex-1">
                <span class="flex flex-wrap items-center gap-2">
                  <span class="label-text font-medium"><%= option[:title] %></span>
                  <% if option[:badge] %>
                    <span class="badge badge-primary badge-outline badge-sm"><%= option[:badge] %></span>
                  <% end %>
                </span>
                <span class="block text-sm text-base-content/60 mt-0.5">
                  <%= option[:desc] %>
                  <% if option[:link] %>
                    <%= link_to option[:link][:label], option[:link][:url],
                                target: '_blank', rel: 'noopener',
                                class: 'link link-primary whitespace-nowrap' %>
                  <% end %>
                </span>
              </span>
            </label>
          <% end %>
          </div>
        </div>

        <div class="<%= field_measure %>" data-geocoding-settings-target="chibigeoPanel" <%= 'hidden' unless photon_choice == 'chibigeo' %>>
          <div class="flex items-start gap-3 rounded-lg border border-base-content/10 p-4">
            <%= icon 'info', class: 'w-5 h-5 shrink-0 text-info mt-0.5' %>
            <div class="text-sm space-y-1">
              <p><%= t('settings.geocoding.show.chibigeo_message') %></p>
              <p><%= t('settings.geocoding.show.chibigeo_limits') %></p>
              <p class="flex flex-wrap gap-x-4 gap-y-1">
                <%= link_to t('settings.geocoding.show.chibigeo_key_link'), chibigeo_docs_url,
                            target: '_blank', rel: 'noopener',
                            class: 'link link-primary font-medium' %>
              </p>
            </div>
          </div>
        </div>
        <div class="<%= field_measure %>" data-geocoding-settings-target="komootWarning" <%= 'hidden' unless photon_choice == 'komoot' %>>
          <div class="flex items-start gap-3 rounded-lg border border-warning/40 bg-warning/10 p-4">
            <%= icon 'triangle-alert', class: 'w-5 h-5 shrink-0 text-warning mt-0.5' %>
            <div class="text-sm space-y-1">
              <p><%= t('settings.geocoding.show.komoot_warning') %></p>
              <p><%= t('settings.geocoding.show.komoot_no_api_key') %></p>
            </div>
          </div>
        </div>

        <div data-geocoding-settings-target="customHostWrapper" <%= 'hidden' unless photon_choice == 'custom' %>>
          <div class="form-control <%= field_measure %>">
            <label class="label"><span class="label-text font-medium"><%= t('settings.geocoding.show.host') %></span></label>
            <%= text_field_tag 'photon[host]', photon_host,
                               class: 'input input-bordered w-full',
                               placeholder: 'photon.example.com',
                               data: { geocoding_settings_target: 'hostInput',
                                       action: 'input->geocoding-settings#hostChanged' } %>
            <span class="label-text-alt mt-1 text-base-content/60"><%= t('settings.geocoding.show.host_hint') %></span>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 <%= field_measure %> items-start">
          <div class="form-control">
            <label class="label"><span class="label-text font-medium"><%= t('settings.geocoding.show.use_https') %></span></label>
            <label class="input input-bordered flex items-center gap-3 cursor-pointer">
              <%= hidden_field_tag 'photon[use_https]', photon_https_locked ? '1' : '0',
                                   data: { geocoding_settings_target: 'httpsHidden' } %>
              <%= check_box_tag 'photon[use_https]', '1',
                                photon_setting ? photon_setting.use_https : true,
                                class: 'toggle toggle-primary toggle-sm peer',
                                disabled: photon_https_locked,
                                data: { geocoding_settings_target: 'httpsToggle' } %>
              <span class="text-sm text-base-content/70 peer-checked:hidden"><%= t('settings.geocoding.show.https_off') %></span>
              <span class="text-sm text-base-content/70 hidden peer-checked:inline"><%= t('settings.geocoding.show.https_on') %></span>
            </label>
            <span class="label-text-alt mt-1 text-base-content/60"
                  data-geocoding-settings-target="httpsLockedHint"
                  <%= 'hidden' unless photon_https_locked %>><%= t('settings.geocoding.show.https_locked') %></span>
          </div>

          <div class="form-control">
            <label class="label"><span class="label-text font-medium"><%= t('settings.geocoding.show.rps') %></span></label>
            <%= number_field_tag 'photon[rps]', photon_setting&.rps,
                                 class: 'input input-bordered w-full',
                                 step: 'any',
                                 min: rps_rules[photon_choice].min,
                                 max: rps_rules[photon_choice].max,
                                 disabled: rps_rules[photon_choice].locked,
                                 data: { geocoding_settings_target: 'rpsInput' } %>
            <span class="label-text-alt mt-1 text-base-content/60"
                  data-geocoding-settings-target="rpsHint"><%= rps_hints[photon_choice] %></span>
          </div>
        </div>

        <div data-geocoding-settings-target="apiKeyWrapper" class="form-control <%= field_measure %>"
             <%= 'hidden' if photon_choice == 'komoot' %>>
          <label class="label"><span class="label-text font-medium"><%= t('settings.geocoding.show.api_key') %></span></label>
          <%= password_field_tag 'photon[api_key]', nil,
                                 class: 'input input-bordered w-full',
                                 autocomplete: 'off',
                                 placeholder: photon_setting&.api_key.present? ? '••••••••' : '' %>
          <span class="label-text-alt mt-1 text-base-content/60">
            <% if photon_setting&.api_key.present? %>
              <%= t('settings.geocoding.show.api_key_saved') %> <%= t('settings.geocoding.show.api_key_hint') %>
            <% else %>
              <%= t('settings.geocoding.show.api_key_hint') %>
            <% end %>
          </span>
          <% if photon_setting&.api_key.present? %>
            <label class="label cursor-pointer justify-start gap-3 mt-2">
              <%= check_box_tag 'photon[clear_api_key]', '1', false, class: 'checkbox checkbox-sm' %>
              <span class="label-text"><%= t('settings.geocoding.show.clear_api_key') %></span>
            </label>
          <% end %>
        </div>
      </div>

      <% (Geocoding::Providers::CHAIN - ['photon']).each do |provider| %>
        <% setting = @settings_by_provider[provider] %>
        <% with_host = Geocoding::Providers.host_required?(provider) %>
        <div class="border-t border-base-content/10 pt-6 space-y-6"
             data-geocoding-settings-target="fieldset"
             data-provider="<%= provider %>"
             <%= 'hidden' unless provider == active_provider %>>
          <% if with_host %>
            <div class="form-control <%= field_measure %>">
              <label class="label"><span class="label-text font-medium"><%= t('settings.geocoding.show.host') %></span></label>
              <%= text_field_tag "#{provider}[host]", setting&.host,
                                 class: 'input input-bordered w-full',
                                 placeholder: "#{provider}.example.com" %>
              <span class="label-text-alt mt-1 text-base-content/60"><%= t('settings.geocoding.show.host_hint') %></span>
            </div>
          <% end %>
          <% rule = Geocoding::RateLimits.for(provider, setting&.host) %>
          <div class="grid gap-4 sm:grid-cols-2 <%= field_measure %> items-start">
            <% if with_host %>
              <div class="form-control">
                <label class="label"><span class="label-text font-medium"><%= t('settings.geocoding.show.use_https') %></span></label>
                <label class="input input-bordered flex items-center gap-3 cursor-pointer">
                  <%= hidden_field_tag "#{provider}[use_https]", '0' %>
                  <%= check_box_tag "#{provider}[use_https]", '1', setting ? setting.use_https : true,
                                    class: 'toggle toggle-primary toggle-sm peer' %>
                  <span class="text-sm text-base-content/70 peer-checked:hidden"><%= t('settings.geocoding.show.https_off') %></span>
                  <span class="text-sm text-base-content/70 hidden peer-checked:inline"><%= t('settings.geocoding.show.https_on') %></span>
                </label>
              </div>
            <% end %>
            <div class="form-control">
              <label class="label"><span class="label-text font-medium"><%= t('settings.geocoding.show.rps') %></span></label>
              <%= number_field_tag "#{provider}[rps]", setting&.rps,
                                   class: 'input input-bordered w-full',
                                   step: 'any', min: rule.min, max: rule.max %>
              <span class="label-text-alt mt-1 text-base-content/60"><%= t('settings.geocoding.show.rps_hint_custom') %></span>
            </div>
          </div>
          <div class="form-control <%= field_measure %>">
            <label class="label"><span class="label-text font-medium"><%= t('settings.geocoding.show.api_key') %></span></label>
            <%= password_field_tag "#{provider}[api_key]", nil,
                                   class: 'input input-bordered w-full',
                                   autocomplete: 'off',
                                   placeholder: setting&.api_key.present? ? '••••••••' : '' %>
            <span class="label-text-alt mt-1 text-base-content/60">
              <% if setting&.api_key.present? %>
                <%= t('settings.geocoding.show.api_key_saved') %> <%= t('settings.geocoding.show.api_key_hint') %>
              <% else %>
                <%= t('settings.geocoding.show.api_key_hint') %>
              <% end %>
            </span>
            <% if setting&.api_key.present? %>
              <label class="label cursor-pointer justify-start gap-3 mt-2">
                <%= check_box_tag "#{provider}[clear_api_key]", '1', false, class: 'checkbox checkbox-sm' %>
                <span class="label-text"><%= t('settings.geocoding.show.clear_api_key') %></span>
              </label>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="card-actions pt-2">
        <%= f.submit t('settings.geocoding.show.save'), class: 'btn btn-primary' %>
      </div>
    </div>
  <% end %>

  <div class="border-t border-base-content/10 px-8 py-5">
    <div class="flex flex-wrap items-center gap-4">
      <%= button_to t('settings.geocoding.show.test'), test_settings_geocoding_path, method: :post, class: 'btn btn-outline btn-sm' %>
      <span class="text-sm text-base-content/60"><%= t('settings.geocoding.show.test_hint') %></span>
    </div>
  </div>
</div>
