<% content_for :title, t('.settings') %>

<div class="min-h-content w-full my-5">
  <%= render 'shared/page_header', title: t('.user_settings') %>
  <%= render 'settings/navigation' %>

  <% if @pro_required %>
    <div class="rounded-box border border-base-content/10 bg-base-200">
      <div class="card-body text-center items-center py-12">
        <h2 class="text-2xl flex font-bold mb-2 items-center">
          <%= icon 'shield-check', class: 'mr-2 text-primary' %> <%= t('.immich_photoprism_integrations') %>
        </h2>
        <p class="text-base-content/60 mb-6 max-w-md">
          <%= t('.connect_your_photo_management_tools_to_see_your_photos_on') %>
        </p>
        <a href="<%= upgrade_url(utm_medium: 'settings', utm_content: 'integrations') %>"
           class="btn btn-primary">
          <%= t('.upgrade_to_pro') %>
        </a>
      </div>
    </div>
  <% else %>
    <div class="flex flex-col lg:flex-row gap-6 items-start">
      <nav class="w-full lg:w-64 shrink-0 space-y-2" aria-label="<%= t('.services_nav') %>">
        <% @services.each do |service| %>
          <% active = service == @service %>
          <%= link_to settings_integrations_path(service: service),
                      class: "flex items-center gap-3 rounded-box border p-3 transition-colors " \
                             "#{active ? 'border-primary/60 bg-base-200' : 'border-base-content/10 hover:border-base-content/25'}",
                      aria: { current: active ? 'page' : nil },
                      data: { testid: "integration-#{service}", status: @statuses.status(service) } do %>
            <%= integration_icon(service) %>
            <span class="font-medium flex-1 truncate"><%= t(".services.#{service}") %></span>
            <%= integration_status_icon(@statuses.status(service)) %>
          <% end %>
        <% end %>
      </nav>

      <div class="flex-1 min-w-0 w-full">
        <%= render "settings/integrations/#{@service}" %>
      </div>
    </div>

    <% unless DawarichSettings.self_hosted? || current_user.provider.blank? %>
      <div class="rounded-box border border-base-content/10 bg-base-200 mt-6 max-w-3xl">
        <div class="card-body">
          <h2 class="text-lg font-semibold flex items-center">
            <%= icon 'link', class: 'text-primary mr-2 size-5' %> <%= t('.connected_accounts') %>
          </h2>
          <p class="text-sm text-base-content/60">
            <%= t('.you_ve_connected_your_account_using_the_following_oauth_provider') %>
            <strong><%= current_user.provider.capitalize %></strong>
          </p>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
