<%
  items = [
    [t('.general'), settings_general_index_path, active_tab?(settings_general_index_path)],
    [t('.integrations'), settings_integrations_path, active_tab?(settings_integrations_path)],
    [t('.visits'), settings_visits_path, active_tab?(settings_visits_path)],
    [t('.geofencing'), settings_geofencing_path, controller_path.in?(%w[settings/geofencing settings/webhooks]) ? 'tab-active' : '']
  ]
  items << [t('.two_factor_authentication'), settings_two_factor_path, active_tab?(settings_two_factor_path)] if DawarichSettings.two_factor_available?
  if DawarichSettings.self_hosted?
    if current_user.admin?
      items << [t('.users'), settings_users_path, controller_path == 'settings/users' ? 'tab-active' : '']
      items << [t('.instance'), admin_settings_path, controller_path == 'admin/settings' ? 'tab-active' : '']
    end
    items << [t('.background_jobs'), settings_background_jobs_path, active_tab?(settings_background_jobs_path)]
  end
%>
<nav class="mb-6" aria-label="<%= t('ux_p2.settings.sections') %>">
  <label class="form-control md:hidden" data-controller="section-navigation">
    <span class="label-text mb-1"><%= t('ux_p2.settings.sections') %></span>
    <select class="select select-bordered w-full" data-testid="settings-section-select" data-action="change->section-navigation#navigate">
      <% items.each do |label, path, active| %><option value="<%= path %>" <%= 'selected' if active == 'tab-active' %>><%= label %></option><% end %>
    </select>
  </label>
  <div class="hidden md:block overflow-x-auto pb-1" data-controller="scroll-into-view">
    <div class="tabs tabs-boxed inline-flex min-w-max flex-nowrap" role="tablist">
      <% items.each do |label, path, active| %><%= link_to label, path, role: 'tab', class: "tab tab-lg #{active}", aria: { selected: active == 'tab-active' } %><% end %>
    </div>
  </div>
</nav>
