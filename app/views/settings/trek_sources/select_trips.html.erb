<% content_for :title, t('.title') %>

<div class="container max-w-3xl mx-auto px-4 my-8">
  <%= render 'shared/page_header', title: t('.title') %>
  <p class="text-base-content/60 mb-6"><%= t('.subtitle') %></p>

  <%= form_with url: import_trips_settings_trek_source_path(@source), method: :post, data: { turbo: false }, class: 'space-y-3' do %>
    <% @remote_trips.each do |trip| %>
      <% identifier = trip.fetch('id').to_s %>
      <label class="flex items-start gap-3 rounded-box border border-base-content/10 bg-base-200 p-4 cursor-pointer hover:border-primary/50">
        <%= check_box_tag 'trip_ids[]', identifier, @selected_identifiers.include?(identifier), class: 'checkbox checkbox-primary mt-1' %>
        <span>
          <span class="font-semibold block"><%= trip['title'].presence || t('.untitled_trip') %></span>
          <span class="text-sm text-base-content/60"><%= trip['start_date'] %> – <%= trip['end_date'] %></span>
          <% if trip['archived'] %><span class="badge badge-ghost badge-sm ml-2"><%= t('.archived') %></span><% end %>
        </span>
      </label>
    <% end %>
    <div class="flex gap-2 pt-3">
      <%= submit_tag t('.import_selected'), class: 'btn btn-primary' %>
      <%= link_to t('.back'), settings_integrations_path(service: 'trek'), class: 'btn btn-ghost' %>
    </div>
  <% end %>
</div>
