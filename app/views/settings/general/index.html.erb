<% content_for :title, t('.general_settings') %>

<div class="min-h-content w-full my-5">
  <%= render 'shared/page_header', title: t('.general_settings') %>
  <%= render 'settings/navigation' %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="card bg-base-200 shadow-xl">
      <%= form_with url: settings_general_path, method: :patch, data: { turbo: false } do |f| %>
        <div class="card-body">
          <div class="space-y-8 animate-fade-in">
            <!-- Email Preferences Section -->
            <div id="email-digests">
              <h2 class="text-2xl font-bold mb-4 flex items-center">
                <%= icon 'mail', class: "text-primary mr-2" %> <%= t('.email_preferences') %>
              </h2>
              <div class="bg-base-100 p-5 rounded-lg shadow-sm space-y-4">
                <div class="form-control">
                  <label class="label cursor-pointer justify-start gap-4">
                    <%= f.check_box :monthly_digest_emails_enabled,
                                    checked: current_user.safe_settings.monthly_digest_emails_enabled?,
                                    class: "toggle toggle-primary" %>
                    <div>
                      <span class="label-text font-medium"><%= t('.monthly_digest_emails') %></span>
                      <p class="text-sm text-base-content/70 mt-1">
                        <%= t('.summary_of_your_last_month_sent_on_the_2nd') %>
                      </p>
                    </div>
                  </label>
                </div>
                <div class="form-control">
                  <label class="label cursor-pointer justify-start gap-4">
                    <%= f.check_box :yearly_digest_emails_enabled,
                                    checked: current_user.safe_settings.yearly_digest_emails_enabled?,
                                    class: "toggle toggle-primary" %>
                    <div>
                      <span class="label-text font-medium"><%= t('.year_end_digest_emails') %></span>
                      <p class="text-sm text-base-content/70 mt-1">
                        <%= t('.receive_an_annual_summary_on_january_2nd_with_your_year') %>
                      </p>
                    </div>
                  </label>
                </div>
                <div class="form-control">
                  <label class="label cursor-pointer justify-start gap-4">
                    <%= f.check_box :news_emails_enabled,
                                    checked: current_user.safe_settings.news_emails_enabled?,
                                    class: "toggle toggle-primary" %>
                    <div>
                      <span class="label-text font-medium"><%= t('.news_updates') %></span>
                      <p class="text-sm text-base-content/70 mt-1">
                        <%= t('.receive_occasional_emails_about_new_features_and_important_updates') %>
                      </p>
                    </div>
                  </label>
                </div>
              </div>
            </div>

            <!-- Language Section -->
            <div>
              <h2 class="text-2xl font-bold mb-4 flex items-center">
                <%= icon 'globe', class: "text-primary mr-2" %> <%= t('.language') %>
              </h2>
              <div class="bg-base-100 p-5 rounded-lg shadow-sm space-y-4">
                <div class="form-control">
                  <label class="label">
                    <span class="label-text font-medium"><%= t('.your_language') %></span>
                  </label>
                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3" role="radiogroup"
                       aria-label="<%= t('.your_language') %>">
                    <% I18n.available_locales.each do |locale| %>
                      <label class="cursor-pointer" data-testid="language-choice">
                        <%= f.radio_button :locale, locale,
                                           checked: locale == I18n.locale,
                                           class: 'peer sr-only' %>
                        <div class="flex items-center gap-3 rounded-lg border-2 border-base-300 p-3
                                    transition-colors hover:border-base-content/30
                                    peer-checked:border-primary peer-checked:bg-primary/10
                                    peer-focus-visible:ring-2 peer-focus-visible:ring-primary">
                          <%= icon locale_flag(locale), library: 'flags',
                                   class: 'inline-block rounded-sm h-5 w-auto shadow-sm shrink-0' %>
                          <span class="font-medium truncate" lang="<%= locale %>"
                                data-testid="language-name"><%= locale_native_name(locale) %></span>
                        </div>
                      </label>
                    <% end %>
                  </div>
                  <p class="text-sm text-base-content/70 mt-3">
                    <%= t('.the_interface_emails_and_notifications_will_use_this_language') %>
                  </p>
                </div>
              </div>
            </div>

            <!-- Timezone Section -->
            <div>
              <h2 class="text-2xl font-bold mb-4 flex items-center">
                <%= icon 'clock', class: "text-primary mr-2" %> <%= t('.timezone') %>
              </h2>
              <div class="bg-base-100 p-5 rounded-lg shadow-sm space-y-4">
                <div class="form-control">
                  <label class="label">
                    <span class="label-text font-medium"><%= t('.your_timezone') %></span>
                  </label>
                  <%= f.select :timezone,
                               ActiveSupport::TimeZone.all
                                 .map { |tz| [tz.tzinfo.name, tz.formatted_offset, tz.utc_offset] }
                                 .uniq(&:first)
                                 .sort_by { |_, _, seconds| seconds }
                                 .map { |iana, offset, _| ["(GMT#{offset}) #{iana}", iana] },
                               { selected: current_user.timezone },
                               class: "select select-bordered w-full" %>
                  <p class="text-sm text-base-content/70 mt-1">
                    <%= t('.all_dates_and_times_will_be_displayed_in_this_timezone') %>
                  </p>
                </div>
              </div>
            </div>

            <% if DawarichSettings.self_hosted? && current_user.supporter? %>
              <!-- Badge Toggle (only for verified supporters) -->
              <div>
                <h2 class="text-2xl font-bold mb-4 flex items-center">
                  <%= icon 'gem', class: 'mr-2 text-sky-400' %> <%= t('.supporter_badge') %>
                </h2>
                <div class="bg-base-100 p-5 rounded-lg shadow-sm space-y-4">
                  <div class="form-control">
                    <label class="label cursor-pointer justify-start gap-4">
                      <%= f.check_box :show_supporter_badge,
                                      checked: current_user.safe_settings.show_supporter_badge?,
                                      class: "toggle toggle-primary" %>
                      <div>
                        <span class="label-text font-medium"><%= t('.show_supporter_badge_in_navbar') %></span>
                        <p class="text-sm text-base-content/70 mt-1">
                          <%= t('.display_a_gem_icon_next_to_your_profile_to_show') %>
                        </p>
                      </div>
                    </label>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
          <div class="card-actions justify-end mt-6">
            <%= f.submit t('.save_changes'), class: "btn btn-primary" %>
          </div>
        </div>
      <% end %>
    </div>

    <%= render 'settings/general/supporter_status' %>

    <%= render 'settings/general/changelog_consent' %>
  </div>
</div>
