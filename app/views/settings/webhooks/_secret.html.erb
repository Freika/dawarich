<% x_scope = 'settings.webhooks.secret' %>
<div id="webhook-secret">
  <div class="alert alert-info mb-4 flex flex-wrap items-center gap-3">
    <div class="min-w-0">
      <div class="font-semibold"><%= t("#{x_scope}.title", name: webhook.name) %></div>
      <div class="text-sm"><%= t("#{x_scope}.text") %></div>
      <code class="text-sm" style="overflow-wrap:anywhere"><%= webhook.secret %></code>
    </div>
    <button type="button" class="btn btn-sm" data-controller="clipboard"
            data-clipboard-text-value="<%= webhook.secret %>" data-action="click->clipboard#copy">
      <%= t("#{x_scope}.copy") %>
    </button>
  </div>
</div>
