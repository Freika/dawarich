<% s = 'settings.webhooks.show' %>
<% content_for :title, t("#{s}.title", name: @webhook.name) %>

<div class="min-h-content w-full my-5">
  <%= render layout: 'shared/page_header', locals: { title: t("#{s}.title", name: @webhook.name) } do %>
    <%= link_to t("#{s}.back"), settings_geofencing_path, class: 'btn btn-sm' %>
  <% end %>
  <%= render 'settings/navigation' %>

  <div class="card bg-base-200 shadow-xl">
    <div class="card-body">
      <p class="text-sm opacity-80" style="overflow-wrap:anywhere"><%= @webhook.url %></p>
      <% if @deliveries.empty? %>
        <p class="text-sm opacity-70"><%= t("#{s}.empty") %></p>
      <% else %>
        <div class="overflow-x-auto">
          <table class="table table-sm">
            <thead>
              <tr>
                <th><%= t("#{s}.time") %></th>
                <th><%= t("#{s}.event") %></th>
                <th><%= t("#{s}.status") %></th>
                <th><%= t("#{s}.attempts") %></th>
                <th><%= t("#{s}.response") %></th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @deliveries.each do |delivery| %>
                <tr data-testid="webhook-delivery">
                  <td class="whitespace-nowrap"><%= l(delivery.created_at.in_time_zone, format: :short) %></td>
                  <td>
                    <%= t("settings.geofencing.show.event_types.#{delivery.geofence_event.event_type}") %>
                    · <%= delivery.geofence_event.area.name %>
                    <% if delivery.geofence_event.synthetic? %><span class="badge badge-ghost badge-sm"><%= t("#{s}.test") %></span><% end %>
                  </td>
                  <td><%= t("#{s}.statuses.#{delivery.status}") %></td>
                  <td><%= delivery.attempt_count %></td>
                  <td class="text-xs" style="overflow-wrap:anywhere">
                    <%= [delivery.response_status, delivery.error_message].compact.join(' · ').presence || '—' %>
                  </td>
                  <td>
                    <% if delivery.status_failure? %>
                      <%= button_to t("#{s}.retry"), retry_delivery_settings_webhook_path(@webhook, delivery_id: delivery.id),
                                    class: 'btn btn-xs' %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
</div>
