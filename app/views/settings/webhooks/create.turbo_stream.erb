<%= turbo_stream.prepend 'webhooks', partial: 'settings/webhooks/webhook', locals: { webhook: @webhook, places: current_user.places.geofences.order(:name) } %>
<%= turbo_stream.replace 'webhook-secret', partial: 'settings/webhooks/secret', locals: { webhook: @webhook } %>
<%= turbo_stream.replace 'webhook-form', partial: 'settings/webhooks/form', locals: { webhook: current_user.webhooks.new, places: current_user.places.geofences.order(:name) } %>
<%= turbo_stream.remove 'webhooks-empty' %>
<%= turbo_stream.append('flash-messages', partial: 'shared/flash_message', locals: { type: :notice, message: t('settings.webhooks.create.created') }) %>
