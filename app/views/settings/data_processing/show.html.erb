<% content_for :title, t('.title') %>
<% panel = 'map.maplibre.settings_panel' %>
<% safe = current_user.safe_settings %>

<div class="min-h-content w-full my-5">
  <%= render 'shared/page_header', title: t('.title') %>
  <%= render 'settings/navigation' %>

  <p class="text-sm opacity-80 mb-6 max-w-3xl"><%= t('.intro') %></p>

  <%# How points become tracks and visits, side by side; one save for all. %>
  <%= form_with url: settings_data_processing_path, method: :patch, local: true, class: 'mb-6' do %>
    <%= fields_for :settings do |sf| %>
      <div class="grid gap-4 lg:grid-cols-2">
        <section class="card bg-base-200">
          <div class="card-body gap-4 p-5">
            <h2 class="card-title text-base"><%= icon 'route', class: 'h-5 w-5 opacity-70' %> <%= t("#{panel}.track_generation") %></h2>
            <div class="grid gap-4 sm:grid-cols-2">
              <%= render 'number_field', form: sf, key: :meters_between_routes, value: safe.meters_between_routes,
                                         label: t("#{panel}.track_split_distance"), unit: t("#{panel}.track_split_distance_unit"),
                                         hint: t("#{panel}.track_split_distance_hint") %>
              <%= render 'number_field', form: sf, key: :minutes_between_routes, value: safe.minutes_between_routes, max: 1440,
                                         label: t("#{panel}.track_split_time"), unit: t("#{panel}.track_split_time_unit"),
                                         hint: t("#{panel}.track_split_time_hint") %>
            </div>
            <div class="form-control">
              <label class="label cursor-pointer justify-start gap-3 py-0">
                <%= sf.check_box :split_tracks_at_midnight, { checked: safe.split_tracks_at_midnight?, class: 'toggle toggle-primary toggle-sm' }, '1', '0' %>
                <span class="label-text font-medium"><%= t("#{panel}.split_tracks_at_midnight") %></span>
              </label>
              <p class="text-xs text-base-content/60 mt-1"><%= t("#{panel}.split_tracks_at_midnight_hint") %></p>
            </div>
          </div>
        </section>

        <section class="card bg-base-200 scroll-mt-20" id="visits">
          <div class="card-body gap-4 p-5">
            <h2 class="card-title text-base"><%= icon 'map-pin', class: 'h-5 w-5 opacity-70' %> <%= t('.visit_detection') %></h2>
            <p class="text-xs text-base-content/60 -mt-2"><%= t('.these_settings_control_how_the_app_groups_your_gps_points') %></p>
            <div class="grid gap-4 sm:grid-cols-2">
              <%= render 'number_field', form: sf, key: :visit_radius_meters, value: safe.visit_radius_meters, min: 5, max: 500,
                                         label: t('.visit_radius_meters'), hint: t('.points_within_this_radius_are_treated_as_the_same_visit') %>
              <%= render 'number_field', form: sf, key: :visit_min_duration_minutes, value: safe.visit_min_duration_minutes, max: 60,
                                         label: t('.minimum_visit_duration_minutes'), hint: t('.skip_stops_shorter_than_this_raise_to_ignore_short_drive') %>
              <%= render 'number_field', form: sf, key: :visit_min_points, value: safe.visit_min_points, min: 2, max: 20,
                                         label: t('.minimum_points_to_count_as_a_visit'), hint: t('.lower_more_visits_suggested_including_brief_stops_default_3') %>
            </div>
          </div>
        </section>

        <section class="card bg-base-200">
          <div class="card-body gap-4 p-5">
            <h2 class="card-title text-base"><%= icon 'satellite', class: 'h-5 w-5 opacity-70' %> <%= t("#{panel}.gps_noise_filtering") %></h2>
            <div class="form-control">
              <label class="label cursor-pointer justify-start gap-3 py-0">
                <%= sf.check_box :gps_filtering_enabled, { checked: safe.gps_filtering_enabled?, class: 'toggle toggle-primary toggle-sm' }, '1', '0' %>
                <span class="label-text font-medium"><%= t("#{panel}.gps_noise_filtering") %></span>
              </label>
              <p class="text-xs text-base-content/60 mt-1"><%= t("#{panel}.hide_readings_that_cannot_be_a_real_position_impossible_jumps") %></p>
            </div>
            <div class="form-control">
              <label class="label cursor-pointer justify-start gap-3 py-0">
                <%= sf.check_box :gps_accuracy_filter_enabled, { checked: safe.gps_accuracy_filter_enabled?, class: 'toggle toggle-primary toggle-sm' }, '1', '0' %>
                <span class="label-text font-medium"><%= t("#{panel}.hide_inaccurate_points") %></span>
              </label>
              <p class="text-xs text-base-content/60 mt-1"><%= t("#{panel}.hide_inaccurate_points_hint") %></p>
            </div>
            <div class="sm:w-1/2">
              <%= render 'number_field', form: sf, key: :gps_accuracy_threshold, value: safe.gps_accuracy_threshold,
                                         min: Users::SafeSettings::GPS_ACCURACY_THRESHOLD_MIN, max: Users::SafeSettings::GPS_ACCURACY_THRESHOLD_MAX,
                                         label: t("#{panel}.accuracy_threshold"), unit: 'm' %>
            </div>
          </div>
        </section>

        <section class="card bg-base-200">
          <div class="card-body gap-4 p-5">
            <h2 class="card-title text-base"><%= icon 'chart-column', class: 'h-5 w-5 opacity-70' %> <%= t("#{panel}.city_statistics") %></h2>
            <div class="sm:w-1/2">
              <%= render 'number_field', form: sf, key: :min_minutes_spent_in_city, value: safe.min_minutes_spent_in_city,
                                         label: t("#{panel}.min_minutes_in_city"), unit: t("#{panel}.track_split_time_unit"),
                                         hint: t("#{panel}.how_long_you_must_stay_for_a_city_to_count") %>
            </div>
          </div>
        </section>

        <section class="card bg-base-200 lg:col-span-2">
          <div class="card-body gap-3 p-5">
            <h2 class="card-title text-base"><%= icon 'car', class: 'h-5 w-5 opacity-70' %> <%= t("#{panel}.transportation_mode_detection") %></h2>
            <% if @reclassifying %>
              <p role="status" class="text-sm text-info bg-info/10 rounded p-2"><%= t("#{panel}.settings_are_locked_while_recalculation_is_in_progress") %></p>
            <% end %>
            <p class="text-xs text-warning bg-warning/10 rounded p-2">
              <strong><%= t("#{panel}.note") %></strong> <%= t("#{panel}.changing_these_thresholds_will_trigger_a_recalculation_of_transportation") %>
            </p>

            <%# Disabled while re-classifying: a disabled fieldset is not submitted,
                so the rest of the form still saves. %>
            <fieldset class="form-control" data-testid="enabled-modes-fieldset" <%= 'disabled' if @reclassifying %>>
              <legend class="font-medium mb-1 text-sm"><%= t("#{panel}.detected_modes") %></legend>
              <p class="text-xs text-base-content/60 mb-2"><%= t("#{panel}.disabled_modes_won_t_be_detected_existing_tracks_aren_t") %></p>
              <%= hidden_field_tag 'settings[enabled_transportation_modes][]', '', id: nil %>
              <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-1">
                <% Track::TRANSPORTATION_MODES.keys.map(&:to_s).each do |mode| %>
                  <label class="cursor-pointer label justify-start gap-2 py-0.5">
                    <%= check_box_tag 'settings[enabled_transportation_modes][]', mode,
                                      safe.enabled_transportation_modes.include?(mode),
                                      id: "enabled-mode-#{mode}", class: 'checkbox checkbox-sm',
                                      data: { testid: "enabled-mode-#{mode}" } %>
                    <span class="text-sm"><%= mode_emoji(mode) %> <%= t("transportation_modes.#{mode}") %></span>
                  </label>
                <% end %>
              </div>
            </fieldset>
          </div>
        </section>
      </div>
    <% end %>

    <%# Stays in reach while the sections scroll. %>
    <div class="sticky bottom-3 z-10 mt-4 flex justify-end rounded-box border border-base-content/10 bg-base-100/90 px-4 py-3 backdrop-blur">
      <button type="submit" class="btn btn-primary btn-sm"><%= icon 'save' %> <%= t("#{panel}.apply_settings") %></button>
    </div>
  <% end %>

  <% rebuilds_allowed = current_user.full_access? %>
  <section class="mb-6">
    <h2 class="flex items-center gap-2 text-base font-semibold"><%= icon 'refresh-ccw', class: 'h-5 w-5 opacity-70' %> <%= t('.existing_data') %></h2>
    <p class="text-sm opacity-80 mt-1 mb-3"><%= t('.existing_data_hint') %></p>

    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
      <%# Rebuild everything, or just the tracks, or just stats and digests, for every year or one. %>
      <%= form_with url: recalculate_settings_data_processing_path, method: :post,
                    class: 'flex flex-col gap-2 rounded-box border border-base-content/10 p-3',
                    data: { turbo_confirm: t('javascript.settings.confirm_recalculate_user_data') } do |f| %>
        <p class="text-xs text-base-content/70 grow"><%= t("#{panel}.rebuild_tracks_stats_and_digests_from_your_current_points_without") %></p>
        <div class="grid grid-cols-2 gap-2">
          <label class="form-control min-w-0">
            <span class="label-text text-xs pb-1"><%= t('.rebuild_what') %></span>
            <%= f.select :only, [[t('.rebuild_all'), ''], [t('.rebuild_tracks'), 'tracks'], [t('.rebuild_stats'), 'stats']], {},
                         class: 'select select-bordered select-sm w-full', disabled: !rebuilds_allowed %>
          </label>
          <label class="form-control min-w-0">
            <span class="label-text text-xs pb-1"><%= t('.rebuild_year') %></span>
            <%= f.select :year, [[t('.all_years'), '']] + current_user.years_tracked.map { |entry| [entry[:year], entry[:year]] }, {},
                         class: 'select select-bordered select-sm w-full', disabled: !rebuilds_allowed %>
          </label>
        </div>
        <%= f.button t("#{panel}.recalculate_tracks_stats"), type: :submit, disabled: !rebuilds_allowed, class: 'btn btn-outline btn-sm w-fit',
                     aria: { describedby: ('rebuilds-need-pro' unless rebuilds_allowed) }, data: { testid: 'recalculate-button' } %>
      <% end %>

      <%# Trip Detection reads the whole history; this runs it now instead of tonight. %>
      <% trips_on = safe.trip_detection_enabled? %>
      <div class="flex flex-col gap-2 rounded-box border border-base-content/10 p-3">
        <p class="text-xs text-base-content/70 grow"><%= t('.find_trips_hint') %></p>
        <% unless trips_on %><p id="find-trips-off" class="text-xs text-warning"><%= t('.find_trips_off') %></p><% end %>
        <%= button_to t('.find_trips'), detect_trips_settings_data_processing_path, disabled: !trips_on,
                      class: 'btn btn-outline btn-sm w-fit', aria: { describedby: ('find-trips-off' unless trips_on) },
                      data: { testid: 'find-trips-button' } %>
      </div>

      <%= render 'visit_redetection' %>

      <div class="flex flex-col gap-2 rounded-box border border-base-content/10 p-3">
        <p class="text-xs text-base-content/70 grow"><%= t("#{panel}.clears_existing_anomaly_flags_and_re_runs_the_filter_on") %></p>
        <%= button_to t("#{panel}.re_evaluate_past_data"), reapply_anomaly_filter_settings_data_processing_path,
                      disabled: !rebuilds_allowed, class: 'btn btn-outline btn-sm w-fit',
                      form: { data: { turbo_confirm: t('javascript.settings.confirm_reapply_anomaly_filter') } },
                      aria: { describedby: ('rebuilds-need-pro' unless rebuilds_allowed) },
                      data: { testid: 'reapply-anomaly-filter-button' } %>
      </div>

      <div class="flex flex-col gap-2 rounded-box border border-base-content/10 p-3">
        <p class="text-xs text-base-content/70 grow"><%= t("#{panel}.re_runs_auto_classification_across_all_your_tracks_manually_corrected") %></p>
        <%= button_to t("#{panel}.re_classify_my_history"), tracks_recalculation_path,
                      method: :post, disabled: @reclassifying, class: 'btn btn-outline btn-sm w-fit',
                      form: { data: { turbo_frame: '_top' } }, data: { testid: 'reclassify-history-button' } %>
      </div>
    </div>
    <% unless rebuilds_allowed %>
      <p id="rebuilds-need-pro" class="text-sm text-warning mt-3"><%= t('.rebuilds_need_pro') %></p>
    <% end %>
  </section>
</div>
