<div data-controller="removals"
     data-flash-target="message"
     data-removals-timeout-value="<%= type.to_sym.in?([:notice, :success]) ? 5000 : 0 %>"
     role="alert"
     class="alert <%= flash_alert_class(type) %> flash-message">
  <div class="flash-message__body">
    <span class="flash-message__icon" aria-hidden="true"><%= flash_icon(type) %></span>
    <span class="flash-message__text"><%= message %></span>
  </div>
  <button type="button"
          data-action="click->removals#remove"
          class="btn btn-sm btn-square btn-ghost flash-message__close"
          aria-label="<%= t('.close') %>">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
</div>
