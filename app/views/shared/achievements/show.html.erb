<% content_for :title, "#{@set.name} — Dawarich" %>
<% content_for :head do %>
  <meta property="og:title" content="<%= @set.name %> — Dawarich">
  <meta property="og:description" content="<%= t('achievements.public.social_description', progress: t("achievements.cards.metric.#{@set.level == :country ? 'countries' : 'regions'}", count: @set.display_count, total: @set.target)) %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= request.original_url %>">
  <meta property="og:image" content="<%= image_url('favicon/apple-touch-icon.png') %>">
  <meta name="twitter:card" content="summary">
<% end %>

<% if @embed %>
  <main class="ach-embed-page ach-page">
    <%= render 'achievements/set_card', set: @set, interactive: false %>
  </main>
<% else %>
  <div class="container mx-auto px-4 py-12 max-w-2xl">
    <div class="ach-page">
      <div class="ach-header">
        <h1 class="ach-title"><%= @set.name %></h1>
      </div>

      <div class="ach-grid">
        <%= render 'achievements/set_card', set: @set, interactive: false %>
      </div>

      <p class="ach-footnote"><%= t('achievements.public.tracked_with_html', link: link_to('Dawarich', 'https://dawarich.app')) %></p>
    </div>
  </div>
<% end %>
