<% content_for :title, "#{@set.name} — Dawarich" %>
<% content_for :head do %>
  <%= achievement_stylesheet_tags %>
  <%= stylesheet_link_tag 'achievements_public', 'data-turbo-track': 'reload' unless @embed %>
  <meta property="og:title" content="<%= @set.name %> — Dawarich">
  <meta property="og:description" content="<%= t('achievements.public.social_description', progress: t("achievements.cards.metric.#{@set.level == :country ? 'countries' : 'regions'}", count: @set.display_count, total: @set.target)) %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= shared_achievement_url(params[:uuid]) %>">
  <meta property="og:image" content="<%= shared_achievement_image_url(params[:uuid]) %>">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="<%= @set.name %> — <%= t("achievements.cards.metric.#{@set.level == :country ? 'countries' : 'regions'}", count: @set.display_count, total: @set.target) %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="<%= shared_achievement_image_url(params[:uuid]) %>">
<% end %>

<% if @embed %>
  <main class="ach-embed-page ach-page">
    <%= render 'achievements/set_card', set: @set, interactive: false %>
  </main>
<% else %>
  <div class="ach-page">
    <%= render layout: 'shared/achievements/stage',
               locals: { rarity: @set.rarity, eyebrow: t("achievements.cards.rarity.#{@set.rarity.downcase}"),
                         headline: @set.name, lead: @set.description,
                         note: @set.card_attributes[:metric_label],
                         page_url: shared_achievement_url(params[:uuid]),
                         image_path: shared_achievement_image_path(params[:uuid]) } do %>
      <%= render 'achievements/set_card', set: @set, interactive: false %>
    <% end %>
  </div>
<% end %>
