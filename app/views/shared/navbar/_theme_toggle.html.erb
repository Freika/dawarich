<% target_theme = current_user.theme == 'light' ? 'dark' : 'light' %>
<%= link_to settings_theme_path(theme: target_theme), data: { turbo: false }, aria: { label: t(target_theme == 'dark' ? '.dark_mode' : '.light_mode') },
            class: local_assigns.fetch(:css_class, 'btn btn-ghost') do %>
  <%= icon(target_theme == 'dark' ? 'moon' : 'sun') %>
  <% if local_assigns[:show_label] %>
    <span><%= t(target_theme == 'dark' ? '.dark_mode' : '.light_mode') %></span>
  <% end %>
<% end %>
