<% show_label = local_assigns.fetch(:show_label, false) %>
<details>
  <% current_language = t(".locales.#{I18n.locale}") %>
  <summary aria-label="<%= t('.current_language', language: current_language) %>"
           title="<%= t('.current_language', language: current_language) %>">
    <%= icon 'globe', class: 'h-4 w-4' %>
    <span class="uppercase"><%= I18n.locale %></span>
    <% if show_label %>
      <span><%= t('.language') %></span>
    <% end %>
  </summary>
  <ul class="p-2 bg-base-100 rounded-box shadow-md z-[50] min-w-40">
    <% supported_locales.each do |available_locale| %>
      <li>
        <%= button_to locale_path,
                      method: :patch,
                      params: { locale: available_locale },
                      form: { class: 'w-full', data: { turbo: false } },
                      class: 'flex w-full items-center justify-between gap-3',
                      aria: { current: available_locale == I18n.locale ? 'true' : nil } do %>
          <span lang="<%= available_locale %>"><%= t(".locales.#{available_locale}") %></span>
          <% if available_locale == I18n.locale %>
            <span aria-hidden="true">✓</span>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
</details>
