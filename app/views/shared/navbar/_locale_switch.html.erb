<%# Emits its own <li> per language: DaisyUI styles the direct child of a menu
    item, so a shared wrapper would swallow the padding and hover state. %>
<% selectable_locales.each do |locale| %>
  <li>
    <%= link_to locale_native_name(locale),
                locale_path(locale),
                lang: locale,
                hreflang: locale,
                data: { testid: "locale-switch-#{locale}" },
                aria: { label: t('shared.navbar.switch_language_aria_label',
                                 language: locale_native_name(locale)) } %>
  </li>
<% end %>
