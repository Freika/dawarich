<% trip = SharedLinks::TripPresenter.new(link, resource) %>

<%= tag.div class: 'container mx-auto px-4 my-5', data: trip.wrapper_data do %>
  <div class="flex flex-col lg:flex-row gap-6 <%= 'lg:h-[calc(100dvh-9.75rem)]' if trip.show_map? %>">
    <% if trip.show_map? %>
      <div class="w-full lg:w-3/5 h-[50vh] lg:h-full shrink-0">
        <div data-shared-trip-map-target="map"
             class="w-full h-full rounded-lg overflow-hidden bg-base-200 relative">
          <%= render "shared/replay_panel", stimulus: "shared-trip-map", show_day_nav: true %>
        </div>
      </div>
    <% end %>

    <div class="w-full <%= trip.show_map? ? 'lg:w-2/5 lg:h-full lg:overflow-y-auto' : 'max-w-2xl mx-auto' %>">
      <div class="mb-6">
        <div class="flex items-start justify-between gap-3 mb-1">
          <h1 class="text-3xl font-bold leading-tight"><%= resource.name %></h1>
          <span class="badge badge-success badge-sm shrink-0 gap-1" aria-label="<%= t('.publicly_shared') %>">
            <%= icon 'map-pin', class: 'w-3 h-3' %> <%= t('.public') %>
          </span>
        </div>
        <p class="text-md text-base-content/60 mb-4">
          <%= human_date(resource.started_at) %> <%= t('.ndash') %> <%= human_date(resource.ended_at) %>
        </p>

        <% if trip.show_stats? %>
          <%= render "trips/countries", trip: resource, current_user: link.user, distance_unit: trip.unit %>
        <% end %>
      </div>

      <% if trip.description? %>
        <div class="mb-6">
          <h3 class="text-lg font-semibold mb-2"><%= t('.trip_notes') %></h3>
          <div class="prose max-w-none"><%= resource.description.body %></div>
        </div>
      <% end %>

      <% if trip.show_map? %>
        <div class="flex items-center gap-2 mb-4">
          <button type="button"
                  class="btn btn-sm btn-outline gap-1"
                  data-shared-trip-map-target="replayToggleBtn"
                  data-action="click->shared-trip-map#toggleReplay">
            <%= icon 'play', class: 'w-4 h-4' %>
            <span><%= t('.replay') %></span>
          </button>
        </div>
      <% end %>

      <% if trip.days? %>
        <div class="space-y-1 mb-6 px-1">
          <% trip.days.each do |day| %>
            <% day_key = day[:date].strftime('%Y-%m-%d') %>
            <% note = trip.note_for(day) %>
            <% has_note = trip.show_day_notes? && note&.body.present? %>
            <% day_photos = trip.photos_for(day) %>
            <% if has_note || day_photos.any? %>
              <%= tag.details class: "collapse collapse-arrow bg-base-200 rounded-lg#{trip.interactive_class}", data: trip.row_data(day_key) do %>
                <summary class="collapse-title flex items-center gap-2 text-sm font-medium min-h-0 cursor-pointer">
                  <%= render "shared/links/trip_day_header", day: day, day_key: day_key %>
                </summary>
                <div class="collapse-content">
                  <% if has_note %>
                    <p class="whitespace-pre-wrap text-sm text-base-content/80"><%= note.body %></p>
                  <% end %>

                  <% if day_photos.any? %>
                    <div data-trip-day-photos>
                      <div data-trip-day-photos-container></div>
                  
                      <template data-trip-day-photos-template>
                        <div class="grid grid-cols-3 gap-2 mt-3">
                          <% day_photos.each do |photo| %>
                            <button type="button"
                                    class="aspect-square overflow-hidden rounded-lg cursor-zoom-in"
                                    data-shared-photo-lightbox>
                              <img src="<%= url_for(controller: 'api/v1/shared/photos',
                                                     action: 'thumbnail',
                                                     id: link.id,
                                                     photo_id: photo[:id],
                                                     source: photo[:source],
                                                     only_path: true) %>"
                                   loading="lazy"
                                   decoding="async"
                                   alt="Foto vergrößern"
                                   class="h-full w-full object-cover"
                                   data-immich-url="<%= trip.immich_photo_url(photo) %>"
                                   data-shared-photo-image>
                            </button>
                          <% end %>
                        </div>
                      </template>
                    </div>
                  <% end %>

                </div>
              <% end %>
            <% else %>
              <%= tag.div class: "bg-base-200 rounded-lg px-4 py-3 flex items-center gap-2 text-sm font-medium#{trip.interactive_class}", data: trip.row_data(day_key) do %>
                <%= render "shared/links/trip_day_header", day: day, day_key: day_key %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
<div class="hidden fixed inset-0 z-50 items-center justify-center bg-black/90 p-4"
     data-shared-photo-overlay
     role="dialog"
     aria-modal="true"
     aria-label="Fotoansicht">

  <button type="button"
          class="absolute right-4 top-4 flex h-12 w-12 items-center justify-center rounded-full bg-black/60 text-3xl text-white"
          aria-label="Fotoansicht schließen"
          data-shared-photo-close>
    &times;
  </button>

  <% if trip.immich_shared_link? %>
    <a href="#"
       target="_blank"
       rel="noopener noreferrer"
       class="hidden absolute right-4 top-20 h-12 w-12 items-center justify-center rounded-full bg-black/60 p-2.5 opacity-60 shadow-lg transition-opacity hover:opacity-100 focus:opacity-100"
       aria-label="Foto in Immich öffnen"
       title="Foto in Immich öffnen"
       data-shared-photo-immich>
      <%= image_tag "icons/immich.svg", class: "h-full w-full drop-shadow-sm", alt: "" %>
    </a>
  <% end %>

  <img src=""
       alt=""
       class="max-h-[95vh] max-w-[95vw] object-contain"
       data-shared-photo-preview>
</div>
<script>
  (() => {
    if (window.sharedTripPhotoLoaderInstalled) return;
    window.sharedTripPhotoLoaderInstalled = true;

    const closePhoto = () => {
      const overlay = document.querySelector(
        "[data-shared-photo-overlay]"
      );
      const preview = overlay?.querySelector(
        "[data-shared-photo-preview]"
      );
      const immichLink = overlay?.querySelector(
        "[data-shared-photo-immich]"
      );

      if (!overlay || !preview) return;

      overlay.classList.add("hidden");
      overlay.classList.remove("flex");
      preview.removeAttribute("src");
      immichLink?.classList.add("hidden");
      immichLink?.classList.remove("flex");
      document.body.style.overflow = "";
    };

    const openPhoto = (image) => {
      const overlay = document.querySelector(
        "[data-shared-photo-overlay]"
      );
      const preview = overlay?.querySelector(
        "[data-shared-photo-preview]"
      );
      const immichLink = overlay?.querySelector(
        "[data-shared-photo-immich]"
      );

      if (!overlay || !preview || !image?.src) return;

      preview.src = image.src;
      preview.alt = image.alt || "Vergrößertes Foto";

      if (immichLink) {
        const immichUrl = image.dataset.immichUrl;
        if (immichUrl) immichLink.href = immichUrl;
        immichLink.classList.toggle("hidden", !immichUrl);
        immichLink.classList.toggle("flex", Boolean(immichUrl));
      }

      overlay.classList.remove("hidden");
      overlay.classList.add("flex");
      document.body.style.overflow = "hidden";
    };

    document.addEventListener("toggle", (event) => {
      const details = event.target;

      if (!(details instanceof HTMLDetailsElement)) return;

      const wrapper = details.querySelector(
        "[data-trip-day-photos]"
      );

      if (!wrapper) return;

      const container = wrapper.querySelector(
        "[data-trip-day-photos-container]"
      );

      const template = wrapper.querySelector(
        "[data-trip-day-photos-template]"
      );

      if (!container || !template) return;

      if (details.open) {
        if (!container.hasChildNodes()) {
          container.appendChild(
            template.content.cloneNode(true)
          );
        }
      } else {
        container.replaceChildren();
      }
    }, true);

    document.addEventListener("click", (event) => {
      const photoButton = event.target.closest(
        "[data-shared-photo-lightbox]"
      );

      if (photoButton) {
        const image = photoButton.querySelector(
          "[data-shared-photo-image]"
        );

        openPhoto(image);
        return;
      }

      const overlay = document.querySelector(
        "[data-shared-photo-overlay]"
      );

      if (
        event.target.closest("[data-shared-photo-close]") ||
        event.target === overlay
      ) {
        closePhoto();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closePhoto();
      }
    });
  })();
</script>
