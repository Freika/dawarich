<div class="flash-stack"
     id="flash-messages"
     data-controller="flash">
  <div data-flash-target="dismissAll" class="flash-toolbar" hidden>
    <button type="button" data-action="flash#dismissAll" class="btn btn-sm btn-ghost flash-dismiss-all">
      <%= t('.dismiss_all') %>
    </button>
  </div>
  <% flash.each do |type, message| %>
    <%= render 'shared/flash_message', type: type, message: message %>
  <% end %>
</div>
