<% content_for :title, "#{@set.name} — Dawarich" %>
<% content_for :head do %>
  <%= achievement_stylesheet_tags %>
  <meta property="og:title" content="<%= @set.name %> — Dawarich">
  <meta property="og:description" content="<%= @set.metric_label %>">
  <meta property="og:image" content="<%= shared_collectible_image_url(@card.sharing_uuid) %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
<% end %>
<main class="ach-page <%= @embed ? 'ach-embed-page' : 'max-w-sm mx-auto py-10 px-4' %>">
  <%= render 'achievements/card', **@set.card_attributes %>
  <% unless @embed %><p class="mt-5"><%= t('achievements.public.tracked_with_html', link: link_to('Dawarich', 'https://dawarich.app')) %></p><% end %>
</main>
