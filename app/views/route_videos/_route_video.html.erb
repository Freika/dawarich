<div id="<%= dom_id(route_video) %>" class="card bg-base-200 shadow-sm">
  <% if route_video.playable? %>
    <figure>
      <video class="w-full rounded-t-lg" controls preload="metadata" playsinline
             src="<%= rails_blob_path(route_video.file, only_path: true) %>"></video>
    </figure>
  <% end %>
  <div class="card-body p-3">
    <h4 class="card-title text-sm min-w-0 break-words"><%= route_video.name %></h4>
    <% unless route_video.playable? %>
      <p class="text-xs opacity-70">
        <%= t('.expired_on', date: l(route_video.expired_at || route_video.updated_at, format: :long)) %>
      </p>
      <p class="text-xs opacity-50"><%= t('.expired_hint') %></p>
    <% end %>
    <div class="card-actions justify-end">
      <% if route_video.playable? %>
        <%= link_to t('.download'),
              rails_blob_path(route_video.file, disposition: 'attachment', only_path: true),
              class: 'btn btn-xs btn-primary' %>
      <% else %>
        <button type="button" class="btn btn-xs btn-ghost"
                data-action="video-studio#restoreSettings"
                data-settings="<%= route_video.settings.to_json %>">
          <%= t('.re_render') %>
        </button>
      <% end %>
      <%= link_to t('.delete'), route_video_path(route_video),
            class: 'btn btn-xs btn-ghost',
            data: { turbo_method: :delete, turbo_confirm: t('.delete_this_video') } %>
    </div>
  </div>
</div>
