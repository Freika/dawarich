<div class="mx-auto md:w-2/3 w-full my-6">
  <%= render @notification %>

  <div class="mt-5 flex flex-wrap items-center gap-2">
    <% if @notification.safe_action_path %>
      <%= link_to t('.open'), @notification.safe_action_path, class: "btn btn-sm btn-primary" %>
    <% end %>
    <%= link_to t('.back_to_notifications'), notifications_path, class: "btn btn-sm" %>
    <%= button_to t('.destroy_this_notification'), @notification, data: { turbo_confirm: t('.are_you_sure') }, method: :delete, class: "btn btn-sm btn-ghost text-error" %>
  </div>
</div>
