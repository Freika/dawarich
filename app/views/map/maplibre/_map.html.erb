<%# The map with everything on it: layers, button cluster, side panel, replay.
    Locals: start_at, end_at - the period the layers load %>
<div id="maps-maplibre-container"
     data-controller="maps--maplibre maps--maplibre-realtime"
     data-maps--maplibre-api-key-value="<%= current_user.api_key %>"
     data-maps--maplibre-start-date-value="<%= start_at.iso8601 %>"
     data-maps--maplibre-end-date-value="<%= end_at.iso8601 %>"
     data-maps--maplibre-timezone-value="<%= current_user.timezone_iana %>"
     data-maps--maplibre-user-plan-value="<%= current_user.effective_plan %>"
     data-maps--maplibre-gated-layers-value="<%= Users::PlanSettingsGate::GATED_MAP_LAYERS.to_json %>"
     data-maps--maplibre-data-window-start-value="<%= current_user.entitlements.data_window_start&.iso8601 %>"
     data-maps--maplibre-import-id-value="<%= @import_id %>"
     data-maps--maplibre-privacy-zones-fingerprint-value="<%= privacy_zones_fingerprint %>"
     data-maps--maplibre-exploration-messages-value="<%= { calculating: t('achievements.collections.calculating'), updating: t('achievements.collections.updating'), error: t('achievements.collections.calculation_failed') }.to_json %>"
     <% if @exploration_bounds %>data-maps--maplibre-exploration-bounds-value="<%= @exploration_bounds.to_json %>"<% end %>
     <% if @exploration_snapshot_id %>data-maps--maplibre-exploration-snapshot-value="<%= @exploration_snapshot_id %>"<% end %>
     <% if @current_position %>data-maps--maplibre-current-position-value="<%= @current_position.to_json %>"<% end %>
     data-maps--maplibre-upgrade-url-value="<%= upgrade_url(utm_medium: 'map', utm_content: 'maplibre') %>"
     data-maps--maplibre-realtime-enabled-value="true"
     data-maps--maplibre-realtime-live-mode-value="<%= current_user.safe_settings.live_map_enabled %>"
     data-family-members-features-value="<%= current_user_features.to_json %>"
     style="width: 100%; height: 100%; position: relative;">

  <!-- WebGL error (hidden by default, shown if WebGL unavailable) -->
  <%= render 'map/maplibre/webgl_error' %>

  <!-- Map container takes full width and height. Pre-apply panel classes
       when the URL requests the Timeline panel — otherwise the JS-driven
       toggle animates the panel in from off-screen on every Turbo nav. -->
  <% timeline_panel_open = params[:panel] == 'timeline' %>
  <div data-maps--maplibre-target="container"
       class="maps-maplibre-container<%= ' panel-open panel-timeline-expanded' if timeline_panel_open %>"
       style="width: 100%; height: 100%;">
  </div>

  <!-- Loading progress badge -->
  <div data-maps--maplibre-target="progressBadge" class="map-progress-badge">
    <span class="map-progress-badge-dot"></span>
    <span data-maps--maplibre-target="progressBadgeText"><%= t('map.maplibre.index.loading') %></span>
  </div>

  <%# Replay dock: the period totals are its pull tab, the panel opens under it. %>
  <div class="replay-dock">
    <button type="button" class="map-range-statistics"
            data-action="click->maps--maplibre#toggleReplay"
            data-testid="replay-tab"
            aria-expanded="false"
            title="<%= t('map.maplibre.button_cluster.replay') %>">
      <%= icon 'play', class: 'replay-tab__icon', aria: { hidden: true } %>
      <span data-testid="map-range-statistics"
            role="status" aria-live="polite" aria-atomic="true"
            title="<%= t('javascript.range_statistics.scope') %>"><%= t('map.maplibre.index.loading') %></span>
      <%= icon 'chevron-up', class: 'replay-tab__chevron', aria: { hidden: true } %>
    </button>
    <%= render 'map/maplibre/replay_panel' %>
  </div>

  <!-- Map-edge button cluster (top-right corner) -->
  <%= render 'map/maplibre/button_cluster', start_at: start_at, end_at: end_at %>

  <!-- The period: a button with the calendar behind it, beside the cluster -->
  <%= render 'shared/map/date_navigation_v2', start_at: start_at, end_at: end_at %>

  <!-- Timeline map-corner overlays (shown only when Timeline tab is active; CSS handles visibility) -->
  <div class="timeline-map-overlay timeline-map-overlay--scope" data-timeline-feed-target="scopeBadge">
    <span class="font-semibold"><%= t('map.maplibre.index.pick_a_day') %></span>
  </div>
  <!-- Settings panel -->
  <%= render 'map/maplibre/settings_panel' %>

  <!-- Poster studio (full-screen WYSIWYG editor) -->
  <%= render 'posters/studio' %>
  <%= render 'route_videos/studio' %>

  <!-- Visit creation modal -->
  <%= render 'map/maplibre/visit_creation_modal' %>

  <!-- Map note modal -->
  <%= render 'map/maplibre/note_modal' %>

  <!-- Place creation modal (shared) -->
  <%= render 'shared/place_creation_modal' %>

</div>
