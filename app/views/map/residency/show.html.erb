<%= turbo_frame_tag "residency-content" do %>
  <%
    # Color palette: one color per country, ordered by most days
    country_colors = %w[
      bg-primary bg-secondary bg-accent bg-info bg-success
      bg-warning bg-error bg-primary/70 bg-secondary/70 bg-accent/70
      bg-info/70 bg-success/70 bg-warning/70 bg-error/70
    ]
    color_map = @countries.each_with_index.to_h { |c, i| [c[:country_name], country_colors[i % country_colors.length]] }
  %>

  <% if @countries.any? %>
    <div class="flex flex-col lg:flex-row gap-6">
      <!-- Countries, with collapsible stay periods -->
      <div class="w-full lg:w-1/4 mb-6">
        <div class="card bg-base-200 h-full">
          <div class="card-body p-3">
            <div class="flex items-center gap-2 mb-2">
              <%= icon 'globe', class: 'w-4 h-4 text-base-content/60' %>
              <h3 class="text-base font-semibold"><%= t('.countries') %></h3>
            </div>

            <div class="space-y-0.5">
              <% @countries.each_with_index do |country, i| %>
                <details class="group bg-base-100 rounded-lg">
                  <summary class="flex items-center gap-2 px-3 py-2 cursor-pointer list-none select-none
                                  [&::-webkit-details-marker]:hidden">
                    <div class="flex-shrink-0 w-2.5 h-2.5 rounded-full <%= country_colors[i % country_colors.length] %>"></div>

                    <div class="flex-shrink-0 w-6 h-4 rounded-sm overflow-hidden shadow-sm">
                      <% if country[:iso_a2].present? %>
                        <%= icon country[:iso_a2].downcase, library: 'flags', variant: 'landscape',
                            class: 'w-full h-full object-cover' %>
                      <% else %>
                        <%= icon 'globe', class: 'w-4 h-4 opacity-40' %>
                      <% end %>
                    </div>

                    <span class="font-medium flex-1 text-sm truncate">
                      <%= country[:country_name] %>
                      <% if country[:threshold_warning] %>
                        <%= icon 'triangle-alert', class: 'w-3.5 h-3.5 inline text-warning ml-1' %>
                      <% end %>
                    </span>

                    <div class="text-right flex-shrink-0">
                      <span class="font-mono font-semibold text-sm"><%= country[:days] %></span>
                      <span class="text-xs opacity-40 ml-0.5">(<%= country[:year_percentage] %>%)</span>
                    </div>

                    <%= icon 'chevron-down', class: 'w-4 h-4 flex-shrink-0 opacity-40 transition-transform group-open:rotate-180' %>
                  </summary>

                  <div class="px-3 pb-2">
                    <div class="border-t border-base-300 pt-2 space-y-1.5">
                      <p class="text-[10px] font-medium opacity-40 uppercase tracking-wider"><%= t('.stay_periods') %></p>
                      <% country[:periods].each do |period| %>
                        <div class="flex items-center justify-between gap-2 text-xs">
                          <span>
                            <%= l(Date.parse(period[:start_date]), format: :short_month_day) %> –
                            <%= l(Date.parse(period[:end_date]), format: :medium) %>
                          </span>
                          <span class="font-mono bg-base-300 px-1.5 py-0.5 rounded flex-shrink-0">
                            <%= period[:consecutive_days] %> <%= t('.days') %>
                          </span>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </details>
              <% end %>
            </div>

            <% if @countries.any? { |c| c[:threshold_warning] } %>
              <div class="flex items-start gap-2 mt-2 text-xs opacity-50">
                <%= icon 'triangle-alert', class: 'w-3.5 h-3.5 text-warning flex-shrink-0 mt-0.5' %>
                <span><%= t('.exceeds_183_day_threshold_common_in_many_tax_jurisdictions') %></span>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Year heatmap, one colour per country -->
      <div class="w-full lg:w-3/4 mb-6">
        <div class="card bg-base-200 h-full">
          <div class="card-body p-4">
            <div class="flex justify-between items-center mb-1">
              <div class="flex items-center gap-2">
                <%= icon 'calendar-range', class: 'w-5 h-5 text-base-content/60' %>
                <h3 class="text-lg font-semibold"><%= t('.days_per_country') %></h3>
              </div>
              <div class="badge badge-ghost">
                <%= @total_tracked_days %> / <%= @days_in_year %> <%= t('.days') %>
              </div>
            </div>

            <p class="text-xs opacity-50 mb-4">
              <%= t('.distinct_days_with_at_least_one_tracked_point_per_country') %>
            </p>

            <div class="overflow-x-auto">
              <div class="min-w-fit relative">
                <!-- Month labels -->
                <div class="flex ml-8 mb-1">
                  <% weeks = heatmap_week_columns(@year) %>
                  <% month_labels = heatmap_month_labels(weeks, @year) %>
                  <% last_index = 0 %>
                  <% month_labels.each do |label| %>
                    <div style="margin-left: <%= (label[:index] - last_index) * 14 %>px" class="text-xs text-base-content/60">
                      <%= label[:name] %>
                    </div>
                    <% last_index = label[:index] + 1 %>
                  <% end %>
                </div>

                <!-- Grid with day labels -->
                <div class="flex">
                  <div class="flex flex-col justify-around mr-2 text-xs text-base-content/60" style="height: 98px;">
                    <span><%= t('.mon') %></span>
                    <span><%= t('.wed') %></span>
                    <span><%= t('.fri') %></span>
                  </div>

                  <div class="flex gap-0.5">
                    <% weeks.each do |week_start| %>
                      <div class="flex flex-col gap-0.5">
                        <% 7.times do |day_offset| %>
                          <%
                            date = week_start + day_offset
                            date_key = date.strftime('%Y-%m-%d')
                            is_in_year = date.year == @year
                            is_future = date > Date.current
                            country_name = @daily_countries[date_key]
                            cell_color = country_name ? color_map[country_name] : nil
                          %>

                          <% if is_in_year && !is_future && cell_color %>
                            <div class="w-3 h-3 rounded-sm cursor-pointer transition-opacity hover:opacity-80 hover:z-50 tooltip tooltip-top <%= cell_color %>"
                                 data-tip="<%= country_name %> — <%= l(date, format: :short_weekday_month_day) %>">
                            </div>
                          <% elsif is_in_year && !is_future %>
                            <div class="w-3 h-3 rounded-sm bg-base-300"></div>
                          <% else %>
                            <div class="w-3 h-3 rounded-sm <%= is_future && is_in_year ? 'bg-base-300/30' : '' %>"></div>
                          <% end %>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </div>

                <!-- Legend: country color dots -->
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-3 text-xs text-base-content/60">
                  <% @countries.first(7).each_with_index do |country, i| %>
                    <div class="flex items-center gap-1">
                      <div class="w-2.5 h-2.5 rounded-sm <%= country_colors[i % country_colors.length] %>"></div>
                      <span><%= country[:country_name] %></span>
                    </div>
                  <% end %>
                  <% if @countries.size > 7 %>
                    <span class="opacity-40">+<%= @countries.size - 7 %> <%= t('.more') %></span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="card bg-base-200 mb-6">
      <div class="card-body p-6 items-center text-center opacity-50">
        <%= icon 'globe', class: 'w-10 h-10 mb-2' %>
        <p class="text-sm"><%= t('.no_country_data_for') %> <%= @year %>.</p>
        <p class="text-xs"><%= t('.points_need_reverse_geocoding_to_detect_countries') %></p>
      </div>
    </div>
  <% end %>
<% end %>
