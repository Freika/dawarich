<%# locals: (notes:) %>
<%# Notes written about this same date in earlier years, in today's header:
    the latest two in sight, one line each; the rest one click away. %>
<% notes = notes.to_a %>
<section class="on-this-day" data-testid="on-this-day" aria-labelledby="on-this-day-title">
  <h3 class="on-this-day__title" id="on-this-day-title"><%= icon 'calendar-clock', class: 'on-this-day__icon' %> <%= t('.on_this_day') %></h3>
  <ul class="on-this-day__list">
    <%= render partial: 'map/timeline_feeds/on_this_day_note', collection: notes.first(2), as: :note %>
  </ul>
  <% if notes.size > 2 %>
    <details class="on-this-day__more">
      <summary><%= t('.more', count: notes.size - 2) %></summary>
      <ul class="on-this-day__list">
        <%= render partial: 'map/timeline_feeds/on_this_day_note', collection: notes.drop(2), as: :note %>
      </ul>
    </details>
  <% end %>
</section>
