<%
  # The verb carries the mode; no glyph is repeated alongside it. Unknown gets
  # no icon at all — the row reads as a connector between visits, and a
  # stand-in marker there looks like a broken render rather than information.
  mode_config = {
    'walking'    => { verb: 'walked' },
    'running'    => { verb: 'ran' },
    'cycling'    => { verb: 'cycled' },
    'driving'    => { verb: 'drove' },
    'bus'        => { verb: 'bus' },
    'train'      => { verb: 'train' },
    'flying'     => { verb: 'flew' },
    'boat'       => { verb: 'sailed' },
    'motorcycle' => { verb: 'rode' },
    'stationary' => { verb: 'stayed' },
    'unknown'    => { verb: 'traveled' }
  }
  mode = entry[:dominant_mode].presence || 'unknown'
  config = mode_config[mode] || mode_config['unknown']
  continuation_date = entry[:continuation_of_date]
  if continuation_date
    leg_time = l(Time.zone.parse(entry[:ended_at]), format: :hour_minute)
    duration = format_duration_short(entry[:day_duration] || entry[:duration])
    day_distance = entry[:day_distance] || entry[:distance]
    distance_text = day_distance > 0 ? "#{day_distance} #{entry[:distance_unit]} of #{entry[:distance]} #{entry[:distance_unit]}" : nil
  else
    leg_time = l(Time.zone.parse(entry[:started_at]), format: :hour_minute)
    moving = entry[:moving_duration].to_i
    # When dwell dominates the track span (short ride, long stand), the span
    # duration misleads — show the time actually spent moving instead.
    duration = if moving.positive? && moving < entry[:duration].to_i * 0.8
                 t('.duration_moving', duration: format_duration_short(moving))
               else
                 format_duration_short(entry[:duration])
               end
    distance_text = entry[:distance] > 0 ? "#{entry[:distance]} #{entry[:distance_unit]}" : nil
  end
  track_id = entry[:track_id]
  frame_id = "track-info-#{track_id}"
  # Time is the vertical axis: the rail through a leg grows with how long the
  # leg took, so a three-hour drive outweighs a nine-minute hop on sight.
  leg_extra = journey_leg_extra_height(entry[:day_duration] || entry[:duration])
%>
<div class="timeline-entry timeline-entry--journey"
     style="--tl-leg-extra: <%= leg_extra %>px"
     data-action="mouseenter->timeline-feed#entryHover mouseleave->timeline-feed#entryUnhover"
     data-entry-type="journey"
     data-started-at="<%= entry[:started_at] %>"
     data-ended-at="<%= entry[:ended_at] %>"
     data-track-id="<%= track_id %>">
  <%# A "leg" between visits — uses the visit-row grid (time + rail + content
      + chevron) so columns line up vertically with adjacent visit rows. %>
  <div class="journey-leg<%= ' cursor-pointer' if track_id %>"
       <% if track_id %>
         data-action="click->timeline-feed#toggleTrackInfo"
         data-track-id="<%= track_id %>"
         data-frame-id="<%= frame_id %>"
         data-track-start="<%= entry[:started_at] %>"
       <% end %>>
    <div class="journey-leg__time"><%= leg_time %></div>
    <div class="journey-leg__rail-col" aria-hidden="true"></div>
    <div class="journey-leg__summary">
      <% if continuation_date %>
        <span class="journey-leg__verb"><%= t('.continued_from_date_arrived', date: l(Date.parse(continuation_date), format: :short_month_day)) %></span>
      <% else %>
        <span class="journey-leg__verb"><%= config[:verb] %></span>
      <% end %>
      <% if distance_text %>
        <span class="journey-leg__sep"><%= t('.middot') %></span>
        <span><%= distance_text %></span>
      <% end %>
      <span class="journey-leg__sep"><%= t('.middot') %></span>
      <span><%= duration %></span>
    </div>
    <% if track_id %>
      <%= icon 'chevron-down', class: 'journey-leg__chevron track-info-chevron' %>
    <% else %>
      <span></span>
    <% end %>
  </div>
  <% if track_id %>
    <turbo-frame id="<%= frame_id %>"
                 class="hidden track-info-panel"
                 data-timeline-feed-target="trackInfoFrame"
                 loading="lazy">
      <%= render 'shared/skeleton_lines', lines: 3 %>
    </turbo-frame>
  <% end %>
</div>
