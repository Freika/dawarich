<% range = local_assigns[:range] %>
<div>
  <% if range && days.any? %>
    <%# The whole period at a glance. "All days" closes the selected day. %>
    <div class="timeline-range-head" data-testid="timeline-range-head"
         data-range-start="<%= days.first[:date] %>" data-range-end="<%= days.last[:date] %>">
      <div class="min-w-0">
        <div class="font-semibold text-sm"><%= timeline_range_label(days) %></div>
        <div class="timeline-range-head__meta">
          <%= t('.day_count', count: days.size) %>
          · <%= t('map.timeline_feeds.day.visit_count', count: days.sum { |day| day_total_visits_count(day) }) %>
          <% notes = days.sum { |day| Array(day[:notes]).size } %>
          <% if notes.positive? %>· <%= t('.note_count', count: notes) %><% end %>
        </div>
        <% if local_assigns[:clamped] %>
          <div class="timeline-range-head__meta" data-testid="timeline-range-clamped">
            <%= t('.latest_days_only', count: Timeline::DayAssembler::MAX_DAYS) %>
          </div>
        <% end %>
      </div>
      <button type="button" class="btn btn-ghost btn-xs" hidden
              data-timeline-feed-target="allDaysButton"
              data-action="click->timeline-feed#showAllDays"><%= t('.all_days') %></button>
    </div>
  <% end %>
  <% if days.empty? %>
    <%# Keep the day navigator visible on empty days so users can still step
        between days (otherwise they get stuck with no way to move). %>
    <div class="timeline-day">
      <% if local_assigns[:requested_date].present? && !range %>
        <div class="timeline-day-header">
          <%= render 'map/timeline_feeds/day_nav', date: requested_date %>
        </div>
      <% end %>
      <div class="text-center text-base-content/60 py-8">
        <%= render 'shared/plan_data_window_alert', utm_content: 'timeline_feed' %>
        <p class="text-sm"><%= t('.no_visits_tracked_this_day') %></p>
        <p class="text-xs mt-1"><%= t('.visits_are_auto_detected_daily_from_your_location_data') %></p>
      </div>
    </div>
  <% else %>
    <%# A period reads like a diary, from its latest day back. %>
    <% (range ? days.reverse : days).each do |day| %>
      <%= render partial: 'map/timeline_feeds/day', locals: { day: day, range: range } %>
    <% end %>
  <% end %>
</div>
