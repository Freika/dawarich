<% if user_signed_in? %>
<% has_home = current_user.homes.exists? %>
<div data-controller="onboarding-modal"
     data-onboarding-modal-auto-value="<%= local_assigns.fetch(:auto_open, false) %>"
     data-onboarding-modal-showable-value="<%= onboarding_modal_showable?(current_user) %>"
     data-onboarding-modal-onboarding-url-value="<%= settings_onboarding_path %>"
     data-onboarding-modal-user-trial-value="<%= current_user.trial? %>"
     data-onboarding-modal-imports-count-value="<%= current_user.imports.count %>"
     data-onboarding-modal-demo-description-value="<%= t('ux_p2.demo.description') %>"
     data-onboarding-modal-demo-data-url-value="<%= demo_data_settings_onboarding_path %>"
     data-onboarding-modal-has-demo-data-value="<%= current_user.imports.exists?(demo: true) %>"
     data-onboarding-modal-has-home-value="<%= has_home %>"
     data-onboarding-modal-user-id-value="<%= current_user.id %>">
  <dialog id="getting_started" class="modal" data-onboarding-modal-target="modal">
    <div class="modal-box max-w-2xl bg-base-200">

      <%# ═══ Choice Screen ═══ %>
      <div data-onboarding-modal-target="choiceScreen">
        <div class="text-center mb-6">
          <h3 class="text-2xl font-medium mb-2"><%= t('.welcome_to_dawarich') %></h3>
          <p class="text-base-content/70">
            <%= t('.your_map_starts_with_your_next_step_literally') %>
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <%# Path A: Track (primary) %>
          <button class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow cursor-pointer text-left border-2 border-primary/40 hover:border-primary sm:col-span-2"
                  data-action="onboarding-modal#showTrack">
            <div class="card-body p-5">
              <div class="flex items-center gap-2 mb-2">
                <%= icon 'smartphone', class: 'w-6 h-6 text-primary' %>
                <h4 class="text-lg font-semibold"><%= t('.start_tracking_now') %></h4>
                <span class="badge badge-ghost badge-sm"><%= t('.minutes') %></span>
              </div>
              <p class="text-sm text-base-content/70">
                <%= t('.get_the_app_scan_a_qr_code_and_watch_your') %>
              </p>
            </div>
          </button>

          <%# Path B: Import %>
          <button class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow cursor-pointer text-left border-2 border-transparent hover:border-secondary"
                  data-action="onboarding-modal#showImport">
            <div class="card-body p-5">
              <div class="flex items-center gap-2 mb-2">
                <%= icon 'file-up', class: 'w-6 h-6 text-secondary' %>
                <h4 class="text-lg font-semibold"><%= t('.i_have_data') %></h4>
              </div>
              <p class="text-sm text-base-content/70">
                <%= t('.import_google_takeout_gpx_kml_geojson_or_owntracks_files') %>
              </p>
            </div>
          </button>

          <%# Path C: Demo Data %>
          <button class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow cursor-pointer text-left border-2 border-transparent hover:border-accent"
                  data-action="onboarding-modal#loadDemoData"
                  data-onboarding-modal-target="demoButton">
            <div class="card-body p-5">
              <div class="flex items-center gap-2 mb-2">
                <%= icon 'map', class: 'w-6 h-6 text-accent' %>
                <h4 class="text-lg font-semibold"><%= t('.explore_with_demo_data') %></h4>
              </div>
              <p class="text-sm text-base-content/70">
                <%= t('ux_p2.demo.description') %>
              </p>
            </div>
          </button>
          <%# Path D: Family %>
          <% if family_nav_visible? %>
            <%= link_to family_home_path,
                  class: "card bg-base-100 shadow-sm hover:shadow-md transition-shadow cursor-pointer text-left border-2 border-transparent hover:border-info sm:col-span-2",
                  data: { action: "onboarding-modal#dismiss" } do %>
              <div class="card-body p-5">
                <div class="flex items-center gap-2 mb-2">
                  <%= icon 'users', class: 'w-6 h-6 text-info' %>
                  <h4 class="text-lg font-semibold"><%= t('.invite_your_family') %></h4>
                </div>
                <p class="text-sm text-base-content/70">
                  <%= t(".add_your_family_and_see_each_other_on_the_map") %>
                </p>
              </div>
            <% end %>
          <% end %>
        </div>

        <div class="text-center mt-6">
          <button class="btn btn-ghost btn-sm" data-action="onboarding-modal#dismiss">
            <%= t('.skip_for_now') %>
          </button>
        </div>
      </div>

      <%# ═══ Import Screen ═══ %>
      <div data-onboarding-modal-target="importScreen" class="hidden">
        <div class="flex items-center gap-2 mb-4">
          <button class="btn btn-ghost btn-sm btn-circle" data-action="onboarding-modal#showChoice">
            <%= icon 'arrow-left', class: 'w-4 h-4' %>
          </button>
          <h3 class="text-xl font-medium"><%= t('.import_your_data') %></h3>
        </div>

        <div class="card bg-base-100 shadow-sm mb-4">
          <div class="card-body p-4">
            <h4 class="card-title text-sm"><%= t('.supported_formats') %></h4>
            <%= render "imports/supported_formats" %>
            <div class="text-xs text-base-content/60 mt-2">
              <%= t('.file_format_is_automatically_detected_during_upload') %>
            </div>
            <div class="text-xs text-base-content/60 mt-2">
              <%= t('.not_sure_where_your_app_keeps_its_export') %>
              <%= link_to t('.step_by_step_export_guides'), 'https://dawarich.app/docs/getting-started/import-sources?utm_source=app&utm_medium=referral&utm_campaign=onboarding',
                  class: 'link link-primary font-medium', target: '_blank', rel: 'noopener' %>
            </div>
            <% if current_user.legacy_trial? %>
              <div class="text-xs text-warning mt-2 font-medium">
                <%= t('.trial_limitations_max_5_imports_10mb_per_file_current_imports') %> <%= current_user.imports.count %>/5
              </div>
            <% end %>
          </div>
        </div>

        <%= form_with url: imports_path, class: "contents", data: {
          controller: "upload",
          upload_url_value: rails_direct_uploads_url,
          upload_field_name_value: "import[files][]",
          upload_multiple_value: true,
          upload_user_trial_value: current_user.legacy_trial?,
          upload_max_imports_value: 5,
          upload_current_imports_count_value: current_user.imports.count,
          upload_preserve_original_filename_value: true,
          upload_target: "form"
        } do |form| %>
          <label class="form-control w-full mb-4">
            <div class="label">
              <span class="label-text"><%= t('.select_one_or_multiple_files') %></span>
            </div>
            <%= form.file_field :files,
                multiple: true,
                direct_upload: true,
                name: "import[files][]",
                class: "file-input file-input-bordered w-full",
                data: { upload_target: "input" } %>
            <div class="text-xs text-base-content/60 mt-2">
              <%= t('.files_will_be_uploaded_directly_to_storage_please_be_patient') %>
            </div>
          </label>

          <div class="flex flex-wrap justify-end gap-2">
            <button type="button" class="btn btn-ghost" data-action="onboarding-modal#finish"><%= t('trip_detection.onboarding.continue') %></button>
            <%= form.submit t('.import_files'), class: "btn btn-primary",
                data: { upload_target: "submit" } %>
          </div>
        <% end %>
      </div>

      <%# ═══ Track Screen ═══ %>
      <div data-onboarding-modal-target="trackScreen" class="hidden">
        <div class="flex items-center gap-2 mb-4">
          <button class="btn btn-ghost btn-sm btn-circle" data-action="onboarding-modal#showChoice">
            <%= icon 'arrow-left', class: 'w-4 h-4' %>
          </button>
          <h3 class="text-xl font-medium"><%= t('.start_tracking') %></h3>
        </div>

        <div class="card bg-base-100 shadow-sm">
          <div class="card-body p-4 space-y-4">
            <%# Step 1: Download %>
            <div>
              <div class="flex items-center gap-2 mb-2">
                <div class="badge badge-ghost badge-sm tabular-nums">1</div>
                <h4 class="font-semibold"><%= t('.download_the_app') %></h4>
              </div>
              <div class="flex justify-center items-center gap-3 flex-wrap">
                <%= link_to 'https://apps.apple.com/de/app/dawarich/id6739544999?itscg=30200&itsct=apps_box_badge&mttnsubad=6739544999',
                    class: 'inline-block rounded-lg border-2 border-transparent hover:border-base-content/30 transition-colors duration-150' do %>
                  <%= image_tag 'Download_on_the_App_Store_Badge_US-UK_RGB_blk_092917.svg',
                      class: 'h-[40px] transition-opacity duration-300' %>
                <% end %>
                <%= link_to 'https://play.google.com/store/apps/details?id=app.dawarich.Dawarich',
                    class: 'inline-block rounded-lg border-2 border-transparent hover:border-base-content/30 transition-colors duration-150',
                    target: '_blank', rel: 'noopener' do %>
                  <%= image_tag 'GetItOnGooglePlay_Badge_Web_color_English.svg',
                      class: 'h-[40px] transition-opacity duration-300' %>
                <% end %>
              </div>
            </div>

            <%# Step 2: Connect %>
            <div>
              <div class="flex items-center gap-2 mb-2">
                <div class="badge badge-ghost badge-sm tabular-nums">2</div>
                <h4 class="font-semibold"><%= t('.scan_qr_code_to_connect') %></h4>
              </div>
              <p class="text-sm text-base-content/70 mb-3">
                <%= t('.scan_this_qr_code_with_the_dawarich_app_to_automatically') %>
              </p>
              <div class="flex justify-center">
                <div class="bg-white p-3 rounded-lg shadow-inner">
                  <%= api_key_qr_code(current_user, size: 3) %>
                </div>
              </div>
            </div>

            <%# Manual alternative %>
            <div class="divider text-xs"><%= t('.or') %></div>
            <p class="text-sm text-base-content/70">
              <%= t('.grab_your_api_key_from') %>
              <%= link_to t('.settings'), settings_general_index_path, class: 'link link-primary font-medium' %>
              <%= t('.and_follow_the') %>
              <%= link_to t('.setup_guide'), 'https://dawarich.app/docs/tutorials/track-your-location?utm_source=app&utm_medium=referral&utm_campaign=onboarding',
                  class: 'link link-primary font-medium', target: '_blank', rel: 'noopener' %>.
            </p>

            <p class="text-xs text-base-content/60">
              <%= t('.have_old_location_history_like_a_google_takeout_tracking_works') %> <button type="button" class="link link-primary" data-action="onboarding-modal#showImport"><%= t('.import_your_history_anytime') %></button>.
            </p>
          </div>
        </div>

        <div class="flex justify-end mt-4">
          <button class="btn btn-primary" data-action="onboarding-modal#finish">
            <%= t('.got_it_let_s_start') %>
          </button>
        </div>
      </div>

      <%# ═══ Home Screen ═══ %>
      <%# Only while onboarding is open and no Home exists. showHome() attaches place-location, so the map starts only when shown. %>
      <% if onboarding_modal_showable?(current_user) && !has_home %>
        <div data-onboarding-modal-target="homeScreen" class="hidden">
          <h3 class="text-xl font-medium mb-2"><%= t('trip_detection.onboarding.title') %></h3>
          <p class="text-sm text-base-content/70 mb-4"><%= t('trip_detection.onboarding.intro') %></p>

          <%= form_with url: homes_path, data: { action: 'turbo:submit-end->onboarding-modal#homeSaved' } do |f| %>
            <div data-onboarding-modal-target="homeMap" data-place-location-editable-value="true"
                 data-place-location-latitude-value="0" data-place-location-longitude-value="0"
                 data-place-location-tiles-url-value="<%= current_user.safe_settings.maps_maplibre_tiles_url %>"
                 data-place-location-tiles-fallback-value="<%= current_user.safe_settings.maps_maplibre_tiles_fallback? %>"
                 data-action="input->onboarding-modal#homeLocationChanged change->onboarding-modal#homeLocationChanged">
              <div class="h-64 rounded-xl overflow-hidden mb-3" data-place-location-target="map"></div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <label class="form-control min-w-0"><span><%= t('ux_p2.places.latitude') %></span><%= f.number_field :latitude, step: :any, min: -90, max: 90, required: true, class: 'input input-bordered w-full', data: { place_location_target: 'latitude', onboarding_modal_target: 'homeLatitude', action: 'change->place-location#coordinatesChanged' } %></label>
                <label class="form-control min-w-0"><span><%= t('ux_p2.places.longitude') %></span><%= f.number_field :longitude, step: :any, min: -180, max: 180, required: true, class: 'input input-bordered w-full', data: { place_location_target: 'longitude', onboarding_modal_target: 'homeLongitude', action: 'change->place-location#coordinatesChanged' } %></label>
              </div>
            </div>

            <p class="hidden text-sm text-warning mt-3" role="status" data-onboarding-modal-target="homeDeniedHint">
              <%= t('trip_detection.onboarding.location_denied') %>
            </p>

            <div class="flex flex-wrap justify-end gap-2 mt-4">
              <button type="button" class="btn btn-ghost" data-action="onboarding-modal#dismiss">
                <%= t('trip_detection.onboarding.skip') %>
              </button>
              <button type="button" class="btn btn-outline" data-action="onboarding-modal#locateHome">
                <%= t('trip_detection.onboarding.use_my_location') %>
              </button>
              <%= f.submit t('trip_detection.onboarding.confirm'), class: 'btn btn-primary', disabled: true,
                  data: { onboarding_modal_target: 'homeSubmit' } %>
            </div>
          <% end %>
        </div>
      <% end %>

    </div>

    <%# Modal backdrop %>
    <form method="dialog" class="modal-backdrop">
      <button><%= t('.close') %></button>
    </form>
  </dialog>
</div>
<% end %>
