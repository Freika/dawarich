<%= form_with url: places_path, method: :get, class: 'flex flex-wrap items-end gap-3 p-4 mb-4 bg-base-200 rounded-box', data: { testid: 'place-filters' } do |form| %>
  <%= form.hidden_field :locale, value: params[:locale] if params[:locale].present? %>
  <div class="min-w-0 flex-1 basis-48">
    <%= form.label :q, t('places.management.search'), class: 'label pt-0 pb-2 px-0 text-sm font-medium text-base-content/70' %>
    <%= form.search_field :q, value: params[:q], class: 'input input-bordered w-full min-w-0' %>
  </div>
  <div class="min-w-0">
    <%= form.label :sort, t('places.management.sort'), class: 'label pt-0 pb-2 px-0 text-sm font-medium text-base-content/70' %>
    <%= form.select :sort, [['name', t('places.index.name')], ['last_visit', t('places.management.last_visit')], ['visit_count', t('places.management.active_visits')]].map { |key, label| [label, key] }, { selected: params[:sort].presence || 'name' }, class: 'select select-bordered max-w-full' %>
  </div>
  <div class="min-w-0">
    <%= form.label :filter, t('places.management.status'), class: 'label pt-0 pb-2 px-0 text-sm font-medium text-base-content/70' %>
    <%= form.select :filter, [[t('places.index.all_places'), ''], [t('places.index.unconfirmed_places'), 'unconfirmed'], [t('places.archive.badge'), 'archived']], { selected: params[:filter] }, class: 'select select-bordered max-w-full' %>
  </div>
  <%= form.submit t('places.management.apply'), class: 'btn h-auto py-2 border-base-content/15 bg-base-100' %>
  <fieldset class="w-full min-w-0">
    <legend class="label pt-0 pb-2 px-0 text-sm font-medium text-base-content/70"><%= t('places.management.tags') %></legend>
    <div class="flex flex-wrap gap-2">
      <% @tags.each do |tag| %>
        <label class="cursor-pointer flex items-center gap-2 rounded-lg border border-base-content/10 px-3 py-2 min-w-0 max-w-full">
          <%= check_box_tag 'tag_ids[]', tag.id, Array(params[:tag_ids]).include?(tag.id.to_s), class: 'checkbox checkbox-sm shrink-0' %>
          <span class="min-w-0 [overflow-wrap:anywhere]"><%= tag.icon %> <%= tag.name %></span>
        </label>
      <% end %>
    </div>
  </fieldset>
<% end %>
