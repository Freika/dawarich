<%# Map on the left, fields on the right, as on a Trip page. The
    place-location controller wraps both columns so the map and the
    coordinate fields stay linked; extra sections (Homes) follow the form. %>
<div class="flex flex-col lg:flex-row gap-6 lg:h-[calc(100dvh-9.75rem)]"
     data-controller="place-location" data-place-location-editable-value="true"
     data-place-location-latitude-value="<%= @place.lonlat ? @place.lat : 0 %>"
     data-place-location-longitude-value="<%= @place.lonlat ? @place.lon : 0 %>"
     data-place-location-tiles-url-value="<%= current_user.safe_settings.maps_maplibre_tiles_url %>"
     data-place-location-tiles-fallback-value="<%= current_user.safe_settings.maps_maplibre_tiles_fallback? %>">
  <div class="w-full lg:w-3/5 h-[50vh] lg:h-full shrink-0 rounded-xl overflow-hidden" data-place-location-target="map"></div>
  <div class="w-full lg:w-2/5 lg:h-full lg:overflow-y-auto min-w-0 lg:pr-1">
    <h1 class="text-3xl font-bold mb-2"><%= title %></h1>
    <p class="text-sm text-base-content/70 mb-4"><%= t('ux_p2.places.pick_coordinates') %></p>
    <%= form_with model: @place, url: (@place.persisted? ? place_path(@place, place_list_params) : places_path(place_list_params)), data: { turbo: false }, class: 'space-y-4' do |f| %>
      <% if @place.errors.any? %><p role="alert" class="alert alert-error"><%= @place.errors.full_messages.join(', ') %></p><% end %>
      <%# The spot is picked on the map; the fields only carry it. %>
      <% lat = @place.errors.any? ? @place.latitude : (@place.lat if @place.lonlat) %>
      <% lon = @place.errors.any? ? @place.longitude : (@place.lon if @place.lonlat) %>
      <%= f.hidden_field :latitude, value: lat, data: { place_location_target: 'latitude' } %>
      <%= f.hidden_field :longitude, value: lon, data: { place_location_target: 'longitude' } %>
      <p class="flex items-center gap-1.5 text-sm tabular-nums">
        <%= icon 'map-pin', class: 'w-4 h-4 shrink-0 opacity-70' %>
        <span data-place-location-target="coordinates" data-testid="place-coordinates"><%= lat.present? && lon.present? ? "#{lat.to_f.round(5)}, #{lon.to_f.round(5)}" : '—' %></span>
      </p>
      <label class="form-control"><span><%= t('ux_p2.places.name') %></span><%= f.text_field :name, required: true, class: 'input input-bordered w-full' %></label>
      <label class="form-control"><span><%= t('ux_p2.places.radius') %></span><%= f.number_field :visit_radius, min: 1, max: Place::MAX_VISIT_RADIUS, required: true, class: 'input input-bordered w-full' %></label>
      <label class="form-control"><span><%= t('ux_p2.places.note') %></span><%= f.text_area :note, class: 'textarea textarea-bordered w-full' %></label>
      <fieldset><legend class="font-medium mb-2"><%= t('ux_p2.places.tag') %></legend>
        <%= hidden_field_tag 'place[tag_ids][]', '' %>
        <%# Add work: its tag is ticked here and created on save when the user has none. %>
        <% work_shortcut = params[:work].present? || params.dig(:place, :work) == '1' %>
        <% work_tag = Tag.work_tag(current_user) if work_shortcut %>
        <% if work_shortcut %>
          <label class="inline-flex items-center gap-2 mr-4 mb-2"><%= check_box_tag 'place[work]', '1', true, class: 'checkbox checkbox-sm' %><%= work_tag&.icon || Tag::WORK_ICON %> <%= work_tag&.name || t('places.shortcuts.work_place_name') %></label>
        <% end %>
        <% current_user.tags.order(:name).each do |tag| %>
          <% next if tag == work_tag %>
          <label class="inline-flex items-center gap-2 mr-4 mb-2"><%= check_box_tag 'place[tag_ids][]', tag.id, @place.tags.include?(tag), class: 'checkbox checkbox-sm' %><%= tag.icon %> <%= tag.name %></label>
        <% end %>
      </fieldset>
      <%# A Home has its periods below the form instead. %>
      <% unless @place.persisted? && @place.homes.exists? %>
        <fieldset class="min-w-0"><legend class="font-medium mb-2"><%= t('places.period.title') %></legend>
          <div class="flex flex-wrap gap-2">
            <label class="form-control flex-1 min-w-32"><span class="label-text"><%= t('trip_detection.homes.from') %></span><%= f.date_field :started_on, class: 'input input-bordered w-full' %></label>
            <label class="form-control flex-1 min-w-32"><span class="label-text"><%= t('trip_detection.homes.until') %></span><%= f.date_field :ended_on, class: 'input input-bordered w-full' %></label>
          </div>
          <p class="text-sm text-base-content/70 mt-1"><%= t('places.period.help') %></p>
        </fieldset>
      <% end %>
      <% unless local_assigns[:homes] %>
        <%# Trip detection counts every Home in effect, so a move needs the old Home closed, not a second open one. %>
        <% open_home_places = current_user.places.where(id: current_user.homes.where(ended_on: nil).select(:place_id)).order(:name) %>
        <div class="group space-y-1">
          <label class="flex items-start gap-2">
            <%= check_box_tag 'place[home]', '1', params[:home].present? || params.dig(:place, :home) == '1', class: 'checkbox checkbox-sm mt-0.5' %>
            <span class="min-w-0"><%= t('trip_detection.homes.live_here') %><span class="block text-sm text-base-content/70"><%= t('trip_detection.homes.live_here_help') %></span></span>
          </label>
          <% if open_home_places.any? %>
            <%# Shown while "I live here" is ticked; the links open in a new tab so this form keeps its input. %>
            <p class="hidden group-has-[:checked]:block text-sm text-base-content/70 ml-6 [overflow-wrap:anywhere]" data-testid="open-home-note">
              <%= t('trip_detection.homes.open_home_note_html', places: safe_join(open_home_places.map { |home_place| link_to home_place.name, edit_place_path(home_place), class: 'link', target: '_blank', rel: 'noopener' }, ', ')) %>
            </p>
          <% end %>
        </div>
      <% end %>
      <div class="flex flex-wrap gap-2"><%= f.submit t('ux_p2.places.save'), class: 'btn btn-primary' %><%= link_to t('ux_p2.places.back'), places_path(place_list_params), class: 'btn btn-ghost' %></div>
    <% end %>
    <%= render 'homes', place: @place if local_assigns[:homes] %>
  </div>
</div>
