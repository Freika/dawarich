<% content_for :title, @place.name %>

<%# Map on the left, the place's details on the right, as on a Trip page. %>
<div class="place-page w-full my-5 min-w-0">
  <div class="flex flex-col lg:flex-row gap-6 lg:h-[calc(100dvh-9.75rem)]"
       data-controller="place-location" data-place-location-latitude-value="<%= @place.lat %>" data-place-location-longitude-value="<%= @place.lon %>"
       data-place-location-tiles-url-value="<%= current_user.safe_settings.maps_maplibre_tiles_url %>" data-place-location-tiles-fallback-value="<%= current_user.safe_settings.maps_maplibre_tiles_fallback? %>">
    <div class="w-full lg:w-3/5 h-[50vh] lg:h-full shrink-0 rounded-xl overflow-hidden" data-place-location-target="map"></div>
    <div class="w-full lg:w-2/5 lg:h-full lg:overflow-y-auto min-w-0 lg:pr-1">
      <div class="flex flex-wrap gap-2 mb-4">
        <%= link_to places_path(place_list_params), class: 'btn btn-ghost btn-sm', data: { testid: 'back-to-places' } do %>
          <%= icon 'arrow-left', class: 'w-4 h-4' %> <%= t('places.polish.back_to_places') %>
        <% end %>
        <%= link_to t('ux_p2.places.edit'), edit_place_path(@place, place_list_params), class: 'btn btn-primary btn-sm' %>
      </div>
      <p class="text-sm text-base-content/70 mb-4"><%= @place.lat.round(6) %>, <%= @place.lon.round(6) %> · <%= t('ux_p2.places.radius') %>: <%= @place.visit_radius %> m</p>
      <%= turbo_frame_tag 'place-drawer' do %>
        <%= render 'drawer', place: @place, recent_visits: @recent_visits %>
      <% end %>
    </div>
  </div>
</div>
