<% content_for :title, t('.places') %>

<div class="w-full min-w-0 my-5" data-testid="places-management">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <div role="tablist" class="tabs tabs-lifted min-w-0">
      <%= link_to t('.timeline'), '/map/v2?panel=timeline&date=today&status=confirmed', role: 'tab', class: 'tab font-bold' %>
      <%= link_to t('.places'), places_path, role: 'tab', class: 'tab font-bold tab-active' %>
    </div>
    <div class="flex flex-wrap gap-2 min-w-0">
      <%= link_to t('places.management.duplicates'), places_path(view: 'duplicates'), class: 'btn btn-sm h-auto py-2', data: { testid: 'possible-duplicates' } %>
      <%= link_to t('places.management.create'), '/map/v2?create_place=1', class: 'btn btn-primary btn-sm h-auto py-2', data: { testid: 'create-place' } %>
    </div>
  </div>

  <% if @clusters %>
    <%= render 'duplicates', clusters: @clusters %>
  <% else %>
    <%= render 'filters' %>
    <div data-controller="<%= 'places-selection' if @places.any? %>" data-places-selection-delete-message-value="<%= t('places.management.delete_confirmation', places: '%{places}', visits: '%{visits}', geofences: '%{geofences}', privacy: '%{privacy}') %>">
      <%= render 'bulk_actions' if @places.any? %>
      <div id="places" class="min-w-0">
        <% if @places.empty? %>
          <p class="p-8 text-center bg-base-200 rounded-box"><%= t('places.management.no_results') %></p>
        <% else %>
          <div class="flex justify-center my-5"><%= paginate @places %></div>
          <%= render 'table' %>
          <div class="flex justify-center my-5"><%= paginate @places %></div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
