<section class="card bg-base-200 mt-6 max-w-2xl" aria-labelledby="source-file-heading">
  <div class="card-body">
    <h3 id="source-file-heading" class="text-lg font-semibold"><%= t('imports.source_file.title') %></h3>
    <% if import.file.attached? %>
      <p class="text-sm text-base-content/70"><%= t('imports.source_file.explanation') %></p>
      <div class="flex flex-wrap gap-2 mt-2">
        <%= link_to t('imports.table_row.download_file'), download_import_path(import), class: 'btn btn-sm btn-outline', data: { turbo: false } %>
        <% if import.source_file_removable? %>
          <%= button_to t('imports.source_file.delete'), source_file_import_path(import), method: :delete,
                        class: 'btn btn-sm btn-outline btn-error',
                        form: { data: { turbo_confirm: t('imports.source_file.confirmation') } } %>
        <% else %>
          <button class="btn btn-sm btn-outline" disabled><%= t('imports.source_file.delete') %></button>
        <% end %>
      </div>
      <% unless import.source_file_removable? %>
        <p class="text-sm text-base-content/70 mt-2"><%= t('imports.source_file.unavailable') %></p>
      <% end %>
    <% else %>
      <p class="text-sm text-base-content/70"><%= t('imports.source_file.missing') %></p>
    <% end %>
  </div>
</section>
