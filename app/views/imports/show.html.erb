<% content_for :title, t('.import') %>

<div class="mx-auto md:w-2/3 w-full flex">
  <div class="mx-auto">
    <% if notice.present? %>
      <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
    <% end %>

    <%= render @import %>

    <%= turbo_stream_from "import_#{@import.id}_extraction" %>
    <% if @import.failed? %>
      <section class="alert alert-error my-4 block" data-testid="import-failure">
        <h2 class="font-bold"><%= t('ux_p2.import.failed') %></h2>
        <p class="my-2"><%= @import.failure_summary %></p>
        <p class="text-sm mb-3"><%= t('ux_p2.import.reference', id: @import.id) %></p>
        <%= link_to t('ux_p2.import.upload_another'), new_import_path, class: 'btn btn-primary btn-sm' %>
        <%= link_to t('ux_p2.import.supported_formats'), new_import_path(anchor: 'supported-formats'), class: 'btn btn-outline btn-sm' %>
      </section>
    <% else %>
      <%= render 'imports/extraction_card', import: @import %>
    <% end %>

    <%= link_to t('.edit_this_import'), edit_import_path(@import), class: "btn mt-2" %>
    <div class="inline-block ml-2">
      <%= link_to t('.destroy_this_import'), import_path(@import), data: { turbo_confirm: t('.are_you_sure_this_action_will_delete_all_points_imported'), turbo_method: :delete }, class: "btn btn-outline btn-error mt-2" %>
    </div>
    <%= link_to t('.back_to_imports'), imports_path, class: "btn mt-2 ml-2" %>
  </div>
</div>
