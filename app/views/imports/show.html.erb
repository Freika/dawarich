<% content_for :title, t('.import') %>

<div class="mx-auto md:w-2/3 w-full flex">
  <div class="mx-auto min-w-0 w-full">
    <%= render @import %>
    <%= render 'imports/source_file', import: @import %>

    <%= turbo_stream_from "import_#{@import.id}_extraction" %>
    <%= render 'imports/extraction_card', import: @import %>

    <%= link_to t('.edit_this_import'), edit_import_path(@import), class: "btn mt-2" %>
    <div class="inline-block ml-2">
      <%= link_to t('.destroy_this_import'), import_path(@import), data: { turbo_confirm: t('imports.source_file.delete_import_confirmation'), turbo_method: :delete }, class: "btn btn-outline btn-error mt-2" %>
    </div>
    <%= link_to t('.back_to_imports'), imports_path, class: "btn mt-2 ml-2" %>
  </div>
</div>
