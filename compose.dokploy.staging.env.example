# Copy these names to the Dokploy Compose service's Environment tab.
# Fill values from the existing staging deployment or newly restored services.
# Never commit a populated copy.
DAWARICH_IMAGE=
WEB_REPLICAS=0
WORKER_REPLICAS=0
STAGING_HOST=staging.dawarich.app
# Add the temporary preview hostname here before testing the preview domain.
APPLICATION_HOSTS=staging.dawarich.app
MANAGER_URL=

# config/database.yml reads these discrete values, not DATABASE_URL.
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
REDIS_URL=

RAILS_MASTER_KEY=
SECRET_KEY_BASE=
AUTH_JWT_SECRET_KEY=
JWT_SECRET_KEY=
SUBSCRIPTION_WEBHOOK_SECRET=

# Cloudflare R2 is the staging Active Storage backend.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT_URL=

# Also copy the remaining staging Dokku settings: OTP keys, SMTP, OAuth,
# Photon, metrics, and feature flags.
