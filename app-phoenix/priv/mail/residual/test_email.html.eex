<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
  </style>
</head>
<body>
  <div class="container">
    <p><%= @t.("body") %></p>

    <p><%= @t.("sent_at") %>: <%= @h.(@sent_at) %></p>
  </div>
</body>
</html>
