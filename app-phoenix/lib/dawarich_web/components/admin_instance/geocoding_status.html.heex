<div
  class="flex flex-col gap-4 rounded-box border border-base-content/10 bg-base-200 p-5 sm:flex-row sm:items-center sm:justify-between"
  data-testid="instance-settings-geocoding-status"
>
  <div class="min-w-0">
    <p class="text-[10px] font-bold uppercase tracking-[0.05em] text-base-content/70">
      {t(
        @locale,
        if(@data.geocoding.enabled,
          do: "admin.settings.show.geocoding.in_use",
          else: "admin.settings.show.geocoding.off"
        ),
        %{}
      )}
    </p>
    <%= if @data.geocoding.enabled do %>
      <p class="mt-1 font-medium [overflow-wrap:anywhere]">
        {section_title(@locale, to_string(@data.geocoding.provider))}
        <span
          :if={Map.get(@data.geocoding, :host) not in [nil, ""]}
          class="font-normal text-base-content/70"
        >· {@data.geocoding.host}</span>
      </p>
      <p class="mt-1 flex items-center gap-1.5 text-sm text-base-content/70">
        <%= if variable = pinned_var(@data) do %>
          <.icon name="lock" class="size-3.5 shrink-0" />
          <span class="min-w-0 [overflow-wrap:anywhere]">{t(
            @locale,
            "admin.settings.show.pinned_hint",
            %{variable: variable}
          )}</span>
        <% else %>
          <span>{t(@locale, "admin.settings.show.geocoding.stored", %{})}</span>
        <% end %>
      </p>
    <% else %>
      <p class="mt-1 text-sm text-base-content/70 [text-wrap:pretty]">
        {t(@locale, "admin.settings.show.geocoding.none", %{})}
      </p>
      <div
        :if={@data.legacy}
        role="note"
        class="mt-2 flex items-start gap-2 text-sm"
        data-testid="instance-settings-legacy-user-geocoding"
      >
        <.icon name="triangle-alert" class="size-4 shrink-0 mt-0.5 text-warning" />
        <p class="min-w-0 [text-wrap:pretty]">
          {t(@locale, "admin.settings.show.geocoding.legacy_user_settings", %{})}
        </p>
      </div>
    <% end %>
  </div>
  <div :if={@data.geocoding.enabled} class="shrink-0 sm:text-right">
    <form class="inline-block" method="post" action="/admin/settings/test_geocoding">
      <button
        class="btn btn-sm btn-outline"
        data-turbo-submits-with={t(@locale, "admin.settings.show.geocoding.testing", %{})}
        type="submit"
      >{t(@locale, "admin.settings.show.geocoding.test", %{})}</button><input
        type="hidden"
        name="authenticity_token"
        value={@rails_csrf_token}
      />
    </form>
    <p class="mt-1.5 text-xs text-base-content/70">
      {t(@locale, "admin.settings.show.geocoding.test_hint", %{})}
    </p>
  </div>
</div>
