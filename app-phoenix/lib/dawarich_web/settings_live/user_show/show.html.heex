<div class="min-h-content w-full my-5">
  <h1 class="text-3xl font-bold mb-6">{label(@locale, "user_details")}</h1>
  <SettingsParts.navigation
    locale={@locale}
    active="users"
    self_hosted={@self_hosted}
    admin={@current_user.admin == true}
    two_factor={@two_factor}
  />
  <div class="flex flex-col w-full my-10">
    <div class="w-10/12 mx-auto space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-2xl font-bold">{@target.email}</h2>
          <div class="flex gap-2 mt-2">
            <span class={if(@target.admin, do: "badge badge-primary", else: "badge badge-ghost")}>{label(
              @locale,
              if(@target.admin, do: "admin", else: "user")
            )}</span>
            <span
              :if={@target.status in 0..2}
              class={"badge badge-" <> elem(status(@target.status), 1)}
            >{label(@locale, elem(status(@target.status), 0))}</span>
          </div>
        </div>
        <div class="flex gap-2">
          <a class="btn btn-primary btn-sm" href={"/settings/users/#{@target.id}/edit"}>{label(
            @locale,
            "edit"
          )}</a>
          <a class="btn btn-ghost btn-sm" href="/settings/users">{label(@locale, "back_to_users")}</a>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card bg-base-200">
          <div class="card-body">
            <h3 class="card-title">{label(@locale, "data_overview")}</h3>
            <div class="overflow-x-auto">
              <table class="table">
                <tbody>
                  <tr :for={key <- ~w(points tracks imports exports areas)}>
                    <td class="font-semibold">{label(@locale, key)}</td>
                    <td>
                      {NumberFormat.delimited(
                        @locale,
                        if(key == "points",
                          do: @target.points_count || 0,
                          else: @target.counts[key]
                        )
                      )}
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="card bg-base-200">
          <div class="card-body">
            <h3 class="card-title">{label(@locale, "sign_in_history")}</h3>
            <div class="overflow-x-auto">
              <table class="table">
                <tbody>
                  <tr>
                    <td class="font-semibold">{label(@locale, "total_sign_ins")}</td><td>
                      {@target.sign_in_count}
                    </td>
                  </tr>
                  <tr>
                    <td class="font-semibold">{label(@locale, "last_sign_in")}</td><td>
                      <%= if @target.last_sign_in_at do %>
                        <.human_datetime locale={@locale} at={@target.last_sign_in_at} />
                      <% else %>
                        <span class="text-base-content/50">{label(@locale, "never")}</span>
                      <% end %>
                    </td>
                  </tr>
                  <tr>
                    <td class="font-semibold">{label(@locale, "last_sign_in_ip")}</td><td>
                      {@target.last_sign_in_ip || "—"}
                    </td>
                  </tr>
                  <tr>
                    <td class="font-semibold">{label(@locale, "current_sign_in_ip")}</td><td>
                      {@target.current_sign_in_ip || "—"}
                    </td>
                  </tr>
                  <tr>
                    <td class="font-semibold">{label(@locale, "account_created")}</td><td>
                      <.human_datetime locale={@locale} at={@target.created_at} />
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="card bg-base-200">
          <div class="card-body">
            <h3 class="card-title">{label(@locale, "api_key")}</h3>
            <div
              id="admin-user-clipboard"
              phx-hook="RailsStimulus"
              class="flex items-center gap-2"
            >
              <code class="bg-base-300 px-3 py-2 rounded-lg text-sm flex-1 break-all">{String.slice(
                @target.api_key,
                0,
                8
              )}{String.duplicate("•", 24)}</code>
              <button
                class="btn btn-ghost btn-sm"
                data-controller="clipboard"
                data-clipboard-text-value={@target.api_key}
                data-action="click->clipboard#copy"
              >
                <.icon name="copy" class="inline-block w-4" /> {label(@locale, "copy")}
              </button>
            </div>
            <div class="card-actions mt-4">
              <form
                class="button_to"
                method="post"
                action={"/settings/users/#{@target.id}/regenerate_api_key"}
              >
                <button
                  class="btn btn-warning btn-sm"
                  data-turbo-confirm={
                    label(@locale, "are_you_sure_this_will_invalidate_the_current_api_key")
                  }
                  type="submit"
                >{label(@locale, "regenerate_api_key")}</button><input
                  type="hidden"
                  name="authenticity_token"
                  value={@rails_csrf_token}
                />
              </form>
            </div>
          </div>
        </div>
        <div class="card bg-base-200">
          <div class="card-body">
            <h3 class="card-title">{label(@locale, "actions")}</h3>
            <div class="flex flex-col gap-3">
              <form
                class="button_to"
                method="post"
                action={"/settings/users/#{@target.id}/send_password_reset"}
              >
                <button class="btn btn-outline btn-sm" type="submit">{label(
                  @locale,
                  "send_password_reset_email"
                )}</button><input
                  type="hidden"
                  name="authenticity_token"
                  value={@rails_csrf_token}
                />
              </form>
              <a class="btn btn-primary btn-sm" href={"/settings/users/#{@target.id}/edit"}>{label(
                @locale,
                "edit_user"
              )}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
