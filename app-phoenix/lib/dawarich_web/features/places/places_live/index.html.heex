<div
  id="native-places"
  phx-hook="PlaceDraft"
  data-native-user-id={@current_user.id}
  class="w-full my-5"
  data-native-places="1"
>
  <div class="overflow-x-auto pb-1">
    <div role="tablist" class="tabs tabs-lifted tabs-lg inline-flex min-w-max flex-nowrap">
      <a
        role="tab"
        class="tab font-bold text-xl"
        href="/map/v2?panel=timeline&date=today&status=confirmed"
      >{t(@locale, "places.index.timeline", %{})}</a>
      <a role="tab" class="tab font-bold text-xl tab-active" href="/places">{t(
        @locale,
        "places.index.places",
        %{}
      )}</a>
    </div>
  </div>
  <PlaceForm.form
    :if={@form_state}
    state={@form_state}
    data={@place_data}
    locale={@locale}
    nearby={@nearby_state}
  />
  <PlaceDetail.panel
    :if={@detail && @note_state}
    detail={@detail}
    state={@note_state}
    locale={@locale}
  />
  <p :if={@error} role="alert" class="text-error [overflow-wrap:anywhere]">{@error}</p>
  <div id="places" class="min-w-full">
    <%= if @entries == [] do %>
      <div class="hero min-h-80 bg-base-200">
        <div class="hero-content text-center">
          <div class="max-w-md">
            <h1 class="text-5xl font-bold">{t(@locale, "places.index.hello_there", %{})}</h1>
            <p class="py-6">
              {t(
                @locale,
                "places.index.here_you_ll_find_your_places_created_by_visits_suggestion",
                %{}
              )}
            </p>
          </div>
        </div>
      </div>
    <% else %>
      <div class="flex justify-center my-5">
        <.paginator
          locale={@locale}
          path="/places"
          query={@query}
          page={@page}
          total_pages={@total_pages}
        />
      </div>
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr>
              <th>{t(@locale, "places.index.name", %{})}</th><th>
                {t(@locale, "places.index.created_at", %{})}
              </th><th>{t(@locale, "places.index.coordinates", %{})}</th><th>
                {t(@locale, "places.index.actions", %{})}
              </th>
            </tr>
          </thead>
          <tbody>
            <tr :for={place <- @entries}>
              <td>{place.name}</td>
              <td><.human_datetime locale={@locale} at={place.created} /></td>
              <td>{coordinates(place)}</td>
              <td>
                <a
                  href="#"
                  data-native-href={"/places/#{place.id}" <> if(@query["page"], do: "?" <> URI.encode_query(%{"page" => @query["page"]}), else: "")}
                  class="btn btn-ghost btn-xs text-error hover:bg-error/10"
                  phx-click="request_delete"
                  phx-value-id={place.id}
                >{t(@locale, "places.index.delete", %{})}</a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
  <OrdinaryFormComponents.dialog
    :if={@confirmation}
    id={@confirmation.id}
    title={t(@locale, "places.index.delete", %{})}
    cancel_event="cancel_form"
    close_label={t(@locale, "settings.users.index.cancel", %{})}
  >
    <p class="py-4">
      {t(@locale, "places.index.are_you_sure_deleting_a_place_will_result_in_deleting", %{})}
    </p>
    <button
      type="button"
      class="btn btn-error"
      phx-click="confirm_delete"
      phx-value-generation={@confirmation.generation}
      disabled={@confirmation.status != :idle}
      phx-disable-with={t(@locale, "places.index.delete", %{})}
    >{t(@locale, "places.index.delete", %{})}</button>
  </OrdinaryFormComponents.dialog>
</div>
