<div class="container mx-auto px-4 py-8 max-w-2xl">
  <div class="mb-6">
    <h1 class="text-3xl font-bold">{@tag_title}</h1>
    <p class="text-gray-600 mt-2">
      {t(
        @locale,
        "tags.#{@kind}." <>
          if(@kind == "new",
            do: "create_a_new_tag_to_organize_your_places",
            else: "update_your_tag_details"
          ),
        %{}
      )}
    </p>
  </div>
  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <form
        id="native-tag-form"
        class="space-y-4"
        action={if @tag.id, do: "/tags/#{@tag.id}", else: "/tags"}
        accept-charset="UTF-8"
        method="post"
        phx-change="validate"
        phx-submit="save"
      >
        <input :if={@tag.id} type="hidden" name="_method" value="patch" />
        <input type="hidden" name="authenticity_token" value={@rails_csrf_token} />
        <div :if={@errors != []} class="alert alert-error" role="alert">
          <div>
            <h3 class="font-bold">
              {t(@locale, "tags.form.errors_prohibited_save", %{count: length(@errors)})}
            </h3>
            <ul class="list-disc list-inside">
              <li :for={message <- @errors}>{message}</li>
            </ul>
          </div>
        </div>
        <div class="form-control">
          <label class="label" for="tag_name">Name</label>
          <input
            class="input input-bordered w-full"
            placeholder={t(@locale, "tags.form.home_work_restaurant", %{})}
            type="text"
            value={@form[:name].value}
            name="tag[name]"
            id="tag_name"
            phx-debounce="300"
          />
          <.error :for={{message, _} <- shown_errors(@form[:name])}>{message}</.error>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="form-control" id="native-tag-icon-picker" phx-hook="EmojiPicker">
            <label class="label" for="tag_icon">Icon</label>
            <div class="relative w-full">
              <button
                type="button"
                class="input input-bordered w-full flex items-center justify-center text-4xl cursor-pointer hover:bg-base-200 min-h-[4rem]"
                data-native-emoji
                data-default-icon={@icon}
                aria-label={t(@locale, "tags.form.click_to_select_an_emoji", %{})}
              >
                <span data-emoji-picker-display>{@icon}</span>
              </button>
              <div
                id="native-tag-icon-picker-panel"
                phx-update="ignore"
                data-native-picker
                hidden
                class="absolute z-50 mt-2 left-0"
              >
              </div>
              <input type="hidden" name="tag[icon]" id="tag_icon" value={@icon} />
            </div>
            <.error :for={{message, _} <- shown_errors(@form[:icon])}>{message}</.error>
            <label class="label"><span class="label-text-alt">{t(
              @locale,
              "tags.form.click_to_select_an_emoji",
              %{}
            )}</span></label>
          </div>
          <div class="form-control">
            <label class="label" for="tag_color">Color</label>
            <div class="flex flex-col gap-3">
              <div class="grid grid-cols-6 gap-2">
                <button
                  :for={color <- @colors}
                  type="button"
                  class="w-10 h-10 rounded-lg cursor-pointer transition-all hover:scale-110 border-2 border-base-300"
                  style={"background-color: #{color};"}
                  data-color={color}
                  title={color}
                  aria-label={color}
                  phx-click={
                    Phoenix.LiveView.JS.set_attribute({"value", color}, to: "#tag_color")
                    |> Phoenix.LiveView.JS.dispatch("input", to: "#tag_color")
                  }
                ></button>
              </div>
              <div class="flex flex-wrap items-center gap-3">
                <label class="flex items-center gap-2 cursor-pointer group min-w-0">
                  <span class="text-sm font-medium">{t(@locale, "tags.form.custom", %{})}</span>
                  <input
                    type="color"
                    name="tag[custom_color]"
                    class="w-12 h-12 rounded-lg cursor-pointer border-2 border-base-300 hover:scale-105 transition-transform color-input"
                    value={@color}
                  />
                </label>
                <div class="flex-1 min-w-0 flex items-center gap-2">
                  <div
                    class="w-8 h-8 rounded border-2 border-base-300"
                    style={"background-color: #{@color};"}
                  >
                  </div>
                  <span class="text-sm text-base-content/60">{@color}</span>
                </div>
              </div>
            </div>
            <input type="hidden" name="tag[color]" id="tag_color" value={@color} />
            <.error :for={{message, _} <- shown_errors(@form[:color])}>{message}</.error>
            <label class="label"><span class="label-text-alt">{t(
              @locale,
              "tags.form.choose_from_swatches_or_pick_a_custom_color",
              %{}
            )}</span></label>
          </div>
        </div>
        <div>
          <div class="form-control">
            <input type="hidden" name="tag[privacy_enabled]" value="false" />
            <label class="label cursor-pointer">
              <span class="label-text font-semibold"><.icon
                name="lock-open"
                class="inline-block w-4"
              /> {t(@locale, "tags.form.privacy_zone", %{})}</span>
              <input
                type="checkbox"
                name="tag[privacy_enabled]"
                value="true"
                checked={@privacy}
                class="toggle toggle-error"
              />
            </label>
            <label class="label"><span class="label-text-alt">{t(
              @locale,
              "tags.form.hide_map_data_around_places_with_this_tag",
              %{}
            )}</span></label>
          </div>
          <div class={"form-control " <> if(@privacy, do: "", else: "hidden")}>
            <label class="label" for="native-tag-radius">{t(
              @locale,
              "tags.form.privacy_radius",
              %{}
            )}</label>
            <div class="flex flex-col gap-2">
              <input
                id="native-tag-radius"
                type="range"
                min="50"
                max="5000"
                step="50"
                value={@radius}
                class="range range-error"
                name="tag[slider_radius]"
                phx-throttle="150"
              />
              <div class="flex justify-between text-xs px-2">
                <span>{t(@locale, "units.meters_compact", %{value: 50})}</span>
                <span class="font-semibold">{@radius}m</span>
                <span>{t(@locale, "units.meters_compact", %{value: 5000})}</span>
              </div>
              <input
                type="hidden"
                name="tag[privacy_radius_meters]"
                id="tag_privacy_radius_meters"
                value={if @privacy, do: @radius}
              />
            </div>
            <.error :for={{message, _} <- shown_errors(@form[:privacy_radius_meters])}>
              {message}
            </.error>
            <label class="label"><span class="label-text-alt">{t(
              @locale,
              "tags.form.data_within_this_radius_will_be_hidden_from_the_map",
              %{}
            )}</span></label>
          </div>
        </div>
        <div class="form-control mt-6">
          <div class="flex gap-2">
            <input
              type="submit"
              name="commit"
              value={
                t(@locale, "helpers.submit.#{if @tag.id, do: "update", else: "create"}", %{
                  model: "Tag"
                })
              }
              class="btn btn-primary"
              phx-disable-with={
                t(@locale, "helpers.submit.#{if @tag.id, do: "update", else: "create"}", %{
                  model: "Tag"
                })
              }
            />
            <.link navigate={~p"/tags"} class="btn btn-ghost">{t(@locale, "tags.form.cancel", %{})}</.link>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
