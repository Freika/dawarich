<div class="hero min-h-content bg-base-200">
  <div class="hero-content flex-col lg:flex-row-reverse w-full my-10">
    <div class="text-center lg:text-left min-w-0 [overflow-wrap:anywhere]">
      <h1 class="text-4xl sm:text-5xl font-bold text-base-content">
        {t(@locale, "devise.sessions.new.login_now", %{})}
      </h1>
      <p class="py-6 text-base-content opacity-70">
        {t(@locale, "devise.sessions.new.and_take_control_over_your_location_data", %{})}
      </p>
      <ul class="space-y-3 mb-4">
        <li :for={benefit <- ~w(import map stats privacy)}>
          <strong>{t(@locale, "devise.sessions.new.benefits." <> benefit <> ".title", %{})}</strong>
          <p>{t(@locale, "devise.sessions.new.benefits." <> benefit <> ".body", %{})}</p>
        </li>
      </ul>
    </div>
    <div class="card flex-shrink-0 w-full max-w-sm min-w-0 shadow-2xl bg-base-100 px-5 py-5">
      <form
        :if={@email_password}
        class="new_user"
        id="new_user"
        data-auth-form
        action="/users/sign_in"
        accept-charset="UTF-8"
        method="post"
      >
        <input type="hidden" name="authenticity_token" value={@token} />
        <div class="form-control">
          <label class="label" for="user_email"><span class="label-text">{t(
            @locale,
            "devise.sessions.new.email",
            %{}
          )}</span></label><input
            autofocus="autofocus"
            autocomplete="email"
            class="input input-bordered min-w-0 w-full"
            type="email"
            value={@email}
            name="user[email]"
            id="user_email"
          />
        </div>
        <div class="form-control">
          <label class="label" for="user_password"><span class="label-text">{t(
            @locale,
            "devise.sessions.new.password",
            %{}
          )}</span></label><input
            autocomplete="current-password"
            class="input input-bordered min-w-0 w-full"
            type="password"
            name="user[password]"
            id="user_password"
          />
          <div class="form-control">
            <label for="user_remember_me" class="label cursor-pointer"><span class="label-text">{t(
              @locale,
              "devise.sessions.new.remember_me",
              %{}
            )}</span><input name="user[remember_me]" type="hidden" value="0" /><input
              class="checkbox checkbox-sm"
              type="checkbox"
              value="1"
              name="user[remember_me]"
              id="user_remember_me"
            /></label>
          </div>
        </div>
        <div class="form-control mt-6">
          <input
            type="submit"
            name="commit"
            value={t(@locale, "devise.sessions.new.log_in", %{})}
            class="btn btn-primary"
          />
        </div>
      </form>
      <div :if={@email_password} class="mt-5 space-y-2 text-sm">
        <div :if={@registration_enabled}>
          <a class="link link-hover text-base-content/70" href="/users/sign_up">{t(
            @locale,
            "devise.shared.links.register",
            %{}
          )}</a>
        </div>
        <div>
          <a class="link link-hover text-base-content/70" href="/users/password/new">{t(
            @locale,
            "devise.shared.links.forgot_your_password",
            %{}
          )}</a>
        </div>

        <div>
          <a class="link link-hover text-base-content/70" href="/users/unlock/new">{t(
            @locale,
            "devise.shared.links.didn_t_receive_unlock_instructions",
            %{}
          )}</a>
        </div>
      </div>
      <p :if={!@email_password} class="text-center mb-4">
        {t(
          @locale,
          "devise.sessions.new.sign_in_using_your_organization_s_identity_provider",
          %{}
        )}
      </p>
      <form
        :for={provider <- @providers}
        action={provider.action}
        method={String.downcase(provider.method)}
        data-auth-form
        class="mt-2"
      >
        <input
          :if={provider.method == "POST"}
          type="hidden"
          name="authenticity_token"
          value={provider.csrf}
        />
        <button type="submit" class="btn btn-primary w-full h-auto min-h-12 whitespace-normal">{provider.label}</button>
      </form>
    </div>
  </div>
</div>
