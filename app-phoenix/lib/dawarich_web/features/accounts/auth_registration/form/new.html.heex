<div class="hero bg-base-200">
  <div class="hero-content grid w-full my-10 gap-y-8 lg:grid-cols-[minmax(0,28rem)_24rem] lg:justify-center lg:gap-x-20">
    <div class="text-center lg:text-left lg:self-end">
      <h1 class="text-4xl font-bold text-base-content">{text(@locale, "almost_there")}</h1>
      <p class="pt-6 text-base-content/70">
        {text(@locale, "only_a_few_steps_left_until_you_get_control_over")}
      </p>

    </div>
    <div class="card flex-shrink-0 w-full max-w-sm mx-auto border border-base-content/10 bg-base-100 px-5 py-5 lg:col-start-2 lg:row-span-2 lg:self-center">
      <form
        class="new_user"
        id="new_user"
        action="/users"
        method="post"
        accept-charset="UTF-8"
        data-auth-form
      >
        <input type="hidden" name="authenticity_token" value={@token} />
        <input
          :if={@invitation}
          type="hidden"
          name="user[invitation_token]"
          value={@invitation.token}
        />
        <div
          :if={@messages != []}
          id="error_explanation"
          class="alert alert-error mb-4"
          data-auth-error-summary
          tabindex="-1"
          role="alert"
        >
          <ul>
            <li :for={message <- @messages}>{message}</li>
          </ul>
        </div>
        <div class="form-control">
          <label class="label" for="user_email"><span class="label-text">{text(@locale, "email")}</span></label>
          <input
            type="email"
            id="user_email"
            name="user[email]"
            value={@email}
            autocomplete="email"
            autofocus="autofocus"
            readonly={@invitation != nil}
            class="input input-bordered w-full"
          />
        </div>
        <div class="form-control">
          <label class="label" for="user_password"><span class="label-text">{text(
            @locale,
            "password"
          )}</span></label>
          <input
            type="password"
            id="user_password"
            name="user[password]"
            autocomplete="new-password"
            aria-describedby="password-hint"
            class="input input-bordered w-full"
          />
          <span id="password-hint" class="label-text-alt text-base-content/60 mt-1">{DawarichWeb.Translate.t(
            @locale,
            "devise.registrations.new.characters_minimum",
            %{"count" => 12}
          )}</span>
        </div>
        <div class="form-control">
          <label class="label" for="user_password_confirmation"><span class="label-text">{text(
            @locale,
            "password_confirmation"
          )}</span></label>
          <input
            type="password"
            id="user_password_confirmation"
            name="user[password_confirmation]"
            autocomplete="new-password"
            class="input input-bordered w-full"
          />
        </div>
        <div class="form-control mt-6">
          <input
            type="submit"
            name="commit"
            value={text(@locale, "sign_up")}
            class="btn btn-primary"
          />
        </div>
      </form>
      <div class="mt-5 space-y-2 text-sm">
        <div><a class="link link-hover text-base-content/70" href="/users/sign_in">{DawarichWeb.Translate.t(
          @locale,
          "devise.shared.links.log_in",
          %{}
        )}</a></div>
      </div>
    </div>
    <DawarichWeb.AuthFeatures.list locale={@locale} kind="sign_up" />
  </div>
</div>
