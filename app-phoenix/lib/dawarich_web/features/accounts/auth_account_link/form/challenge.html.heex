<div class="min-h-content w-full my-5">
  <div class="max-w-lg mx-auto">
    <div class="card bg-base-200 shadow-xl">
      <div class="card-body min-w-0 [overflow-wrap:anywhere]">
        <h2 class="card-title flex-wrap">
          {text(@locale, "link_provider_to_your_dawarich_account", %{
            "provider" => @provider_label
          })}
        </h2>
        <p class="text-sm text-base-content/70 mt-2">
          {instructions(@locale, @user_email, @provider_label)}
        </p>
        <div :if={!Dawarich.Auth.Recovery.Token.blank?(@flash["alert"])} class="alert alert-error mt-4">
          {@flash["alert"]}
        </div>
        <form
          class="space-y-4 mt-4"
          data-auth-form
          action="/auth/account_link/challenge"
          accept-charset="UTF-8"
          method="post"
        >
          <input type="hidden" name="authenticity_token" value={@confirm_csrf_token} />
          <div class="form-control">
            <label class="label" for="password"><span class="label-text">{text(
              @locale,
              "current_password"
            )}</span></label>
            <input
              class="input input-bordered w-full min-w-0"
              required="required"
              autocomplete="current-password"
              autofocus="autofocus"
              type="password"
              name="password"
              id="password"
            />
          </div>
          <div class="form-control">
            <input
              type="submit"
              name="commit"
              value={text(@locale, "link_provider_and_sign_in", %{"provider" => @provider_label})}
              class="btn btn-primary w-full h-auto min-h-12 whitespace-normal"
            />
          </div>
        </form>
        <div class="divider">{text(@locale, "or")}</div>
        <form
          data-auth-form
          action="/auth/account_link/email"
          accept-charset="UTF-8"
          method="post"
        >
          <input type="hidden" name="authenticity_token" value={@email_csrf_token} />
          <input
            type="submit"
            name="commit"
            value={text(@locale, "email_me_a_confirmation_link_instead")}
            class="btn btn-ghost w-full h-auto min-h-12 whitespace-normal"
          />
        </form>
        <p class="text-xs text-base-content/50 mt-4">
          {text(@locale, "forgot_your_password")}
          <a class="link" href="/users/password/new">{text(@locale, "reset_it")}</a>
          {text(@locale, "or")}
          <a class="link" href="/users/sign_in">{text(@locale, "go_back_to_sign_in")}</a>.
        </p>
      </div>
    </div>
  </div>
</div>
