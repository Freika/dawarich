<div class="min-h-content w-full my-5">
  <.page_header title={label(@locale, "background_jobs")} />
  <SettingsParts.navigation
    locale={@locale}
    active="background_jobs"
    self_hosted={@self_hosted}
    admin={@current_user.admin == true}
    two_factor={@two_factor}
    native
  />
  <div role="alert" class="alert w-auto m-5">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      class="stroke-info h-6 w-6 shrink-0"
    ><path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
    >
    </path></svg>
    <span>{label(@locale, "spamming_many_new_jobs_at_once_is_a_bad_idea")}</span>
  </div>
  <div
    :if={@data.notice}
    role="alert"
    class="alert alert-info w-auto m-5"
    data-testid="gps-noise-recheck-pending"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      class="stroke-current h-6 w-6 shrink-0"
    ><path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
    >
    </path></svg>
    <span>{label(@locale, "gps_noise_detection_changed_in_this_release_so_your_existing")}</span>
  </div>
  <div class="flex flex-wrap">
    <div
      :for={
        {job, hint} <- [
          {"start_reverse_geocoding", "this_job_will_re_run_reverse_geocoding_process_for_all"},
          {"continue_reverse_geocoding",
           "this_job_will_process_reverse_geocoding_for_all_points_that"}
        ]
      }
      class="card bg-base-300 w-full sm:w-96 shadow-xl m-5"
    >
      <div class="card-body">
        <h2 class="card-title">{label(@locale, job)}</h2><p>{label(@locale, hint)}</p>
        <div class="card-actions justify-end">
          <button
            id={"open-#{job}"}
            type="button"
            class="btn btn-primary"
            phx-click={
              JS.push("open_job", value: %{name: job})
              |> JS.dispatch("dawarich:open-dialog", to: "#background-job-confirm")
            }
            disabled={MapSet.member?(@accepted_jobs, job)}
          >{label(@locale, "start_job")}</button>
        </div>
      </div>
    </div>
    <div :if={@current_user.admin == true} class="card bg-base-300 w-full sm:w-96 shadow-xl m-5">
      <div class="card-body">
        <h2 class="card-title">{label(@locale, "background_jobs_dashboard")}</h2>
        <p>{label(@locale, "this_will_open_the_background_jobs_dashboard_in_a_new")}</p>
        <div class="card-actions justify-end">
          <a target="_blank" class="btn btn-primary" href="/sidekiq">{label(
            @locale,
            "open_dashboard"
          )}</a>
        </div>
      </div>
    </div>
    <div class="card bg-base-300 w-full sm:w-96 shadow-xl m-5">
      <div class="card-body">
        <h2 class="card-title">{label(@locale, "visits_suggestions")}</h2>
        <p>{label(@locale, "enable_or_disable_visits_suggestions_it_s_a_background_task")}</p>
        <div class="card-actions justify-end">
          <button
            id="visits-toggle"
            type="button"
            phx-click={
              JS.push("open_visits")
              |> JS.dispatch("dawarich:open-dialog", to: "#background-visits-confirm")
            }
            phx-disable-with={label(@locale, if(@data.visits, do: "disable", else: "enable"))}
            class={if(@data.visits, do: "btn btn-error", else: "btn btn-success")}
          >{label(@locale, if(@data.visits, do: "disable", else: "enable"))}</button>
        </div>
      </div>
    </div>
  </div>
  <dialog
    id="background-job-confirm"
    class="modal"
    open={@dialog_open}
    phx-mounted={JS.ignore_attributes("open")}
  >
    <div class="modal-box">
      <h3 :if={@pending_job} class="text-lg font-bold">{label(@locale, @pending_job)}</h3>
      <p>{label(@locale, "are_you_sure")}</p>
      <div class="modal-action flex-wrap">
        <button
          id="cancel-background-job"
          type="button"
          class="btn"
          phx-click={
            JS.push("cancel_job")
            |> JS.dispatch("dawarich:close-dialog", to: "#background-job-confirm")
          }
        >{t(@locale, "settings.users.index.cancel", %{})}</button>
        <button
          id="confirm-background-job"
          type="button"
          class="btn btn-primary"
          phx-click="request_job"
          phx-disable-with={label(@locale, "start_job")}
          disabled={is_nil(@pending_job)}
        >{label(@locale, "start_job")}</button>
      </div>
    </div>
  </dialog>
  <dialog
    id="background-visits-confirm"
    class="modal"
    open={@dialog_open}
    phx-mounted={JS.ignore_attributes("open")}
  >
    <div class="modal-box">
      <h3 class="text-lg font-bold">{label(@locale, "visits_suggestions")}</h3>
      <p>{label(@locale, "are_you_sure")}</p>
      <div class="modal-action flex-wrap">
        <button
          id="cancel-visits"
          type="button"
          class="btn"
          phx-click={
            JS.push("cancel_visits")
            |> JS.dispatch("dawarich:close-dialog", to: "#background-visits-confirm")
          }
        >{t(@locale, "settings.users.index.cancel", %{})}</button>
        <button
          id="confirm-visits"
          type="button"
          class="btn btn-primary"
          phx-click="update_visits"
          phx-disable-with={label(@locale, if(@data.visits, do: "disable", else: "enable"))}
        >{label(@locale, if(@data.visits, do: "disable", else: "enable"))}</button>
      </div>
    </div>
  </dialog>
  <DawarichWeb.AdminJobHealth.card
    :if={@current_user.admin == true && @health}
    locale={@locale}
    health={@health}
  />
</div>
