#!/bin/sh
cookie_file="${DAWARICH_COOKIE_FILE:-/var/app/tmp/dawarich.cookie}"
if [ -L "$cookie_file" ]; then
  echo "dawarich: refusing the symlinked cookie path $cookie_file" >&2
  exit 4
fi
if [ ! -s "$cookie_file" ]; then
  rm -f "$cookie_file"
  (set -C; umask 077; od -An -N32 -tx1 /dev/urandom | tr -d ' \n' > "$cookie_file") 2>/dev/null || true
  [ "$(id -u)" != 0 ] || chown -h "$(ls -nd "$(dirname "$cookie_file")" | awk '{print $3":"$4}')" "$cookie_file" 2>/dev/null || true
fi
cookie="$(cat "$cookie_file" 2>/dev/null || true)"
if [ -z "$cookie" ]; then
  echo "dawarich: cannot read cookie from $cookie_file" >&2
  exit 4
fi
export RELEASE_COOKIE="$cookie"
export RELEASE_DISTRIBUTION=sname
export RELEASE_NODE=dawarich@localhost
export ERL_EPMD_ADDRESS=127.0.0.1
export RELEASE_TMP="${RELEASE_TMP:-$(dirname "$cookie_file")}"
