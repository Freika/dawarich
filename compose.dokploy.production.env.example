# Copy these names to the Dokploy Compose service's Environment tab.
# Transfer values directly from the live Dokku production app; never commit a
# populated copy. This is a checklist, not the complete inventory.

# Pin a digest from OneDev "Build Production Image" (tag :production moves).
DAWARICH_IMAGE=onedev.dwri.xyz/dawarich/dawarich@sha256:
WEB_REPLICAS=0
WORKER_REPLICAS=0
# 0 while Dokku workers still own the cron schedules; 30 after the handoff.
SIDEKIQ_CRON_POLL_INTERVAL=0

DOMAIN=my.dawarich.app
# Add the temporary preview hostname here before testing the preview domain.
APPLICATION_HOSTS=my.dawarich.app
MANAGER_URL=https://subscription.dawarich.app

# config/database.yml reads these discrete values, not DATABASE_URL.
# GigaDB PgBouncer; the Robot firewall must admit the Dokploy host on 6432.
DATABASE_HOST=
DATABASE_PORT=6432
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
REDIS_URL=

RAILS_MASTER_KEY=
SECRET_KEY_BASE=
AUTH_JWT_SECRET_KEY=
JWT_SECRET_KEY=
SUBSCRIPTION_WEBHOOK_SECRET=

# Match the live Dokku value; s3 needs the AWS_* keys below. Rails falls back to
# local disk when unset, and this Compose defines no storage volume.
STORAGE_BACKEND=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=
AWS_ENDPOINT_URL=

# Also copy the remaining production Dokku settings: concurrency, OTP keys,
# SMTP, OAuth, Photon, metrics, Sentry and feature flags.
